        "icon": "$(link)"
      },
      {
        "command": "rainbird.diffAgainstDraft",
        "title": "Rainbird: Diff Open File Against Platform Draft"
      },
      {
        "command": "rainbird.addMcpServer",
        "title": "Rainbird: Add Served Graph as MCP Server…"
      },
      {
        "command": "rainbird.insertElement",
        "title": "Rainbird: Insert… (concept, relationship, instance, fact, rule)",
        "icon": "$(add)"
      },
      {
        "command": "rainbird.addConcept",
        "title": "Rainbird: Add Concept…",
        "icon": "$(add)"
      },
      {
        "command": "rainbird.addRelationship",
        "title": "Rainbird: Add Relationship…",
        "icon": "$(add)"
      },
      {
        "command": "rainbird.addInstance",
        "title": "Rainbird: Add Instance…",
        "icon": "$(add)"
      },
      {
        "command": "rainbird.addFact",
        "title": "Rainbird: Add Fact…",
        "icon": "$(add)"
      },
      {
        "command": "rainbird.addRule",
        "title": "Rainbird: Add Rule…",
        "icon": "$(add)"
      },
      {
        "command": "rainbird.addCondition",
        "title": "Rainbird: Add Condition to Rule at Cursor…",
        "icon": "$(add)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "rainbird",
          "title": "Rainbird",
          "icon": "media/rainbird-activity.svg"
        }
      ]
    },
    "views": {
      "rainbird": [
        {
          "id": "rainbird.mapExplorer",
          "name": "Map Explorer",
          "icon": "media/rainbird-activity.svg"
        },
        {
          "id": "rainbird.platformMaps",
          "name": "Maps",
          "icon": "media/rainbird-activity.svg"
        },
        {
          "id": "rainbird.assistant",
          "type": "webview",
          "name": "AI Assistant",
          "icon": "media/rainbird-activity.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "rainbird.mapExplorer",
        "contents": "Open an RBLang (.rbl) file to explore its concepts, relationships and rules. No file yet? Open one of your maps by its Knowledge Map ID, try the example, or start one.\n[Open a map by Knowledge Map ID…](command:rainbird.openMapByKmId)\n[Open example](command:rainbird.openExample)\n[Insert into the open file…](command:rainbird.insertElement)\n[Getting started](command:rainbird.getStarted)"
      },
      {
        "view": "rainbird.platformMaps",
        "contents": "Maps you open, push or query from VS Code appear here. Rainbird's API has no endpoint that lists your Studio maps, so start from a map's Knowledge Map ID (on its Publish page in Studio).\n[Open Map by Knowledge Map ID…](command:rainbird.openMapByKmId)\n[Add a kmID without opening it](command:rainbird.mapsAdd)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "rainbird.mapsOpen",
          "when": "false"
        },
        {
          "command": "rainbird.mapsQuery",
          "when": "false"
        },
        {
          "command": "rainbird.mapsCopyKmId",
          "when": "false"
        },
        {
          "command": "rainbird.mapsRemove",
          "when": "false"
        },
        {
          "command": "rainbird.mapsOpenFile",
          "when": "false"
        },
        {
          "command": "rainbird.mapsReload",
          "when": "false"
        }
      ],
      "editor/title/run": [
        {
          "command": "rainbird.openQueryPanel",
          "when": "editorLangId == rblang",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "rainbird.insertElement",
          "when": "editorLangId == rblang",
          "group": "navigation@0"
        },
        {
          "command": "rainbird.openGraphView",
          "when": "editorLangId == rblang",
          "group": "navigation@1"
        },
        {
          "command": "rainbird.pushMap",
          "when": "editorLangId == rblang",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "rainbird.insertElement",
          "when": "editorLangId == rblang",
          "group": "rainbird@0"
        },
        {
          "command": "rainbird.explainSelection",
          "when": "editorLangId == rblang",
          "group": "rainbird@1"
        },
        {
          "command": "rainbird.semanticDiff",
          "when": "editorLangId == rblang",
          "group": "rainbird@2"
        },
        {
          "command": "rainbird.openNlPanel",
          "when": "editorLangId == rblang",
          "group": "rainbird@3"
        },
        {
          "command": "rainbird.promotionDiff",
          "when": "editorLangId == rblang",
          "group": "rainbird@4"
        },
        {
          "command": "rainbird.diffAgainstPushed",
          "when": "editorLangId == rblang",
          "group": "rainbird@5"
        },
        {
          "command": "rainbird.compareDraft",
          "when": "editorLangId == rblang",
          "group": "rainbird@6"
        },
        {
          "command": "rainbird.diffAgainstDraft",
          "when": "editorLangId == rblang",
          "group": "rainbird@7"
        },
        {
          "command": "rainbird.bindKmId",
          "when": "editorLangId == rblang",
          "group": "rainbird@8"
        },
        {
          "command": "rainbird.reloadFromPlatform",
          "when": "editorLangId == rblang",
          "group": "rainbird@9"
        }
      ],
      "view/title": [
        {
          "command": "rainbird.assistantNewChat",
          "when": "view == rainbird.assistant",
          "group": "navigation@1"
        },
        {
          "command": "rainbird.setAnthropicKey",
          "when": "view == rainbird.assistant",
          "group": "navigation@2"
        },
        {
          "command": "rainbird.openMapByKmId",
          "when": "view == rainbird.platformMaps",
          "group": "navigation@0"
        },
        {
          "command": "rainbird.mapsAdd",
          "when": "view == rainbird.platformMaps",
          "group": "navigation@1"
        },
        {
          "command": "rainbird.mapsRefresh",
          "when": "view == rainbird.platformMaps",
          "group": "navigation@2"
        },
        {
          "command": "rainbird.pullMap",
          "when": "view == rainbird.platformMaps",
          "group": "rainbird@0"
        },
        {
          "command": "rainbird.insertElement",
          "when": "view == rainbird.mapExplorer",
          "group": "navigation@0"
        }
      ],
      "view/item/context": [
        {
          "command": "rainbird.mapsReload",
          "when": "view == rainbird.platformMaps && viewItem =~ /rainbirdMap/",
          "group": "inline"
        },
        {
          "command": "rainbird.mapsQuery",
          "when": "view == rainbird.platformMaps && viewItem =~ /rainbirdMap/",
          "group": "inline"
        },
        {
          "command": "rainbird.mapsOpen",
          "when": "view == rainbird.platformMaps && viewItem =~ /rainbirdMap/",
          "group": "rainbird@0"
        },
        {
          "command": "rainbird.mapsQuery",
          "when": "view == rainbird.platformMaps && viewItem =~ /rainbirdMap/",
          "group": "rainbird@1"
        },
        {
          "command": "rainbird.mapsCopyKmId",
          "when": "view == rainbird.platformMaps && viewItem =~ /rainbirdMap/",
          "group": "rainbird@2"
        },
        {
          "command": "rainbird.mapsOpenFile",
          "when": "view == rainbird.platformMaps && viewItem == rainbirdMapWithFile",
          "group": "rainbird@3"
        },
        {
          "command": "rainbird.mapsRemove",
          "when": "view == rainbird.platformMaps && viewItem =~ /rainbirdMap/",
          "group": "rainbird@4"
        },
        {
          "command": "rainbird.addConcept",
          "when": "view == rainbird.mapExplorer && viewItem == rainbirdCategory.concepts",
          "group": "inline"
        },
        {
          "command": "rainbird.addRelationship",
          "when": "view == rainbird.mapExplorer && viewItem == rainbirdCategory.relationships",
          "group": "inline"
        },
        {
          "command": "rainbird.addRule",
          "when": "view == rainbird.mapExplorer && viewItem == rainbirdCategory.rules",
          "group": "inline"
        },
        {
          "command": "rainbird.addFact",
          "when": "view == rainbird.mapExplorer && viewItem == rainbirdCategory.facts",
          "group": "inline"
        },
        {
          "command": "rainbird.addInstance",
          "when": "view == rainbird.mapExplorer && viewItem == rainbirdCategory.instances",
          "group": "inline"
        },
        {
          "command": "rainbird.mapsReload",
          "when": "view == rainbird.platformMaps && viewItem =~ /rainbirdMap/",
          "group": "rainbird@0"
        }
      ],
      "explorer/context": [
        {
          "command": "rainbird.extractRbird",
          "when": "resourceExtname == .rbird",
          "group": "rainbird"
        },
        {
          "command": "rainbird.compareDraft",
          "when": "resourceExtname == .rbird",
          "group": "rainbird"
        }
      ]
    },
    "configuration": {
      "title": "Rainbird",
      "properties": {
        "rainbird.apiUrl": {
          "type": "string",
          "default": "https://api.rainbird.ai",
          "description": "Rainbird API base URL (Community: https://api.rainbird.ai, Enterprise: https://enterprise-api.rainbird.ai, or your private environment URL)."
        },
        "rainbird.knowledgeMapId": {
          "type": "string",
          "default": "",
          "description": "Default Knowledge Map ID (kmID) for this workspace or folder, used for files that have no map of their own and for queries with no file open. Files opened by Knowledge Map ID, pulled, pushed or bound with “Rainbird: Bind Open File to a Knowledge Map ID…” keep their own map, which wins over this setting. The ID is on the map's Publish page in Rainbird Studio, or under View Knowledge Map ID in the map's menu.",
          "scope": "resource"
        },
        "rainbird.useDraft": {
          "type": "boolean",
          "default": true,
          "description": "Query the draft version of the knowledge map instead of the live version."
        },
        "rainbird.query.dateOrder": {
          "type": "string",
          "default": "day-first",
          "enum": [
            "day-first",
            "month-first"
          ],
          "enumDescriptions": [
            "Day first: for 01/10/1981, 1 October 1981 is offered first.",
            "Month first: for 01/10/1981, 10 January 1981 is offered first."
          ],
          "description": "Which reading of an ambiguous numeric date such as 01/10/1981 is listed first. Ambiguous dates are never guessed: the query panel offers both readings to choose from and shows the YYYY-MM-DD it will send; the Quick Pick runner and the assistant's run_query ask for the date in an unambiguous form, such as 1981-10-01."
        },
        "rainbird.query.autoSkipPluralQuestions": {
          "type": "string",
          "default": "injected",
          "enum": [
            "injected",
            "known",
            "off"
          ],
          "enumDescriptions": [
            "When the values a plural question asks about are already covered by facts injected in this session, answer “No more” automatically.",
            "Answer “No more” automatically whenever the engine already knows some answers to a plural question, whatever their source: injected facts, the map, a datasource or a rule.",
            "Always ask. In the query panel the question card still shows what the engine already knows, with a No more button."
          ],
          "markdownDescription": "Plural relationships are asked even when the engine already holds facts for them (by design, so more can be added). This setting decides when the query panel and the assistant's `run_query` tool answer *No more* for you instead of asking. In the panel every automatic answer appears in the transcript with an **Answer instead** action and is saved in tests like any other answer; `run_query` lists them under `autoSkipped`."
        },
        "rainbird.query.logQuestions": {
          "type": "boolean",
          "default": false,
          "description": "Log the raw question JSON the engine sends to the query panel, and the answer payloads the panel sends back, to the Rainbird output channel. For diagnosing how questions are shown; leave off otherwise."
        },
        "rainbird.studioUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "Base URL of Rainbird Studio for **Open in Studio** and **Copy link** on evidence trees, e.g. `https://studio.example.com`. Only needed for private environments whose API host is not a `*.rainbird.ai` host the extension can map to Studio: for `api.rainbird.ai` it uses `app.rainbird.ai`, and for `<name>-api.rainbird.ai` it uses `<name>.rainbird.ai`, so this setting is not used for those hosts."
        },
        "rainbird.ai.model": {
          "type": "string",
          "default": "claude-opus-5",
          "enum": [
            "claude-opus-5",
            "claude-sonnet-5",
            "claude-fable-5-1",
            "claude-opus-4-8"
          ],
          "enumDescriptions": [
            "Claude Opus 5 (default) — best balance of quality and cost for authoring",
            "Claude Sonnet 5 — faster and cheaper",
            "Claude Fable 5.1 — most capable, slower and more expensive",
            "Claude Opus 4.8 — previous generation"
          ],
          "markdownDescription": "Claude model the AI assistant uses (via your Anthropic API key). Other model ids can be typed into `settings.json`."
        },
        "rainbird.ai.effort": {
          "type": "string",
          "default": "high",
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "description": "How much reasoning effort the assistant spends per turn. Higher is slower and costs more tokens; 'high' suits most authoring work."
        },
        "rainbird.ai.applyEdits": {
          "type": "string",
          "default": "immediately",
          "enum": [
            "immediately",
            "preview"
          ],
          "enumDescriptions": [
            "Edits land in the open file as the assistant works (each is one undo step; the chat offers Show diff and Undo per turn).",
            "Edits accumulate in a proposal; a side-by-side diff opens and you Accept or Reject before the file changes."
          ],
          "description": "How the AI assistant's changes reach your RBLang file."
        },
        "rainbird.ai.showDiffAfterEdits": {
          "type": "boolean",
          "default": true,
          "description": "When the assistant changes the open file (applyEdits: immediately), open a before ↔ after diff automatically at the end of the turn. The Changes card's Show diff button works either way."
        }
      }
    },
    "configurationDefaults": {
      "[rblang]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.linkedEditing": true
      }
    },
    "walkthroughs": [
      {
        "id": "rainbird.gettingStarted",
        "title": "Get started with Rainbird",
        "description": "Author RBLang knowledge maps, open your Studio maps by Knowledge Map ID, run queries and inspect evidence without leaving VS Code. This extension is in beta — expect rough edges and please report issues on GitHub.",
        "steps": [
          {
            "id": "rainbird.openExample",
            "title": "Open an example knowledge map",
            "description": "Open a sample .rbl file to see RBLang language support in action. It works offline, but it is not on your Rainbird account: push it (cloud icon) or open one of your own maps before querying.\n[Open example](command:rainbird.openExample)",
            "media": {
              "markdown": "media/walkthrough/example.md"
            }
          },
          {
            "id": "rainbird.connectStep",
            "title": "Connect to your Rainbird environment",
            "description": "Store your API key securely and choose Community, Enterprise or a private environment.\n[Connect](command:rainbird.connect)",
            "media": {
              "markdown": "media/walkthrough/connect.md"
            },
            "completionEvents": [
              "onCommand:rainbird.connect"
            ]
          },
          {
            "id": "rainbird.openMapStep",
            "title": "Open your own map",
            "description": "Paste a map's Knowledge Map ID, from its Publish page in Studio. The extension downloads the map's draft, saves it as a .rbl file and remembers which map it is.\n[Open Map by Knowledge Map ID…](command:rainbird.openMapByKmId)",
            "media": {
              "markdown": "media/walkthrough/open-map.md"
            },
            "completionEvents": [
              "onCommand:rainbird.openMapByKmId"
            ]
          },
          {
            "id": "rainbird.queryStep",
            "title": "Run your first query",
            "description": "Start from the .rbl you opened (▶ in its title bar), so the extension knows which map to query. Pick a goal relationship, answer the questions the engine asks, and get a result with certainty and evidence.\n[Run Query](command:rainbird.openQueryPanel)",
            "media": {
              "markdown": "media/walkthrough/query.md"
            },
            "completionEvents": [
              "onCommand:rainbird.openQueryPanel"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "test": "npm run compile && node --test \"out/test/**/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "happy-dom": "^20.14.5",
    "typescript": "^5.4.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0"
  }
}
