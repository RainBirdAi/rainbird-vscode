{
  "name": "rainbird",
  "displayName": "Rae by Rainbird",
  "description": "Raelog language support, model authoring, query running and evidence trees for Rae, the decision automation platform from Rainbird.",
  "version": "0.0.15",
  "preview": true,
  "publisher": "RainbirdTechnologies",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/RainBirdAi/rainbird-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/RainBirdAi/rainbird-vscode/issues"
  },
  "homepage": "https://github.com/RainBirdAi/rainbird-vscode#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Linters",
    "AI",
    "Other"
  ],
  "keywords": [
    "rainbird",
    "rae",
    "raelog",
    "rblang",
    "decision automation",
    "reasoning"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:rblang",
    "onLanguage:xml",
    "workspaceContains:**/*.rbl",
    "workspaceContains:**/*.raelog",
    "workspaceContains:**/*.rbird",
    "onStartupFinished"
  ],
  "contributes": {
    "languages": [
      {
        "id": "rblang",
        "aliases": [
          "Raelog",
          "RBLang",
          "rblang"
        ],
        "extensions": [
          ".rbl",
          ".rblang",
          ".raelog"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./media/rblang-light.svg",
          "dark": "./media/rblang-dark.svg"
        }
      },
      {
        "id": "rbird",
        "aliases": [
          "Rainbird export"
        ],
        "extensions": [
          ".rbird"
        ],
        "icon": {
          "light": "./media/rblang-light.svg",
          "dark": "./media/rblang-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "rblang",
        "scopeName": "text.xml.rblang",
        "path": "./syntaxes/rblang.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "rblang",
        "path": "./snippets/rblang.json"
      }
    ],
    "commands": [
      {
        "command": "rainbird.getStarted",
        "title": "Rae: Get Started"
      },
      {
        "command": "rainbird.connect",
        "title": "Rae: Connect (set environment & API key)"
      },
      {
        "command": "rainbird.runQuery",
        "title": "Rae: Run Query (Quick Pick)…"
      },
      {
        "command": "rainbird.openQueryPanel",
        "title": "Rae: Run Query…",
        "icon": "$(play)"
      },
      {
        "command": "rainbird.openGraphView",
        "title": "Rae: Show Graph View",
        "icon": "$(type-hierarchy-sub)"
      },
      {
        "command": "rainbird.pushMap",
        "title": "Rae: Push Model to Platform (creates a new model)",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "rainbird.explainSelection",
        "title": "Rae: Explain with AI"
      },
      {
        "command": "rainbird.setAnthropicKey",
        "title": "Rae: Set Anthropic API Key (AI assistant)",
        "icon": "$(key)"
      },
      {
        "command": "rainbird.assistantNewChat",
        "title": "Rae: New Assistant Chat",
        "icon": "$(clear-all)"
      },
      {
        "command": "rainbird.openNlPanel",
        "title": "Rae: Ask in Natural Language (beta)…"
      },
      {
        "command": "rainbird.semanticDiff",
        "title": "Rae: Diff vs git HEAD (side by side + semantic report)…"
      },
      {
        "command": "rainbird.promotionDiff",
        "title": "Rae: Compare Versions (Promotion Diff)…",
        "icon": "$(diff)"
      },
      {
        "command": "rainbird.diffAgainstPushed",
        "title": "Rae: Diff Against Last Pulled or Pushed Snapshot"
      },
      {
        "command": "rainbird.mapsRefresh",
        "title": "Rae: Refresh Models",
        "icon": "$(refresh)"
      },
      {
        "command": "rainbird.mapsAdd",
        "title": "Rae: Add Model by kmID…",
        "icon": "$(add)"
      },
      {
        "command": "rainbird.mapsOpen",
        "title": "Open Raelog"
      },
      {
        "command": "rainbird.mapsQuery",
        "title": "Run Query",
        "icon": "$(play)"
      },
      {
        "command": "rainbird.mapsReload",
        "title": "Reload from Studio",
        "icon": "$(cloud-download)"
      },
      {
        "command": "rainbird.mapsCopyKmId",
        "title": "Copy kmID"
      },
      {
        "command": "rainbird.mapsRemove",
        "title": "Remove from list"
      },
      {
        "command": "rainbird.mapsOpenFile",
        "title": "Open source file"
      },
      {
        "command": "rainbird.showEvidence",
        "title": "Rae: Show Evidence Tree for Fact…"
      },
      {
        "command": "rainbird.setEvidenceKey",
        "title": "Rae: Set Evidence Key (x-evidence-key)"
      },
      {
        "command": "rainbird.extractRbird",
        "title": "Rae: Extract Raelog from .rbird export"
      },
      {
        "command": "rainbird.compareDraft",
        "title": "Rae: Compare Draft vs Saved Version…",
        "icon": "$(diff)"
      },
      {
        "command": "rainbird.openMapByKmId",
        "title": "Rae: Open Model by Knowledge Map ID…",
        "icon": "$(cloud-download)"
      },
      {
        "command": "rainbird.pullMap",
        "title": "Rae: Pull Model Raelog from Platform (read-only draft or saved version)…",
        "icon": "$(cloud-download)"
      },
      {
        "command": "rainbird.reloadFromPlatform",
        "title": "Rae: Reload Model from Studio (replace the open file with the latest draft)",
        "icon": "$(refresh)"
      },
      {
        "command": "rainbird.bindKmId",
        "title": "Rae: Bind Open File to a Knowledge Map ID…",
        "icon": "$(link)"
      },
      {
        "command": "rainbird.diffAgainstDraft",
        "title": "Rae: Diff Open File Against Platform Draft"
      },
      {
        "command": "rainbird.addMcpServer",
        "title": "Rae: Add a Model's MCP Endpoint…"
      },
      {
        "command": "rainbird.insertElement",
        "title": "Rae: Insert… (concept, relationship, instance, fact, rule)",
        "icon": "$(add)"
      },
      {
        "command": "rainbird.addConcept",
        "title": "Rae: Add Concept…",
        "icon": "$(add)"
      },
      {
        "command": "rainbird.addRelationship",
        "title": "Rae: Add Relationship…",
        "icon": "$(add)"
      },
      {
        "command": "rainbird.addInstance",
        "title": "Rae: Add Instance…",
        "icon": "$(add)"
      },
      {
        "command": "rainbird.addFact",
        "title": "Rae: Add Fact…",
        "icon": "$(add)"
      },
      {
        "command": "rainbird.addRule",
        "title": "Rae: Add Rule…",
        "icon": "$(add)"
      },
      {
        "command": "rainbird.addCondition",
        "title": "Rae: Add Condition to Rule at Cursor…",
        "icon": "$(add)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "rainbird",
          "title": "Rae",
          "icon": "media/rae-mark.svg"
        }
      ]
    },
    "views": {
      "rainbird": [
        {
          "id": "rainbird.mapExplorer",
          "name": "Model Explorer",
          "icon": "media/rae-mark.svg"
        },
        {
          "id": "rainbird.platformMaps",
          "name": "Models",
          "icon": "media/rae-mark.svg"
        },
        {
          "id": "rainbird.assistant",
          "type": "webview",
          "name": "AI Assistant",
          "icon": "media/rae-mark.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "rainbird.mapExplorer",
        "contents": "Open a Raelog (.rbl) file to explore its concepts, relationships and rules. No file yet? Open one of your models by its Knowledge Map ID, try the example, or start one.\n[Open a model by Knowledge Map ID…](command:rainbird.openMapByKmId)\n[Open example](command:rainbird.openExample)\n[Insert into the open file…](command:rainbird.insertElement)\n[Getting started](command:rainbird.getStarted)"
      },
      {
        "view": "rainbird.platformMaps",
        "contents": "Models you open, push or query from VS Code appear here. Rainbird's API has no endpoint that lists your models, so start from a model's Knowledge Map ID (on its Publish page in Rainbird Studio).\n[Open Model by Knowledge Map ID…](command:rainbird.openMapByKmId)\n[Add a kmID without opening it](command:rainbird.mapsAdd)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "rainbird.mapsOpen",
          "when": "false"
        },
        {
          "command": "rainbird.mapsQuery",
          "when": "false"
        },
        {
          "command": "rainbird.mapsCopyKmId",
          "when": "false"
        },
        {
          "command": "rainbird.mapsRemove",
          "when": "false"
        },
        {
          "command": "rainbird.mapsOpenFile",
          "when": "false"
        },
        {
          "command": "rainbird.mapsReload",
          "when": "false"
        }
      ],
      "editor/title/run": [
        {
          "command": "rainbird.openQueryPanel",
          "when": "editorLangId == rblang",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "rainbird.insertElement",
          "when": "editorLangId == rblang",
          "group": "navigation@0"
        },
        {
          "command": "rainbird.openGraphView",
          "when": "editorLangId == rblang",
          "group": "navigation@1"
        },
        {
          "command": "rainbird.pushMap",
          "when": "editorLangId == rblang",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "rainbird.insertElement",
          "when": "editorLangId == rblang",
          "group": "rainbird@0"
        },
        {
          "command": "rainbird.explainSelection",
          "when": "editorLangId == rblang",
          "group": "rainbird@1"
        },
        {
          "command": "rainbird.semanticDiff",
          "when": "editorLangId == rblang",
          "group": "rainbird@2"
        },
        {
          "command": "rainbird.openNlPanel",
          "when": "editorLangId == rblang",
          "group": "rainbird@3"
        },
        {
          "command": "rainbird.promotionDiff",
          "when": "editorLangId == rblang",
          "group": "rainbird@4"
        },
        {
          "command": "rainbird.diffAgainstPushed",
          "when": "editorLangId == rblang",
          "group": "rainbird@5"
        },
        {
          "command": "rainbird.compareDraft",
          "when": "editorLangId == rblang",
          "group": "rainbird@6"
        },
        {
          "command": "rainbird.diffAgainstDraft",
          "when": "editorLangId == rblang",
          "group": "rainbird@7"
        },
        {
          "command": "rainbird.bindKmId",
          "when": "editorLangId == rblang",
          "group": "rainbird@8"
        },
        {
          "command": "rainbird.reloadFromPlatform",
          "when": "editorLangId == rblang",
          "group": "rainbird@9"
        }
      ],
      "view/title": [
        {
          "command": "rainbird.assistantNewChat",
          "when": "view == rainbird.assistant",
          "group": "navigation@1"
        },
        {
          "command": "rainbird.setAnthropicKey",
          "when": "view == rainbird.assistant",
          "group": "navigation@2"
        },
        {
          "command": "rainbird.openMapByKmId",
          "when": "view == rainbird.platformMaps",
          "group": "navigation@0"
        },
        {
          "command": "rainbird.mapsAdd",
          "when": "view == rainbird.platformMaps",
          "group": "navigation@1"
        },
        {
          "command": "rainbird.mapsRefresh",
          "when": "view == rainbird.platformMaps",
          "group": "navigation@2"
        },
        {
          "command": "rainbird.pullMap",
          "when": "view == rainbird.platformMaps",
          "group": "rainbird@0"
        },
        {
          "command": "rainbird.insertElement",
          "when": "view == rainbird.mapExplorer",
          "group": "navigation@0"
        }
      ],
      "view/item/context": [
        {
          "command": "rainbird.mapsReload",
          "when": "view == rainbird.platformMaps && viewItem =~ /rainbirdMap/",
          "group": "inline"
        },
        {
          "command": "rainbird.mapsQuery",
          "when": "view == rainbird.platformMaps && viewItem =~ /rainbirdMap/",
          "group": "inline"
        },
        {
          "command": "rainbird.mapsOpen",
          "when": "view == rainbird.platformMaps && viewItem =~ /rainbirdMap/",
          "group": "rainbird@0"
        },
        {
          "command": "rainbird.mapsQuery",
          "when": "view == rainbird.platformMaps && viewItem =~ /rainbirdMap/",
          "group": "rainbird@1"
        },
        {
          "command": "rainbird.mapsCopyKmId",
          "when": "view == rainbird.platformMaps && viewItem =~ /rainbirdMap/",
          "group": "rainbird@2"
        },
        {
          "command": "rainbird.mapsOpenFile",
          "when": "view == rainbird.platformMaps && viewItem == rainbirdMapWithFile",
          "group": "rainbird@3"
        },
        {
          "command": "rainbird.mapsRemove",
          "when": "view == rainbird.platformMaps && viewItem =~ /rainbirdMap/",
          "group": "rainbird@4"
        },
        {
          "command": "rainbird.addConcept",
          "when": "view == rainbird.mapExplorer && viewItem == rainbirdCategory.concepts",
          "group": "inline"
        },
        {
          "command": "rainbird.addRelationship",
          "when": "view == rainbird.mapExplorer && viewItem == rainbirdCategory.relationships",
          "group": "inline"
        },
        {
          "command": "rainbird.addRule",
          "when": "view == rainbird.mapExplorer && viewItem == rainbirdCategory.rules",
          "group": "inline"
        },
        {
          "command": "rainbird.addFact",
          "when": "view == rainbird.mapExplorer && viewItem == rainbirdCategory.facts",
          "group": "inline"
        },
        {
          "command": "rainbird.addInstance",
          "when": "view == rainbird.mapExplorer && viewItem == rainbirdCategory.instances",
          "group": "inline"
        },
        {
          "command": "rainbird.mapsReload",
          "when": "view == rainbird.platformMaps && viewItem =~ /rainbirdMap/",
          "group": "rainbird@0"
        }
      ],
      "explorer/context": [
        {
          "command": "rainbird.extractRbird",
          "when": "resourceExtname == .rbird",
          "group": "rainbird"
        },
        {
          "command": "rainbird.compareDraft",
          "when": "resourceExtname == .rbird",
          "group": "rainbird"
        }
      ]
    },
    "configuration": {
      "title": "Rae",
      "properties": {
        "rainbird.apiUrl": {
          "type": "string",
          "default": "https://api.rainbird.ai",
          "description": "Rainbird API base URL (Community: https://api.rainbird.ai, Enterprise: https://enterprise-api.rainbird.ai, or your private environment URL)."
        },
        "rainbird.knowledgeMapId": {
          "type": "string",
          "default": "",
          "description": "Default Knowledge Map ID (kmID) for this workspace or folder, used for files that have no model of their own and for queries with no file open. Files opened by Knowledge Map ID, pulled, pushed or bound with “Rae: Bind Open File to a Knowledge Map ID…” keep their own model, which wins over this setting. The ID is on the model's Publish page in Rainbird Studio, or under View Knowledge Map ID in the model's menu.",
          "scope": "resource"
        },
        "rainbird.useDraft": {
          "type": "boolean",
          "default": true,
          "description": "Query the draft version of the model instead of the live version."
        },
        "rainbird.query.dateOrder": {
          "type": "string",
          "default": "day-first",
          "enum": [
            "day-first",
            "month-first"
          ],
          "enumDescriptions": [
            "Day first: for 01/10/1981, 1 October 1981 is offered first.",
            "Month first: for 01/10/1981, 10 January 1981 is offered first."
          ],
          "description": "Which reading of an ambiguous numeric date such as 01/10/1981 is listed first. Ambiguous dates are never guessed: the query panel offers both readings to choose from and shows the YYYY-MM-DD it will send; the Quick Pick runner and the assistant's run_query ask for the date in an unambiguous form, such as 1981-10-01."
        },
        "rainbird.query.autoSkipPluralQuestions": {
          "type": "string",
          "default": "injected",
          "enum": [
            "injected",
            "known",
            "off"
          ],
          "enumDescriptions": [
            "When the values a plural question asks about are already covered by facts injected in this session, answer “No more” automatically.",
            "Answer “No more” automatically whenever the engine already knows some answers to a plural question, whatever their source: injected facts, the model, a datasource or a rule.",
            "Always ask. In the query panel the question card still shows what the engine already knows, with a No more button."
          ],
          "markdownDescription": "Plural relationships are asked even when the engine already holds facts for them (by design, so more can be added). This setting decides when the query panel and the assistant's `run_query` tool answer *No more* for you instead of asking. In the panel every automatic answer appears in the transcript with an **Answer instead** action and is saved in tests like any other answer; `run_query` lists them under `autoSkipped`."
        },
        "rainbird.query.logQuestions": {
          "type": "boolean",
          "default": false,
          "description": "Log the raw question JSON the engine sends to the query panel, and the answer payloads the panel sends back, to the Rae output channel. For diagnosing how questions are shown; leave off otherwise."
        },
        "rainbird.studioUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "Base URL of Rainbird Studio for **Open in Studio** and **Copy link** on evidence trees, e.g. `https://studio.example.com`. Only needed for private environments whose API host is not a `*.rainbird.ai` host the extension can map to Studio: for `api.rainbird.ai` it uses `app.rainbird.ai`, and for `<name>-api.rainbird.ai` it uses `<name>.rainbird.ai`, so this setting is not used for those hosts."
        },
        "rainbird.ai.model": {
          "type": "string",
          "default": "claude-opus-5",
          "enum": [
            "claude-opus-5",
            "claude-sonnet-5",
            "claude-fable-5-1",
            "claude-opus-4-8"
          ],
          "enumDescriptions": [
            "Claude Opus 5 (default) — best balance of quality and cost for authoring",
            "Claude Sonnet 5 — faster and cheaper",
            "Claude Fable 5.1 — most capable, slower and more expensive",
            "Claude Opus 4.8 — previous generation"
          ],
          "markdownDescription": "Claude model the AI assistant uses (via your Anthropic API key). Other model ids can be typed into `settings.json`."
        },
        "rainbird.ai.effort": {
          "type": "string",
          "default": "high",
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "description": "How much reasoning effort the assistant spends per turn. Higher is slower and costs more tokens; 'high' suits most authoring work."
        },
        "rainbird.ai.applyEdits": {
          "type": "string",
          "default": "immediately",
          "enum": [
            "immediately",
            "preview"
          ],
          "enumDescriptions": [
            "Edits land in the open file as the assistant works (each is one undo step; the chat offers Show diff and Undo per turn).",
            "Edits accumulate in a proposal; a side-by-side diff opens and you Accept or Reject before the file changes."
          ],
          "description": "How the AI assistant's changes reach your Raelog file."
        },
        "rainbird.ai.showDiffAfterEdits": {
          "type": "boolean",
          "default": true,
          "description": "When the assistant changes the open file (applyEdits: immediately), open a before ↔ after diff automatically at the end of the turn. The Changes card's Show diff button works either way."
        }
      }
    },
    "configurationDefaults": {
      "[rblang]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.linkedEditing": true
      }
    },
    "walkthroughs": [
      {
        "id": "rainbird.gettingStarted",
        "title": "Get started with Rae",
        "description": "Author Raelog models for Rae, the decision automation platform from Rainbird. Open your models by Knowledge Map ID, run queries and inspect evidence without leaving VS Code. Please report issues on GitHub.",
        "steps": [
          {
            "id": "rainbird.openExample",
            "title": "Open an example model",
            "description": "Open a sample .rbl file to see Raelog language support in action. It works offline, but it is not on your Rainbird account: push it (cloud icon) or open one of your own models before querying.\n[Open example](command:rainbird.openExample)",
            "media": {
              "markdown": "media/walkthrough/example.md"
            }
          },
          {
            "id": "rainbird.connectStep",
            "title": "Connect to your Rainbird environment",
            "description": "Store your API key securely and choose Community, Enterprise or a private environment.\n[Connect](command:rainbird.connect)",
            "media": {
              "markdown": "media/walkthrough/connect.md"
            },
            "completionEvents": [
              "onCommand:rainbird.connect"
            ]
          },
          {
            "id": "rainbird.openMapStep",
            "title": "Open your own model",
            "description": "Paste a model's Knowledge Map ID, from its Publish page in Rainbird Studio. The extension downloads the model's draft, saves it as a .rbl file and remembers which model it is.\n[Open Model by Knowledge Map ID…](command:rainbird.openMapByKmId)",
            "media": {
              "markdown": "media/walkthrough/open-map.md"
            },
            "completionEvents": [
              "onCommand:rainbird.openMapByKmId"
            ]
          },
          {
            "id": "rainbird.queryStep",
            "title": "Run your first query",
            "description": "Start from the .rbl you opened (▶ in its title bar), so the extension knows which model to query. Pick a goal relationship, answer the questions the engine asks, and get a result with certainty and evidence.\n[Run Query](command:rainbird.openQueryPanel)",
            "media": {
              "markdown": "media/walkthrough/query.md"
            },
            "completionEvents": [
              "onCommand:rainbird.openQueryPanel"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "test": "npm run compile && node --test \"out/test/**/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "happy-dom": "^20.14.5",
    "typescript": "^5.4.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0"
  }
}
