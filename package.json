{
  "name": "rainbird",
  "displayName": "Rainbird (Beta)",
  "description": "Beta — RBLang language support, knowledge-map tooling, query running and evidence trees for the Rainbird decision-intelligence platform.",
  "version": "0.0.10",
  "preview": true,
  "publisher": "RainbirdTechnologies",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/juliodt-ai/rainbird-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/juliodt-ai/rainbird-vscode/issues"
  },
  "homepage": "https://github.com/juliodt-ai/rainbird-vscode#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Linters",
    "AI",
    "Other"
  ],
  "keywords": [
    "rainbird",
    "rblang",
    "knowledge map",
    "knowledge graph",
    "decision intelligence",
    "reasoning"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:rblang",
    "onLanguage:xml",
    "workspaceContains:**/*.rbl",
    "workspaceContains:**/*.rbird"
  ],
  "contributes": {
    "languages": [
      {
        "id": "rblang",
        "aliases": [
          "RBLang",
          "rblang"
        ],
        "extensions": [
          ".rbl",
          ".rblang"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./media/rblang-light.svg",
          "dark": "./media/rblang-dark.svg"
        }
      },
      {
        "id": "rbird",
        "aliases": [
          "Rainbird export"
        ],
        "extensions": [
          ".rbird"
        ],
        "icon": {
          "light": "./media/rblang-light.svg",
          "dark": "./media/rblang-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "rblang",
        "scopeName": "text.xml.rblang",
        "path": "./syntaxes/rblang.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "rblang",
        "path": "./snippets/rblang.json"
      }
    ],
    "commands": [
      {
        "command": "rainbird.connect",
        "title": "Rainbird: Connect (set environment & API key)"
      },
      {
        "command": "rainbird.runQuery",
        "title": "Rainbird: Run Query (Quick Pick)…"
      },
      {
        "command": "rainbird.openQueryPanel",
        "title": "Rainbird: Run Query…",
        "icon": "$(play)"
      },
      {
        "command": "rainbird.openGraphView",
        "title": "Rainbird: Show Graph View",
        "icon": "$(type-hierarchy-sub)"
      },
      {
        "command": "rainbird.pushMap",
        "title": "Rainbird: Push Map to Platform (creates a new map)",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "rainbird.explainSelection",
        "title": "Rainbird: Explain with AI"
      },
      {
        "command": "rainbird.setAnthropicKey",
        "title": "Rainbird: Set Anthropic API Key (AI assistant)",
        "icon": "$(gear)"
      },
      {
        "command": "rainbird.assistantNewChat",
        "title": "Rainbird: New Assistant Chat",
        "icon": "$(clear-all)"
      },
      {
        "command": "rainbird.openNlPanel",
        "title": "Rainbird: Ask in Natural Language (beta)…"
      },
      {
        "command": "rainbird.semanticDiff",
        "title": "Rainbird: Diff vs git HEAD (side by side + semantic report)…"
      },
      {
        "command": "rainbird.promotionDiff",
        "title": "Rainbird: Compare Versions (Promotion Diff)…",
        "icon": "$(diff)"
      },
      {
        "command": "rainbird.diffAgainstPushed",
        "title": "Rainbird: Diff Against Last Pushed Snapshot"
      },
      {
        "command": "rainbird.mapsRefresh",
        "title": "Rainbird: Refresh Maps",
        "icon": "$(refresh)"
      },
      {
        "command": "rainbird.mapsAdd",
        "title": "Rainbird: Add Map by kmID…",
        "icon": "$(add)"
      },
      {
        "command": "rainbird.mapsOpen",
        "title": "Open RBLang"
      },
      {
        "command": "rainbird.mapsQuery",
        "title": "Run Query",
        "icon": "$(play)"
      },
      {
        "command": "rainbird.mapsCopyKmId",
        "title": "Copy kmID"
      },
      {
        "command": "rainbird.mapsRemove",
        "title": "Remove from list"
      },
      {
        "command": "rainbird.mapsOpenFile",
        "title": "Open source file"
      },
      {
        "command": "rainbird.showEvidence",
        "title": "Rainbird: Show Evidence Tree for Fact…"
      },
      {
        "command": "rainbird.setEvidenceKey",
        "title": "Rainbird: Set Evidence Key (x-evidence-key)"
      },
      {
        "command": "rainbird.extractRbird",
        "title": "Rainbird: Extract RBLang from .rbird export"
      },
      {
        "command": "rainbird.compareDraft",
        "title": "Rainbird: Compare Draft vs Saved Version…",
        "icon": "$(diff)"
      },
      {
        "command": "rainbird.pullMap",
        "title": "Rainbird: Pull Map RBLang from Platform…",
        "icon": "$(cloud-download)"
      },
      {
        "command": "rainbird.diffAgainstDraft",
        "title": "Rainbird: Diff Open File Against Platform Draft"
      },
      {
        "command": "rainbird.addMcpServer",
        "title": "Rainbird: Add Served Graph as MCP Server…"
      },
      {
        "command": "rainbird.insertElement",
        "title": "Rainbird: Insert… (concept, relationship, instance, fact, rule)",
        "icon": "$(add)"
      },
      {
        "command": "rainbird.addConcept",
        "title": "Rainbird: Add Concept…",
        "icon": "$(add)"
      },
      {
        "command": "rainbird.addRelationship",
        "title": "Rainbird: Add Relationship…",
        "icon": "$(add)"
      },
      {
        "command": "rainbird.addInstance",
        "title": "Rainbird: Add Instance…",
        "icon": "$(add)"
      },
      {
        "command": "rainbird.addFact",
        "title": "Rainbird: Add Fact…",
        "icon": "$(add)"
      },
      {
        "command": "rainbird.addRule",
        "title": "Rainbird: Add Rule…",
        "icon": "$(add)"
      },
      {
        "command": "rainbird.addCondition",
        "title": "Rainbird: Add Condition to Rule at Cursor…",
        "icon": "$(add)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "rainbird",
          "title": "Rainbird",
          "icon": "media/rainbird-activity.svg"
        }
      ]
    },
    "views": {
      "rainbird": [
        {
          "id": "rainbird.mapExplorer",
          "name": "Map Explorer",
          "icon": "media/rainbird-activity.svg"
        },
        {
          "id": "rainbird.platformMaps",
          "name": "Maps",
          "icon": "media/rainbird-activity.svg"
        },
        {
          "id": "rainbird.assistant",
          "type": "webview",
          "name": "AI Assistant",
          "icon": "media/rainbird-activity.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "rainbird.mapExplorer",
        "contents": "Open an RBLang (.rbl) file to explore its concepts, relationships and rules — or start one.\n[Open example](command:rainbird.openExample)\n[Insert into the open file…](command:rainbird.insertElement)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "rainbird.mapsOpen",
          "when": "false"
        },
        {
          "command": "rainbird.mapsQuery",
          "when": "false"
        },
        {
          "command": "rainbird.mapsCopyKmId",
          "when": "false"
        },
        {
          "command": "rainbird.mapsRemove",
          "when": "false"
        },
        {
          "command": "rainbird.mapsOpenFile",
          "when": "false"
        }
      ],
      "editor/title/run": [
        {
          "command": "rainbird.openQueryPanel",
          "when": "editorLangId == rblang",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "rainbird.insertElement",
          "when": "editorLangId == rblang",
          "group": "navigation@0"
        },
        {
          "command": "rainbird.openGraphView",
          "when": "editorLangId == rblang",
          "group": "navigation@1"
        },
        {
          "command": "rainbird.pushMap",
          "when": "editorLangId == rblang",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "rainbird.insertElement",
          "when": "editorLangId == rblang",
          "group": "rainbird@0"
        },
        {
          "command": "rainbird.explainSelection",
          "when": "editorLangId == rblang",
          "group": "rainbird@1"
        },
        {
          "command": "rainbird.semanticDiff",
          "when": "editorLangId == rblang",
          "group": "rainbird@2"
        },
        {
          "command": "rainbird.openNlPanel",
          "when": "editorLangId == rblang",
          "group": "rainbird@3"
        },
        {
          "command": "rainbird.promotionDiff",
          "when": "editorLangId == rblang",
          "group": "rainbird@4"
        },
        {
          "command": "rainbird.diffAgainstPushed",
          "when": "editorLangId == rblang",
          "group": "rainbird@5"
        },
        {
          "command": "rainbird.compareDraft",
          "when": "editorLangId == rblang",
          "group": "rainbird@6"
        },
        {
          "command": "rainbird.diffAgainstDraft",
          "when": "editorLangId == rblang",
          "group": "rainbird@7"
        }
      ],
      "view/title": [
        {
          "command": "rainbird.assistantNewChat",
          "when": "view == rainbird.assistant",
          "group": "navigation@1"
        },
        {
          "command": "rainbird.setAnthropicKey",
          "when": "view == rainbird.assistant",
          "group": "navigation@2"
        },
        {
          "command": "rainbird.mapsAdd",
          "when": "view == rainbird.platformMaps",
          "group": "navigation@1"
        },
        {
          "command": "rainbird.mapsRefresh",
          "when": "view == rainbird.platformMaps",
          "group": "navigation@2"
        },
        {
          "command": "rainbird.pullMap",
          "when": "view == rainbird.platformMaps",
          "group": "navigation@0"
        },
        {
          "command": "rainbird.insertElement",
          "when": "view == rainbird.mapExplorer",
          "group": "navigation@0"
        }
      ],
      "view/item/context": [
        {
          "command": "rainbird.mapsQuery",
          "when": "view == rainbird.platformMaps && viewItem =~ /rainbirdMap/",
          "group": "inline"
        },
        {
          "command": "rainbird.mapsOpen",
          "when": "view == rainbird.platformMaps && viewItem =~ /rainbirdMap/",
          "group": "rainbird@0"
        },
        {
          "command": "rainbird.mapsQuery",
          "when": "view == rainbird.platformMaps && viewItem =~ /rainbirdMap/",
          "group": "rainbird@1"
        },
        {
          "command": "rainbird.mapsCopyKmId",
          "when": "view == rainbird.platformMaps && viewItem =~ /rainbirdMap/",
          "group": "rainbird@2"
        },
        {
          "command": "rainbird.mapsOpenFile",
          "when": "view == rainbird.platformMaps && viewItem == rainbirdMapWithFile",
          "group": "rainbird@3"
        },
        {
          "command": "rainbird.mapsRemove",
          "when": "view == rainbird.platformMaps && viewItem =~ /rainbirdMap/",
          "group": "rainbird@4"
        },
        {
          "command": "rainbird.addConcept",
          "when": "view == rainbird.mapExplorer && viewItem == rainbirdCategory.concepts",
          "group": "inline"
        },
        {
          "command": "rainbird.addRelationship",
          "when": "view == rainbird.mapExplorer && viewItem == rainbirdCategory.relationships",
          "group": "inline"
        },
        {
          "command": "rainbird.addRule",
          "when": "view == rainbird.mapExplorer && viewItem == rainbirdCategory.rules",
          "group": "inline"
        },
        {
          "command": "rainbird.addFact",
          "when": "view == rainbird.mapExplorer && viewItem == rainbirdCategory.facts",
          "group": "inline"
        },
        {
          "command": "rainbird.addInstance",
          "when": "view == rainbird.mapExplorer && viewItem == rainbirdCategory.instances",
          "group": "inline"
        }
      ],
      "explorer/context": [
        {
          "command": "rainbird.extractRbird",
          "when": "resourceExtname == .rbird",
          "group": "rainbird"
        },
        {
          "command": "rainbird.compareDraft",
          "when": "resourceExtname == .rbird",
          "group": "rainbird"
        }
      ]
    },
    "configuration": {
      "title": "Rainbird",
      "properties": {
        "rainbird.apiUrl": {
          "type": "string",
          "default": "https://api.rainbird.ai",
          "description": "Rainbird API base URL (Community: https://api.rainbird.ai, Enterprise: https://enterprise-api.rainbird.ai, or your private environment URL)."
        },
        "rainbird.knowledgeMapId": {
          "type": "string",
          "default": "",
          "description": "Knowledge Map ID (kmID) queries run against. Found on the map's Publish page in Rainbird Studio.",
          "scope": "resource"
        },
        "rainbird.useDraft": {
          "type": "boolean",
          "default": true,
          "description": "Query the draft version of the knowledge map instead of the live version."
        },
        "rainbird.ai.model": {
          "type": "string",
          "default": "claude-opus-5",
          "description": "Claude model the AI assistant uses (via your Anthropic API key)."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "rainbird.gettingStarted",
        "title": "Get started with Rainbird",
        "description": "Author RBLang knowledge maps, run queries and inspect evidence without leaving VSCode. This extension is in beta — expect rough edges and please report issues on GitHub.",
        "steps": [
          {
            "id": "rainbird.openExample",
            "title": "Open an example knowledge map",
            "description": "Open a sample .rbl file to see RBLang language support in action.\n[Open example](command:rainbird.openExample)",
            "media": {
              "markdown": "media/walkthrough/example.md"
            }
          },
          {
            "id": "rainbird.connectStep",
            "title": "Connect to your Rainbird environment",
            "description": "Store your API key securely and choose Community, Enterprise or a private environment.\n[Connect](command:rainbird.connect)",
            "media": {
              "markdown": "media/walkthrough/connect.md"
            },
            "completionEvents": [
              "onCommand:rainbird.connect"
            ]
          },
          {
            "id": "rainbird.queryStep",
            "title": "Run your first query",
            "description": "Pick a goal relationship, answer the questions the engine asks, and get a result with certainty and evidence.\n[Run Query](command:rainbird.runQuery)",
            "media": {
              "markdown": "media/walkthrough/query.md"
            },
            "completionEvents": [
              "onCommand:rainbird.runQuery"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "test": "npm run compile && node --test \"out/test/**/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.4.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0"
  }
}
