{
  "name": "rainbird",
  "displayName": "Rainbird (Beta)",
  "description": "Beta — RBLang language support, knowledge-map tooling, query running and evidence trees for the Rainbird decision-intelligence platform.",
  "version": "0.0.14",
  "preview": true,
  "publisher": "RainbirdTechnologies",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/RainBirdAi/rainbird-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/RainBirdAi/rainbird-vscode/issues"
  },
  "homepage": "https://github.com/RainBirdAi/rainbird-vscode#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Linters",
    "AI",
    "Other"
  ],
  "keywords": [
    "rainbird",
    "rblang",
    "knowledge map",
    "knowledge graph",
    "decision intelligence",
    "reasoning"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:rblang",
    "onLanguage:xml",
    "workspaceContains:**/*.rbl",
    "workspaceContains:**/*.rbird",
    "onStartupFinished"
  ],
  "contributes": {
    "languages": [
      {
        "id": "rblang",
        "aliases": [
          "RBLang",
          "rblang"
        ],
        "extensions": [
          ".rbl",
          ".rblang"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./media/rblang-light.svg",
          "dark": "./media/rblang-dark.svg"
        }
      },
      {
        "id": "rbird",
        "aliases": [
          "Rainbird export"
        ],
        "extensions": [
          ".rbird"
        ],
        "icon": {
          "light": "./media/rblang-light.svg",
          "dark": "./media/rblang-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "rblang",
        "scopeName": "text.xml.rblang",
        "path": "./syntaxes/rblang.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "rblang",
        "path": "./snippets/rblang.json"
      }
    ],
    "commands": [
      {
        "command": "rainbird.getStarted",
        "title": "Rainbird: Get Started"
      },
      {
        "command": "rainbird.connect",
        "title": "Rainbird: Connect (set environment & API key)"
      },
      {
        "command": "rainbird.runQuery",
        "title": "Rainbird: Run Query (Quick Pick)…"
      },
      {
        "command": "rainbird.openQueryPanel",
        "title": "Rainbird: Run Query…",
        "icon": "$(play)"
      },
      {
        "command": "rainbird.openGraphView",
        "title": "Rainbird: Show Graph View",
        "icon": "$(type-hierarchy-sub)"
      },
      {
        "command": "rainbird.pushMap",
        "title": "Rainbird: Push Map to Platform (creates a new map)",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "rainbird.explainSelection",
        "title": "Rainbird: Explain with AI"
      },
      {
        "command": "rainbird.setAnthropicKey",
        "title": "Rainbird: Set Anthropic API Key (AI assistant)",
        "icon": "$(key)"
      },
      {
        "command": "rainbird.assistantNewChat",
        "title": "Rainbird: New Assistant Chat",
        "icon": "$(clear-all)"
      },
      {
        "command": "rainbird.openNlPanel",
        "title": "Rainbird: Ask in Natural Language (beta)…"
      },
      {
        "command": "rainbird.semanticDiff",
        "title": "Rainbird: Diff vs git HEAD (side by side + semantic report)…"
      },
      {
        "command": "rainbird.promotionDiff",
        "title": "Rainbird: Compare Versions (Promotion Diff)…",
        "icon": "$(diff)"
      },
      {
        "command": "rainbird.diffAgainstPushed",
        "title": "Rainbird: Diff Against Last Pulled or Pushed Snapshot"
      },
      {
        "command": "rainbird.mapsRefresh",
        "title": "Rainbird: Refresh Maps",
        "icon": "$(refresh)"
      },
      {
        "command": "rainbird.mapsAdd",
        "title": "Rainbird: Add Map by kmID…",
        "icon": "$(add)"
      },
      {
        "command": "rainbird.mapsOpen",
        "title": "Open RBLang"
      },
      {
        "command": "rainbird.mapsQuery",
        "title": "Run Query",
        "icon": "$(play)"
      },
      {
        "command": "rainbird.mapsReload",
        "title": "Reload from Studio",
        "icon": "$(cloud-download)"
      },
      {
        "command": "rainbird.mapsCopyKmId",
        "title": "Copy kmID"
      },
      {
        "command": "rainbird.mapsRemove",
        "title": "Remove from list"
      },
      {
        "command": "rainbird.mapsOpenFile",
        "title": "Open source file"
      },
      {
        "command": "rainbird.showEvidence",
        "title": "Rainbird: Show Evidence Tree for Fact…"
      },
      {
        "command": "rainbird.setEvidenceKey",
        "title": "Rainbird: Set Evidence Key (x-evidence-key)"
      },
      {
        "command": "rainbird.extractRbird",
        "title": "Rainbird: Extract RBLang from .rbird export"
      },
      {
        "command": "rainbird.compareDraft",
        "title": "Rainbird: Compare Draft vs Saved Version…",
        "icon": "$(diff)"
      },
      {
        "command": "rainbird.openMapByKmId",
        "title": "Rainbird: Open Map by Knowledge Map ID…",
        "icon": "$(cloud-download)"
      },
      {
        "command": "rainbird.pullMap",
        "title": "Rainbird: Pull Map RBLang from Platform (read-only draft or saved version)…",
        "icon": "$(cloud-download)"
      },
      {
        "command": "rainbird.reloadFromPlatform",
