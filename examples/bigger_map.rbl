<?xml version="1.0" encoding="utf-8"?>
<rbl:kb xmlns:rbl="http://rbl.io/schema/RBLang">

  <!-- ..................................................................
       ICD-10 and OPCS-4 endoscopy clinical coding decision model.
       Implements ICD-RB-DM-SPEC v1.0 rule families RF-1 to RF-11.
       Headless and injection only: every rel is askable none, all clinical
       facts arrive from the extraction agent and all classification
       evidence from the datasource agent.
       Rule names carry their specification rule ID for traceability.
       .................................................................. -->

  <!-- ..................... CONCEPTS ..................... -->

  <concept name="Case" type="string"/>
  <concept name="ReportVersion" type="string"/>
  <concept name="ClassificationEdition" type="string"/>
  <concept name="EpisodeDate" type="date"/>
  <concept name="ClinicalConcept" type="string"/>
  <concept name="ProcedureEvent" type="string"/>
  <concept name="EvidenceRecord" type="string"/>
  <concept name="EvidenceBook" type="string"/>
  <concept name="SourceSpan" type="string"/>
  <concept name="NormalisedTerm" type="string"/>
  <concept name="ReportField" type="string"/>
  <concept name="FieldRelevance" type="string"/>
  <concept name="ConceptKind" type="string"/>
  <concept name="Certainty" type="string"/>
  <concept name="Temporality" type="string"/>
  <concept name="Attribution" type="string"/>
  <concept name="EpisodeRelevance" type="string"/>
  <concept name="ConceptDisposition" type="string"/>
  <concept name="EventDisposition" type="string"/>
  <concept name="CodeRole" type="string"/>
  <concept name="ProcedureType" type="string"/>
  <concept name="ScopeModality" type="string"/>
  <concept name="ProcedureIntent" type="string"/>
  <concept name="TherapeuticMethod" type="string"/>
  <concept name="SamplingAct" type="string"/>
  <concept name="AnatomicalSite" type="string"/>
  <concept name="GITract" type="string"/>
  <concept name="ProcedurePattern" type="string"/>
  <concept name="SiteStrategy" type="string"/>
  <concept name="SequenceTemplate" type="string"/>
  <concept name="ReviewTier" type="string"/>
  <concept name="HardStopReason" type="string"/>
  <concept name="AmbiguityReason" type="string"/>
  <concept name="EvidenceStatus" type="string"/>
  <concept name="Anticoagulant" type="string"/>
  <concept name="ScreeningContext" type="string"/>
  <concept name="FeedbackReason" type="string"/>
  <concept name="FeedbackCategory" type="string"/>
  <concept name="RuleIdentifier" type="string"/>
  <concept name="Classification" type="string"/>
  <concept name="Code" type="string"/>
  <concept name="Actor" type="string"/>
  <concept name="CodeMapping" type="string"/>
  <concept name="DiagnosticMapping" type="string"/>
  <concept name="SequenceEntry" type="string"/>
  <concept name="LookupInstruction" type="string"/>
  <concept name="CodingNote" type="string"/>
  <concept name="RoutingReason" type="string"/>
  <concept name="PenaltyRecord" type="string"/>
  <concept name="AgreementSignal" type="string"/>
  <concept name="SequenceBand" type="string"/>

  <concept name="Flag" type="truth"/>
  <concept name="Score" type="number"/>
  <concept name="Weight" type="number"/>
  <concept name="DepthRank" type="number"/>
  <concept name="Offset" type="number"/>
  <concept name="OrderOrdinal" type="number"/>
  <concept name="BlockOrdinal" type="number"/>
  <concept name="PositionOrdinal" type="number"/>
  <concept name="SequenceNumber" type="number"/>
  <concept name="Priority" type="number"/>
  <concept name="TierDepth" type="number"/>
  <concept name="PenaltyPoints" type="number"/>
  <concept name="CertaintyCap" type="number"/>

  <!-- ..................... RELATIONSHIPS ..................... -->
  <!-- Case identity and membership -->
  <rel name="has report version" subject="Case" object="ReportVersion" askable="none"/>
  <rel name="has episode date" subject="Case" object="EpisodeDate" askable="none"/>
  <rel name="has icd edition" subject="Case" object="ClassificationEdition" askable="none"/>
  <rel name="has opcs edition" subject="Case" object="ClassificationEdition" askable="none"/>
  <rel name="has clinical concept" subject="Case" object="ClinicalConcept" plural="true" askable="none"/>
  <rel name="has procedure event" subject="Case" object="ProcedureEvent" plural="true" askable="none"/>
  <rel name="has extent site" subject="Case" object="AnatomicalSite" askable="none"/>
  <rel name="intended extent achieved" subject="Case" object="Flag" askable="none"/>
  <rel name="has screening context" subject="Case" object="ScreeningContext" askable="none"/>
  <rel name="belongs to case" subject="ClinicalConcept" object="Case" askable="none"/>
  <rel name="event belongs to case" subject="ProcedureEvent" object="Case" askable="none"/>
  <rel name="evidence belongs to case" subject="EvidenceRecord" object="Case" askable="none"/>

  <!-- Injected clinical concept attributes -->
  <rel name="appears in field" subject="ClinicalConcept" object="ReportField" askable="none"/>
  <rel name="is anchored at" subject="ClinicalConcept" object="SourceSpan" askable="none"/>
  <rel name="has span start offset" subject="ClinicalConcept" object="Offset" askable="none"/>
  <rel name="has normalised term" subject="ClinicalConcept" object="NormalisedTerm" askable="none"/>
  <rel name="has kind" subject="ClinicalConcept" object="ConceptKind" askable="none"/>
  <rel name="has documented certainty" subject="ClinicalConcept" object="Certainty" askable="none"/>
  <rel name="has temporality" subject="ClinicalConcept" object="Temporality" askable="none"/>
  <rel name="is attributed to" subject="ClinicalConcept" object="Attribution" askable="none"/>
  <rel name="has episode relevance" subject="ClinicalConcept" object="EpisodeRelevance" askable="none"/>
  <rel name="concerns site" subject="ClinicalConcept" object="AnatomicalSite" askable="none"/>
  <rel name="is primary candidate hint" subject="ClinicalConcept" object="Flag" askable="none"/>
  <rel name="has neoplasm nature" subject="ClinicalConcept" object="Flag" askable="none"/>
  <rel name="documents long term or current use" subject="ClinicalConcept" object="Flag" askable="none"/>
  <rel name="names drug" subject="ClinicalConcept" object="Anticoagulant" askable="none"/>
  <!-- RF-4.2 counts this projection, NOT names drug directly. Counting
       names drug conflates no drug named with no APPROVED drug named, and
       an injected drug name outside the approved set still counts, which
       silently disabled the unlisted anticoagulant ambiguity. Fail open on
       a safety rule, so the count reads an approved match only. -->
  <rel name="names approved anticoagulant" subject="ClinicalConcept" object="Flag" askable="none"/>
  <rel name="is described as anticoagulant" subject="ClinicalConcept" object="Flag" askable="none"/>
  <rel name="concerns colorectal cancer" subject="ClinicalConcept" object="Flag" askable="none"/>
  <rel name="shares sentence with diagnosis" subject="ClinicalConcept" object="Flag" askable="none"/>
  <rel name="describes the same condition as" subject="ClinicalConcept" object="ClinicalConcept" plural="true" askable="none"/>
  <rel name="adds documented specificity" subject="ClinicalConcept" object="Flag" askable="none"/>

  <!-- Injected procedure event attributes -->
  <rel name="appears in procedure field" subject="ProcedureEvent" object="ReportField" askable="none"/>
  <rel name="has procedure type" subject="ProcedureEvent" object="ProcedureType" askable="none"/>
  <rel name="has scope modality" subject="ProcedureEvent" object="ScopeModality" askable="none"/>
  <rel name="has documented intent" subject="ProcedureEvent" object="ProcedureIntent" askable="none"/>
  <rel name="has therapeutic method" subject="ProcedureEvent" object="TherapeuticMethod" askable="none"/>
  <rel name="has sampling act" subject="ProcedureEvent" object="SamplingAct" askable="none"/>
  <rel name="concerns procedure site" subject="ProcedureEvent" object="AnatomicalSite" askable="none"/>
  <rel name="is excision" subject="ProcedureEvent" object="Flag" askable="none"/>
  <rel name="has documented order" subject="ProcedureEvent" object="OrderOrdinal" askable="none"/>
  <rel name="states removal" subject="ProcedureEvent" object="Flag" askable="none"/>

  <!-- Reference data: fields, sites, methods, mappings -->
  <rel name="has field relevance" subject="ReportField" object="FieldRelevance" askable="none"/>
  <rel name="belongs to tract" subject="AnatomicalSite" object="GITract" askable="none"/>
  <rel name="has depth rank" subject="AnatomicalSite" object="DepthRank" askable="none"/>
  <rel name="has approved site code" subject="AnatomicalSite" object="Flag" askable="none"/>
  <rel name="has approved local site code" subject="AnatomicalSite" object="Code" askable="none"/>
  <rel name="is more specific than site" subject="AnatomicalSite" object="AnatomicalSite" plural="true" askable="none"/>
  <rel name="method is excisional" subject="TherapeuticMethod" object="Flag" askable="none"/>
  <rel name="is approved anticoagulant" subject="Anticoagulant" object="Flag" askable="none"/>
  <rel name="has classification" subject="Code" object="Classification" askable="none"/>

  <rel name="mapping for method" subject="CodeMapping" object="TherapeuticMethod" askable="none"/>
  <rel name="mapping for procedure type" subject="CodeMapping" object="ProcedureType" plural="true" askable="none"/>
  <rel name="yields body system code" subject="CodeMapping" object="Code" askable="none"/>
  <rel name="yields qualifier code" subject="CodeMapping" object="Code" askable="none"/>
  <rel name="mapping traces to rule" subject="CodeMapping" object="RuleIdentifier" askable="none"/>
<!-- There is deliberately NO mapping suppresses site code flag here. RF-8.5
     decides site code suppression by reading the site named in the retrieved
     Tabular title, never from a hardcoded per mapping assumption, which is
     what the source requires. An inert flag naming exactly the two RFA
     mappings used to sit here and was removed: nothing read it, and leaving
     it invited a future edit to gate on it and reintroduce the hardcoding. -->
  <rel name="is mapping index" subject="CodeMapping" object="Flag" askable="none"/>

  <rel name="diagnostic mapping for procedure type" subject="DiagnosticMapping" object="ProcedureType" plural="true" askable="none"/>
  <rel name="diagnostic mapping requires biopsy" subject="DiagnosticMapping" object="Flag" askable="none"/>
  <rel name="diagnostic mapping yields code" subject="DiagnosticMapping" object="Code" askable="none"/>
  <rel name="diagnostic mapping traces to rule" subject="DiagnosticMapping" object="RuleIdentifier" askable="none"/>
  <rel name="is diagnostic mapping index" subject="DiagnosticMapping" object="Flag" askable="none"/>
  <!-- R-I-14. Projection of the diagnostic mapping table onto the EVENT, so the
       negative test can ask whether any mapping covers this event. The test is
       genuinely two hop, a mapping must match both the procedure type AND the
       biopsy status, and a count cannot traverse two hops. Counting the type
       against the mapping table directly was wrong twice over: the type is the
       OBJECT of that relationship rather than the subject, so the count was
       always zero and a lookup ambiguity was raised on every diagnostic case,
       silently costing all of them fifteen penalty points. -->
  <rel name="event has diagnostic mapping" subject="ProcedureEvent" object="DiagnosticMapping" plural="true" askable="none"/>
  <rel name="event has therapeutic mapping" subject="ProcedureEvent" object="CodeMapping" plural="true" askable="none"/>

  <!-- Ladder priority reference tables -->
  <rel name="disposition selection priority" subject="ConceptDisposition" object="Priority" askable="none"/>
  <rel name="pattern selection priority" subject="ProcedurePattern" object="Priority" askable="none"/>
  <rel name="strategy selection priority" subject="SiteStrategy" object="Priority" askable="none"/>
  <rel name="tier review depth" subject="ReviewTier" object="TierDepth" askable="none"/>
  <rel name="role position ordinal" subject="CodeRole" object="PositionOrdinal" askable="none"/>
  <!-- RF-8.1 scopes its hard stop to the two CHAPTER Y roles by name, not to
       every role whose position ordinal is greater than one. Found by an
       adversarial probe: testing the ordinal also caught SITE_CODE at
       ordinal 3, so a legitimate site code only case (the WE-23 shape)
       raised CHAPTER_Y_IN_PRIMARY_POSITION with no Chapter Y code present
       anywhere in the case. -->
  <rel name="role is chapter y" subject="CodeRole" object="Flag" askable="none"/>
  <rel name="band ordinal" subject="SequenceBand" object="Priority" askable="none"/>
  <rel name="component weight" subject="ClassificationEdition" object="Weight" askable="none"/>

  <!-- RF-1 field relevance and eligibility -->
  <rel name="concept field relevance" subject="ClinicalConcept" object="FieldRelevance" askable="none"/>
  <rel name="is eligible for code generation" subject="ClinicalConcept" object="Flag" askable="none"/>

  <!-- RF-2 disposition ladder -->
  <rel name="candidate disposition" subject="ClinicalConcept" object="ConceptDisposition" plural="true" askable="none"/>
  <rel name="candidate disposition priority" subject="ClinicalConcept" object="Priority" plural="true" askable="none"/>
  <rel name="selected disposition priority" subject="ClinicalConcept" object="Priority" askable="none"/>
  <rel name="has disposition" subject="ClinicalConcept" object="ConceptDisposition" askable="none"/>
  <rel name="requires clarification" subject="ClinicalConcept" object="Flag" askable="none"/>
  <rel name="is treated as definitive" subject="ClinicalConcept" object="Flag" askable="none"/>
  <rel name="has exclusion candidate" subject="ClinicalConcept" object="Flag" askable="none"/>

  <!-- RF-3 and RF-4 diagnosis selection.
       Note the diagnosis role rel is named separately from the Code role rel
       because RBLang keys a relationship by name alone and the two carry
       different subjects. -->
  <rel name="is primary candidate from findings" subject="ClinicalConcept" object="Flag" askable="none"/>
  <rel name="is primary diagnosis candidate" subject="ClinicalConcept" object="Flag" askable="none"/>
  <rel name="has diagnosis role" subject="ClinicalConcept" object="CodeRole" askable="none"/>
  <rel name="is superseded by" subject="ClinicalConcept" object="ClinicalConcept" askable="none"/>
  <rel name="icd band scaled" subject="ClinicalConcept" object="SequenceNumber" askable="none"/>
  <rel name="icd sequence number" subject="ClinicalConcept" object="SequenceNumber" askable="none"/>

  <!-- Case level projections. Counting cannot traverse two hops, so every
       cross concept test in RF-3, RF-4 and RF-10 counts one of these. -->
  <rel name="has definitive primary candidate" subject="Case" object="ClinicalConcept" plural="true" askable="none"/>
  <rel name="has primary candidate concept" subject="Case" object="ClinicalConcept" plural="true" askable="none"/>
  <rel name="has superseded concept" subject="Case" object="ClinicalConcept" plural="true" askable="none"/>
  <rel name="has neoplasm diagnosis concept" subject="Case" object="ClinicalConcept" plural="true" askable="none"/>
  <rel name="has treated codeable concept" subject="Case" object="ClinicalConcept" plural="true" askable="none"/>
  <rel name="has different site biopsy" subject="Case" object="Flag" askable="none"/>
  <rel name="has biopsy event" subject="Case" object="ProcedureEvent" plural="true" askable="none"/>
  <rel name="has non releasable code" subject="Case" object="Code" plural="true" askable="none"/>
<!-- No has chapter y code projection is needed. RF-8.1 tests role is chapter y
     on the code it has already bound, and counts the body system projection
     below. A parallel Chapter Y projection existed and nothing read it. -->
  <rel name="has body system code" subject="Case" object="Code" plural="true" askable="none"/>
  <rel name="is tentative in case" subject="Code" object="Case" askable="none"/>
  <rel name="method order in case" subject="TherapeuticMethod" object="OrderOrdinal" plural="true" askable="none"/>
  <rel name="method block ordinal" subject="TherapeuticMethod" object="BlockOrdinal" askable="none"/>
  <rel name="biopsy concerns lesion" subject="ProcedureEvent" object="Flag" askable="none"/>
<!-- Component one's scaled numerator. Single valued on purpose: exactly one
     rule asserts it and exactly one reads it, and if it were plural a future
     rule adding a second value would silently give component one two answers
     and inflate the attribution score. It was originally misnamed as a rule
     check candidate, which is component FOUR's data, hence the rename. -->
  <rel name="scaled attributed concept count" subject="Case" object="Score" askable="none"/>

  <!-- Set membership held as reference facts rather than as string
       comparisons inside expressions. Every RF-2, RF-3 and RF-5 rule that
       the source states as a set test reads one of these tables, so the set
       is visible, auditable and changeable without touching a rule. -->
  <rel name="attribution excludes diagnosis" subject="Attribution" object="Flag" askable="none"/>
  <rel name="attribution is consultant level" subject="Attribution" object="Flag" askable="none"/>
  <rel name="kind is not a diagnosis statement" subject="ConceptKind" object="Flag" askable="none"/>
  <rel name="kind is symptom like" subject="ConceptKind" object="Flag" askable="none"/>
  <rel name="certainty is treated as definitive" subject="Certainty" object="Flag" askable="none"/>
  <rel name="certainty needs clarification" subject="Certainty" object="Flag" askable="none"/>
  <rel name="temporality is not current episode" subject="Temporality" object="Flag" askable="none"/>
  <rel name="relevance is not current episode" subject="EpisodeRelevance" object="Flag" askable="none"/>
  <rel name="relevance permits primary" subject="EpisodeRelevance" object="Flag" askable="none"/>
  <rel name="relevance permits secondary" subject="EpisodeRelevance" object="Flag" askable="none"/>
  <rel name="field permits code generation" subject="FieldRelevance" object="Flag" askable="none"/>
  <rel name="field is findings field" subject="ReportField" object="Flag" askable="none"/>
  <rel name="field permits anticoagulant policy" subject="ReportField" object="Flag" askable="none"/>
  <rel name="sampling is diagnostic biopsy" subject="SamplingAct" object="Flag" askable="none"/>
  <!-- RF-7.2 to RF-7.4. A sampling act that reclassifies the event overrides
       whatever intent and method the report documented. Held as a table so
       the two overriding acts are named once rather than string tested. -->
  <rel name="sampling overrides documented intent" subject="SamplingAct" object="Flag" askable="none"/>
  <rel name="has intent override" subject="ProcedureEvent" object="Flag" askable="none"/>
  <rel name="procedure type is rigid" subject="ProcedureType" object="Flag" askable="none"/>
  <rel name="strategy uses examined depth" subject="SiteStrategy" object="Flag" askable="none"/>
  <!-- Only a purely diagnostic pattern earns a diagnostic procedure code.
       In a therapeutic case the single endoscopy is already accounted for by
       the body system code, and any surviving biopsy is represented by the
       Y20 marker plus its site code per RF-8.3. Without this the WE-04 code
       set gains a spurious diagnostic procedure code. -->
  <rel name="pattern emits diagnostic procedure code" subject="ProcedurePattern" object="Flag" askable="none"/>
  <!-- R-E-7. The seven bands are a PRIORITY LADDER, not a set of independent
       tests: a family history item that was also investigated satisfies band 2
       and band 7 at once, and the bands are numbered precisely so that the
       later, more specific band wins. So each band rule asserts a CANDIDATE and
       the winner is selected by highest band ordinal, exactly as RF-2.10 selects
       one disposition from many candidates. Asserting into the single valued
       relationship directly let band 2 beat band 7 on a family history concept,
       which put Z80.0 above the personal history codes. -->
  <rel name="candidate sequence band" subject="ClinicalConcept" object="SequenceBand" plural="true" askable="none"/>
  <rel name="candidate band ordinal" subject="ClinicalConcept" object="Priority" plural="true" askable="none"/>
  <rel name="selected band ordinal" subject="ClinicalConcept" object="Priority" askable="none"/>
  <rel name="has sequence band" subject="ClinicalConcept" object="SequenceBand" askable="none"/>
  <rel name="has icd sequence entry" subject="Case" object="SequenceEntry" plural="true" askable="none"/>
  <rel name="has icd code entry" subject="Case" object="SequenceEntry" plural="true" askable="none"/>

  <!-- RF-5 pattern ladder and RF-7 effective procedure -->
  <rel name="has effective scope modality" subject="ProcedureEvent" object="ScopeModality" askable="none"/>
  <rel name="has effective intent" subject="ProcedureEvent" object="ProcedureIntent" askable="none"/>
  <rel name="has effective method" subject="ProcedureEvent" object="TherapeuticMethod" askable="none"/>
  <rel name="is a biopsy for coding" subject="ProcedureEvent" object="Flag" askable="none"/>
  <rel name="has biopsy site" subject="ProcedureEvent" object="AnatomicalSite" askable="none"/>
  <rel name="is therapeutic event" subject="ProcedureEvent" object="Flag" askable="none"/>
  <rel name="is absorbed by" subject="ProcedureEvent" object="ProcedureEvent" askable="none"/>
  <rel name="has event disposition" subject="ProcedureEvent" object="EventDisposition" plural="true" askable="none"/>
  <rel name="biopsy suppressed by excision" subject="ProcedureEvent" object="Flag" askable="none"/>
  <rel name="candidate pattern" subject="Case" object="ProcedurePattern" plural="true" askable="none"/>
  <rel name="candidate pattern priority" subject="Case" object="Priority" plural="true" askable="none"/>
  <rel name="selected pattern priority" subject="Case" object="Priority" askable="none"/>
  <rel name="has procedure pattern" subject="Case" object="ProcedurePattern" askable="none"/>
  <rel name="has sequence template" subject="Case" object="SequenceTemplate" askable="none"/>

  <!-- Case level projections used by counting rules -->
  <rel name="therapeutic method used" subject="Case" object="TherapeuticMethod" plural="true" askable="none"/>
  <rel name="therapeutic site used" subject="Case" object="AnatomicalSite" plural="true" askable="none"/>
  <rel name="examined site" subject="Case" object="AnatomicalSite" plural="true" askable="none"/>
  <rel name="biopsied site" subject="Case" object="AnatomicalSite" plural="true" askable="none"/>
  <rel name="excision site" subject="Case" object="AnatomicalSite" plural="true" askable="none"/>
  <!-- Depth comparison. R-H-5: the two GI tracts have separate ordinal
       scales and a depth comparison is only valid within a tract. The two
       scales overlap numerically, so the tract offset below lifts lower GI
       clear of upper GI and makes a single maximum unambiguous. A case that
       genuinely spans both tracts is caught by RF-6.9 or by the mixed tract
       ambiguity, so it can never be silently mis-coded by the offset. -->
  <rel name="tract depth offset" subject="GITract" object="DepthRank" askable="none"/>
  <rel name="site offset depth" subject="AnatomicalSite" object="DepthRank" askable="none"/>
  <rel name="examined depth in case" subject="Case" object="DepthRank" plural="true" askable="none"/>
  <rel name="biopsied depth in case" subject="Case" object="DepthRank" plural="true" askable="none"/>
  <rel name="furthest examined depth" subject="Case" object="DepthRank" askable="none"/>
  <rel name="furthest biopsied depth" subject="Case" object="DepthRank" askable="none"/>
  <rel name="has therapeutic event" subject="Case" object="ProcedureEvent" plural="true" askable="none"/>
  <rel name="examined tract" subject="Case" object="GITract" plural="true" askable="none"/>
  <rel name="has undocumented random biopsy" subject="Case" object="Flag" askable="none"/>

  <!-- RF-6 site strategy ladder and targets -->
  <rel name="candidate site strategy" subject="Case" object="SiteStrategy" plural="true" askable="none"/>
  <rel name="candidate strategy priority" subject="Case" object="Priority" plural="true" askable="none"/>
  <rel name="selected strategy priority" subject="Case" object="Priority" askable="none"/>
  <rel name="has site strategy" subject="Case" object="SiteStrategy" askable="none"/>
  <rel name="has site code target" subject="Case" object="AnatomicalSite" plural="true" askable="none"/>

  <!-- Codes, roles, suppression, sequencing -->
  <rel name="has tentative code" subject="Case" object="Code" plural="true" askable="none"/>
  <rel name="has code role" subject="Code" object="CodeRole" plural="true" askable="none"/>
  <rel name="code traces to rule" subject="Code" object="RuleIdentifier" plural="true" askable="none"/>
  <rel name="requires tabular verification" subject="Code" object="Flag" askable="none"/>
  <rel name="is suppressed in case" subject="Code" object="Flag" askable="none"/>
  <rel name="suppression reason" subject="Code" object="CodingNote" plural="true" askable="none"/>
  <rel name="is demoted from primary" subject="Code" object="Flag" askable="none"/>
  <!-- Held as a reference fact rather than a string test inside a rule, so
       the screening code is named in one place. -->
  <rel name="code is screening code" subject="Code" object="Flag" askable="none"/>
  <rel name="emits body system code" subject="ProcedureEvent" object="Code" askable="none"/>
  <rel name="emits qualifier code" subject="ProcedureEvent" object="Code" askable="none"/>
  <rel name="emits site code" subject="ProcedureEvent" object="Code" plural="true" askable="none"/>
  <rel name="emits biopsy marker code" subject="ProcedureEvent" object="Code" askable="none"/>
  <rel name="emits biopsy site code" subject="ProcedureEvent" object="Code" askable="none"/>
  <rel name="site code suppressed by collapse" subject="ProcedureEvent" object="Flag" askable="none"/>
  <!-- X-1. Case level projection of the collapse, so the sequence layer can
       move the single shared site code to the TRAILING position that the
       WE-03 and WE-16 answer keys require. -->
  <rel name="has same site collapse" subject="Case" object="Flag" askable="none"/>
  <rel name="is coding block" subject="ProcedureEvent" object="Flag" askable="none"/>
  <!-- R-G-11. A body system code belongs to a METHOD, not to an event. Where
       the same method is used at several sites the code is assigned ONCE and
       followed by a site code per site, so an event whose method was already
       opened by an earlier event contributes only its site code. This flag
       marks those later events. -->
  <rel name="method block already opened" subject="ProcedureEvent" object="Flag" askable="none"/>
  <rel name="sibling method order" subject="ProcedureEvent" object="OrderOrdinal" plural="true" askable="none"/>
  <rel name="has block ordinal" subject="ProcedureEvent" object="BlockOrdinal" askable="none"/>
  <rel name="block ordinal scaled" subject="ProcedureEvent" object="SequenceNumber" askable="none"/>
  <rel name="case block ordinal" subject="Case" object="BlockOrdinal" plural="true" askable="none"/>
  <rel name="last block ordinal" subject="Case" object="BlockOrdinal" askable="none"/>
  <rel name="has opcs sequence entry" subject="Case" object="SequenceEntry" plural="true" askable="none"/>

  <!-- RF-9 evidence -->
  <rel name="supports code" subject="EvidenceRecord" object="Code" askable="none"/>
  <rel name="from book" subject="EvidenceRecord" object="EvidenceBook" askable="none"/>
  <rel name="has evidence edition" subject="EvidenceRecord" object="ClassificationEdition" askable="none"/>
  <rel name="has retrieval timestamp" subject="EvidenceRecord" object="Flag" askable="none"/>
  <rel name="includes required notes" subject="EvidenceRecord" object="Flag" askable="none"/>
  <rel name="all fields present" subject="EvidenceRecord" object="Flag" askable="none"/>
  <rel name="names site in title" subject="EvidenceRecord" object="AnatomicalSite" askable="none"/>
  <rel name="is ambiguous trail" subject="EvidenceRecord" object="Flag" askable="none"/>
  <rel name="trail is resolved" subject="EvidenceRecord" object="Flag" askable="none"/>
  <rel name="has conflict flag" subject="EvidenceRecord" object="Flag" askable="none"/>
  <rel name="datasource unavailable" subject="Case" object="Flag" askable="none"/>
  <rel name="edition unavailable" subject="Case" object="Flag" askable="none"/>
  <!-- R-B-1. The edition a given code must be verified against depends on
       WHICH classification the code belongs to. Checking every code against the
       OPCS edition passed ICD codes only by accident of the test data, and
       comparing the case's ICD edition with its OPCS edition as a drift test is
       meaningless because the two are always different books. This rel resolves
       the correct expected edition per code so both the RF-9.1 evidence check
       and the RF-10 drift penalty compare like with like. -->
  <rel name="expected edition for code" subject="Code" object="ClassificationEdition" askable="none"/>
  <rel name="evidence edition drifted" subject="EvidenceRecord" object="Flag" askable="none"/>
  <rel name="case evidence edition drifted" subject="Case" object="Flag" askable="none"/>
  <rel name="has alphabetical trail" subject="Code" object="EvidenceRecord" plural="true" askable="none"/>
  <rel name="has tabular record" subject="Code" object="EvidenceRecord" plural="true" askable="none"/>
  <rel name="has evidence status" subject="Code" object="EvidenceStatus" plural="true" askable="none"/>
  <rel name="has complete reference evidence" subject="Code" object="Flag" askable="none"/>
  <rel name="is releasable" subject="Code" object="Flag" askable="none"/>
  <rel name="missing evidence note" subject="Case" object="CodingNote" plural="true" askable="none"/>
  <rel name="permits fallback to remembered knowledge" subject="Case" object="Flag" askable="none"/>

  <!-- RF-10 certainty and routing -->
  <rel name="evidence attribution score" subject="Case" object="Score" askable="none"/>
  <rel name="index trail score" subject="Case" object="Score" askable="none"/>
  <rel name="tabular score" subject="Case" object="Score" askable="none"/>
  <rel name="rule check score" subject="Case" object="Score" askable="none"/>
  <!-- R-L-8. The SUPPLIED score is the injected fact; `agreement score` is the
       resolved component that falls back to zero. Keeping them apart is what
       lets the disagreement penalty tell a genuine low score from a missing
       validator, without which every case is charged for a disagreement that
       never happened. -->
  <rel name="has supplied agreement score" subject="Case" object="Score" askable="none"/>
  <rel name="agreement score" subject="Case" object="Score" askable="none"/>
  <!-- R-L-1 component six, the mean injected extraction certainty, weight 5.
       Supplied by the orchestrator exactly as component five is, so it needs the
       same split between the injected fact and the resolved component that falls
       back to zero. Without the supplied rel the component was hardcoded to zero
       and a supplied value could never reach the score. -->
  <rel name="has supplied data quality score" subject="Case" object="Score" askable="none"/>
  <rel name="data quality score" subject="Case" object="Score" askable="none"/>
  <rel name="well attributed concept" subject="Case" object="ClinicalConcept" plural="true" askable="none"/>
  <rel name="raw weighted certainty" subject="Case" object="Score" askable="none"/>
  <!-- R-L-8. One boolean gate per penalty whose underlying condition can match
       several rows. Flag objects dedupe, so many matching rows collapse to one
       fact and the penalty is charged once per case as the source states.
       Without these the penalty rules derive once per row and every extra row
       is charged again. -->
  <rel name="carries unresolved ambiguity" subject="Case" object="Flag" askable="none"/>
  <rel name="carries contradictory site information" subject="Case" object="Flag" askable="none"/>
  <rel name="carries uncertain primary diagnosis" subject="Case" object="Flag" askable="none"/>
  <rel name="carries historical ambiguity" subject="Case" object="Flag" askable="none"/>
  <!-- Three more mirrors, needed for a different reason: each of these three
       penalties is triggered either by a count filtered to a LITERAL object or
       by an expression test, and a literal filtered count over a DERIVED
       relationship does not drive backward chaining. Mirroring the trigger onto
       a boolean lets the zero default count it with a wildcard. -->
  <rel name="carries missing procedure modifier" subject="Case" object="Flag" askable="none"/>
  <rel name="carries validator disagreement" subject="Case" object="Flag" askable="none"/>
  <rel name="carries unlisted anticoagulant" subject="Case" object="Flag" askable="none"/>
  <!-- R-L-8 and D-12. Eight SEPARATE single valued contribution relationships,
       one per penalty, rather than one plural relationship summed with
       sumObjects. The plural idiom is UNSAFE here, proved live by the D-12
       probe: two DIFFERENT penalties that happen to carry the same point value,
       the fifteen for an unresolved ambiguity and the fifteen for current
       versus historical ambiguity, assert the identical subject relationship
       object triple, and identical triples COLLAPSE to one fact. The probe case
       showed three distinct penalty records but a total of twenty rather than
       thirty five. Each penalty therefore gets its own relationship, which
       cannot collide with another penalty, and each resolves to its points or
       to zero so the total is a plain arithmetic sum. This is the fallback
       design decision D-12 names for exactly this outcome. -->
  <rel name="penalty ambiguity" subject="Case" object="PenaltyPoints" askable="none"/>
  <rel name="penalty site conflict" subject="Case" object="PenaltyPoints" askable="none"/>
  <rel name="penalty primary uncertainty" subject="Case" object="PenaltyPoints" askable="none"/>
  <rel name="penalty historical ambiguity" subject="Case" object="PenaltyPoints" askable="none"/>
  <rel name="penalty missing modifier" subject="Case" object="PenaltyPoints" askable="none"/>
  <rel name="penalty edition drift" subject="Case" object="PenaltyPoints" askable="none"/>
  <rel name="penalty disagreement" subject="Case" object="PenaltyPoints" askable="none"/>
  <rel name="penalty unlisted anticoagulant" subject="Case" object="PenaltyPoints" askable="none"/>
  <rel name="penalty subtotal one" subject="Case" object="PenaltyPoints" askable="none"/>
  <rel name="penalty subtotal two" subject="Case" object="PenaltyPoints" askable="none"/>
  <rel name="penalty subtotal three" subject="Case" object="PenaltyPoints" askable="none"/>
  <rel name="penalty subtotal four" subject="Case" object="PenaltyPoints" askable="none"/>
  <rel name="penalty subtotal five" subject="Case" object="PenaltyPoints" askable="none"/>
  <rel name="penalty subtotal six" subject="Case" object="PenaltyPoints" askable="none"/>
  <rel name="applied penalty record" subject="Case" object="PenaltyRecord" plural="true" askable="none"/>
  <rel name="total penalty" subject="Case" object="PenaltyPoints" askable="none"/>
  <rel name="penalised certainty" subject="Case" object="Score" askable="none"/>
  <rel name="certainty cap" subject="Case" object="CertaintyCap" plural="true" askable="none"/>
  <rel name="lowest certainty cap" subject="Case" object="CertaintyCap" askable="none"/>
  <rel name="has certainty" subject="Case" object="Score" askable="none"/>
  <rel name="candidate review tier" subject="Case" object="ReviewTier" plural="true" askable="none"/>
  <rel name="candidate tier depth" subject="Case" object="TierDepth" plural="true" askable="none"/>
  <rel name="selected tier depth" subject="Case" object="TierDepth" askable="none"/>
  <rel name="requires review tier" subject="Case" object="ReviewTier" askable="none"/>
  <rel name="routing reason" subject="Case" object="RoutingReason" plural="true" askable="none"/>
  <rel name="requires human attestation" subject="Case" object="Flag" askable="none"/>
  <rel name="has hard stop" subject="Case" object="HardStopReason" plural="true" askable="none"/>
  <rel name="has ambiguity" subject="Case" object="AmbiguityReason" plural="true" askable="none"/>
  <!-- Single purpose boolean mirrors of two specific reasons. A count
       filtered to a literal object does not drive derivation of the counted
       relationship, so the RF-10 component guards count these markers with an
       unfiltered count instead of filtering the multi valued reason lists. -->
  <rel name="has ambiguous index trail" subject="Case" object="Flag" askable="none"/>
  <rel name="has alpha tabular conflict" subject="Case" object="Flag" askable="none"/>
  <rel name="requires lookup instruction" subject="ClinicalConcept" object="LookupInstruction" plural="true" askable="none"/>
  <rel name="case requires lookup instruction" subject="Case" object="LookupInstruction" plural="true" askable="none"/>
  <rel name="has coding note" subject="Case" object="CodingNote" plural="true" askable="none"/>

  <!-- RF-10.7 calibration. Deliberately isolated: no certainty or routing
       rule reads this relationship. Structural assertion 6. -->
  <rel name="unit agreement signal" subject="Case" object="AgreementSignal" plural="true" askable="none"/>
  <rel name="unit entered code" subject="Case" object="Code" plural="true" askable="none"/>

  <!-- RF-11 feedback -->
  <rel name="maps to category" subject="FeedbackReason" object="FeedbackCategory" askable="none"/>
  <!-- Marks the twenty one classified reasons, so M-7 can catch anything
       else without counting its own target relationship. -->
  <rel name="feedback reason is listed" subject="FeedbackReason" object="Flag" askable="none"/>
  <rel name="requires governance review" subject="FeedbackReason" object="Flag" askable="none"/>
  <rel name="automatic production change allowed" subject="FeedbackReason" object="Flag" askable="none"/>

  <!-- Provenance -->
  <rel name="responsible actor" subject="Case" object="Actor" askable="none"/>

  <!-- ..................... INSTANCES ..................... -->

