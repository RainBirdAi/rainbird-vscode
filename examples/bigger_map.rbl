  <relinst type="mapping for procedure type" subject="MAP-COL-HOTSNARE" object="COLONOSCOPY"/>
  <relinst type="yields body system code" subject="MAP-COL-HOTSNARE" object="OPCS-4:H20.1"/>
  <relinst type="yields qualifier code" subject="MAP-COL-HOTSNARE" object="OPCS-4:Y13.1"/>
  <relinst type="mapping traces to rule" subject="MAP-COL-HOTSNARE" object="LOCAL-METHOD-HOTSNARE-1"/>
  <relinst type="is mapping index" subject="MAP-COL-HOTSNARE" object="true"/>

  <relinst type="mapping for method" subject="MAP-COL-CAUT" object="CAUTERISATION"/>
  <relinst type="mapping for procedure type" subject="MAP-COL-CAUT" object="COLONOSCOPY"/>
  <relinst type="mapping for procedure type" subject="MAP-COL-CAUT" object="FLEXIBLE_SIGMOIDOSCOPY"/>
  <relinst type="yields body system code" subject="MAP-COL-CAUT" object="OPCS-4:H20.2"/>
  <relinst type="mapping traces to rule" subject="MAP-COL-CAUT" object="LOCAL-OPCS-COL-CAUT-1"/>
  <relinst type="is mapping index" subject="MAP-COL-CAUT" object="true"/>

  <relinst type="mapping for method" subject="MAP-COL-APC" object="ARGON_PLASMA_COAGULATION"/>
  <relinst type="mapping for procedure type" subject="MAP-COL-APC" object="COLONOSCOPY"/>
  <relinst type="yields body system code" subject="MAP-COL-APC" object="OPCS-4:H20.2"/>
  <relinst type="yields qualifier code" subject="MAP-COL-APC" object="OPCS-4:Y17.1"/>
  <relinst type="mapping traces to rule" subject="MAP-COL-APC" object="LOCAL-METHOD-APC-1"/>
  <relinst type="is mapping index" subject="MAP-COL-APC" object="true"/>

  <relinst type="mapping for method" subject="MAP-COL-SMR" object="SUBMUCOSAL_RESECTION"/>
  <relinst type="mapping for procedure type" subject="MAP-COL-SMR" object="COLONOSCOPY"/>
  <relinst type="yields body system code" subject="MAP-COL-SMR" object="OPCS-4:H20.5"/>
  <relinst type="mapping traces to rule" subject="MAP-COL-SMR" object="LOCAL-METHOD-SMR-1"/>
  <relinst type="is mapping index" subject="MAP-COL-SMR" object="true"/>

  <relinst type="mapping for method" subject="MAP-SIG-SNARE" object="SNARE_RESECTION"/>
  <relinst type="mapping for procedure type" subject="MAP-SIG-SNARE" object="FLEXIBLE_SIGMOIDOSCOPY"/>
  <relinst type="yields body system code" subject="MAP-SIG-SNARE" object="OPCS-4:H23.1"/>
  <relinst type="mapping traces to rule" subject="MAP-SIG-SNARE" object="LOCAL-OPCS-SIG-SNARE-1"/>
  <relinst type="is mapping index" subject="MAP-SIG-SNARE" object="true"/>

  <relinst type="mapping for method" subject="MAP-UGI-FB" object="FOREIGN_BODY_REMOVAL"/>
  <relinst type="mapping for procedure type" subject="MAP-UGI-FB" object="OGD"/>
  <relinst type="mapping for procedure type" subject="MAP-UGI-FB" object="GASTROSCOPY"/>
  <relinst type="yields body system code" subject="MAP-UGI-FB" object="OPCS-4:G44.2"/>
  <relinst type="mapping traces to rule" subject="MAP-UGI-FB" object="LOCAL-OPCS-UGI-FB-1"/>
  <relinst type="is mapping index" subject="MAP-UGI-FB" object="true"/>

  <relinst type="mapping for method" subject="MAP-UGI-CAUT" object="CAUTERISATION"/>
  <relinst type="mapping for procedure type" subject="MAP-UGI-CAUT" object="OGD"/>
  <relinst type="mapping for procedure type" subject="MAP-UGI-CAUT" object="GASTROSCOPY"/>
  <relinst type="yields body system code" subject="MAP-UGI-CAUT" object="OPCS-4:G43.3"/>
  <relinst type="mapping traces to rule" subject="MAP-UGI-CAUT" object="LOCAL-OPCS-UGI-CAUT-1"/>
  <relinst type="is mapping index" subject="MAP-UGI-CAUT" object="true"/>

  <!-- The three RFA mappings differ by the scope used, not the treatment.
       Y13.4 is constant. The flexible and rigid variants emit no site code
       because their body system code already names the oesophagus. -->
  <relinst type="mapping for method" subject="MAP-RFA-OGD" object="RADIOFREQUENCY_ABLATION"/>
  <relinst type="mapping for procedure type" subject="MAP-RFA-OGD" object="OGD"/>
  <relinst type="yields body system code" subject="MAP-RFA-OGD" object="OPCS-4:G43.5"/>
  <relinst type="yields qualifier code" subject="MAP-RFA-OGD" object="OPCS-4:Y13.4"/>
  <relinst type="mapping traces to rule" subject="MAP-RFA-OGD" object="LOCAL-OPCS-RFA-OGD-1"/>
  <relinst type="is mapping index" subject="MAP-RFA-OGD" object="true"/>

  <relinst type="mapping for method" subject="MAP-RFA-FLEX" object="RADIOFREQUENCY_ABLATION"/>
  <relinst type="mapping for procedure type" subject="MAP-RFA-FLEX" object="FLEXIBLE_OESOPHAGOSCOPY"/>
  <relinst type="yields body system code" subject="MAP-RFA-FLEX" object="OPCS-4:G14.5"/>
  <relinst type="yields qualifier code" subject="MAP-RFA-FLEX" object="OPCS-4:Y13.4"/>
  <relinst type="mapping traces to rule" subject="MAP-RFA-FLEX" object="LOCAL-OPCS-RFA-FLEX-1"/>
  <relinst type="is mapping index" subject="MAP-RFA-FLEX" object="true"/>

  <relinst type="mapping for method" subject="MAP-RFA-RIGID" object="RADIOFREQUENCY_ABLATION"/>
  <relinst type="mapping for procedure type" subject="MAP-RFA-RIGID" object="RIGID_OESOPHAGOSCOPY"/>
  <relinst type="yields body system code" subject="MAP-RFA-RIGID" object="OPCS-4:G17.8"/>
  <relinst type="yields qualifier code" subject="MAP-RFA-RIGID" object="OPCS-4:Y13.4"/>
  <relinst type="mapping traces to rule" subject="MAP-RFA-RIGID" object="LOCAL-OPCS-RFA-RIGID-1"/>
  <relinst type="is mapping index" subject="MAP-RFA-RIGID" object="true"/>

  <!-- Diagnostic first pass mappings. Note deliberately there is NO entry
       for a diagnostic colonoscopy without biopsy. The code H22.9 appears
       in the source material only inside the OPCS4Codes field, which
       RF-1.6 forbids as a source. That pattern falls through to a lookup
       instruction instead. -->
  <relinst type="diagnostic mapping for procedure type" subject="DXMAP-UGI-NOBX" object="OGD"/>
  <relinst type="diagnostic mapping for procedure type" subject="DXMAP-UGI-NOBX" object="GASTROSCOPY"/>
  <relinst type="diagnostic mapping for procedure type" subject="DXMAP-UGI-NOBX" object="UNSPECIFIED_ENDOSCOPY"/>
  <relinst type="diagnostic mapping requires biopsy" subject="DXMAP-UGI-NOBX" object="false"/>
  <relinst type="diagnostic mapping yields code" subject="DXMAP-UGI-NOBX" object="OPCS-4:G45.9"/>
  <relinst type="diagnostic mapping traces to rule" subject="DXMAP-UGI-NOBX" object="LOCAL-OPCS-UGI-DX-1"/>
  <relinst type="is diagnostic mapping index" subject="DXMAP-UGI-NOBX" object="true"/>

  <relinst type="diagnostic mapping for procedure type" subject="DXMAP-UGI-BX" object="OGD"/>
  <relinst type="diagnostic mapping for procedure type" subject="DXMAP-UGI-BX" object="GASTROSCOPY"/>
  <relinst type="diagnostic mapping requires biopsy" subject="DXMAP-UGI-BX" object="true"/>
  <relinst type="diagnostic mapping yields code" subject="DXMAP-UGI-BX" object="OPCS-4:G45.1"/>
  <relinst type="diagnostic mapping traces to rule" subject="DXMAP-UGI-BX" object="LOCAL-OPCS-UGI-BX-1"/>
  <relinst type="is diagnostic mapping index" subject="DXMAP-UGI-BX" object="true"/>

  <relinst type="diagnostic mapping for procedure type" subject="DXMAP-COL-BX" object="COLONOSCOPY"/>
  <relinst type="diagnostic mapping requires biopsy" subject="DXMAP-COL-BX" object="true"/>
  <relinst type="diagnostic mapping yields code" subject="DXMAP-COL-BX" object="OPCS-4:H22.1"/>
  <relinst type="diagnostic mapping traces to rule" subject="DXMAP-COL-BX" object="LOCAL-OPCS-COL-BX-1"/>
  <relinst type="is diagnostic mapping index" subject="DXMAP-COL-BX" object="true"/>

  <!-- Ladder priority tables. Lower ordinal wins. RF-2 order of the
       specification is preserved here as data, so adding a rule cannot
       silently reorder the family. -->
  <relinst type="disposition selection priority" subject="EXCLUDE_NOT_ELIGIBLE" object="5"/>
  <relinst type="disposition selection priority" subject="EXCLUDE_UNATTRIBUTED" object="10"/>
  <relinst type="disposition selection priority" subject="EXCLUDE_NOT_A_DIAGNOSIS" object="20"/>
  <relinst type="disposition selection priority" subject="EXCLUDE_NEGATED" object="30"/>
  <relinst type="disposition selection priority" subject="EXCLUDE_NOT_CURRENT_EPISODE" object="40"/>
  <relinst type="disposition selection priority" subject="EXCLUDE_LESS_SPECIFIC" object="45"/>
  <relinst type="disposition selection priority" subject="SECONDARY_CANDIDATE_HISTORY" object="50"/>
  <relinst type="disposition selection priority" subject="USE_DOCUMENTED_SYMPTOM_OR_CLARIFY" object="60"/>
  <relinst type="disposition selection priority" subject="CODEABLE_CURRENT" object="80"/>

  <!-- RF-5.6b sits ahead of RF-5.6 because both match a single method
       therapeutic case and only the different site condition separates
       them. Without this ordering WE-04 and WE-17 fall through to the
       hard stop. -->
  <relinst type="pattern selection priority" subject="DIAGNOSTIC_ONLY" object="10"/>
  <relinst type="pattern selection priority" subject="DIAGNOSTIC_WITH_BIOPSY" object="20"/>
  <relinst type="pattern selection priority" subject="THERAPEUTIC_DIFFERENT_SITE_BIOPSY" object="30"/>
  <relinst type="pattern selection priority" subject="THERAPEUTIC_SAME_SITE" object="40"/>
  <relinst type="pattern selection priority" subject="MULTI_SITE_SINGLE_METHOD" object="50"/>
  <relinst type="pattern selection priority" subject="MULTI_METHOD" object="60"/>
  <relinst type="pattern selection priority" subject="CLARIFICATION_REQUIRED" object="999"/>

  <!-- RF-6.6b overrides the strategy RF-5.5 assigned, so it must win. -->
  <relinst type="strategy selection priority" subject="FURTHEST_SITE_EXAMINED" object="50"/>
  <relinst type="strategy selection priority" subject="FURTHEST_SITE_BIOPSIED" object="20"/>
  <relinst type="strategy selection priority" subject="EACH_EXCISION_SITE" object="30"/>
  <relinst type="strategy selection priority" subject="THERAPEUTIC_SITE" object="40"/>
  <relinst type="strategy selection priority" subject="SUPPRESS_SITE" object="15"/>
  <relinst type="strategy selection priority" subject="EXTENT_SITE_ONLY" object="10"/>
  <relinst type="strategy selection priority" subject="UNRESOLVED" object="999"/>

  <!-- Review tier depth. The case takes the MAXIMUM depth any rule
       proposed, so the most conservative routing always wins and no hard
       stop or ambiguity can reach EXPEDITED. -->
  <relinst type="tier review depth" subject="EXPEDITED" object="1"/>
  <relinst type="tier review depth" subject="FULL" object="2"/>
  <relinst type="tier review depth" subject="SENIOR_CLARIFICATION" object="3"/>

  <!-- Position of each role within a method block. -->
  <!-- RF-8.1's role set, verbatim from the source: the two Chapter Y roles
       only. A site code sits at ordinal 3 but is NOT a Chapter Y code. -->
  <relinst type="role is chapter y" subject="CHAPTER_Y_METHOD_QUALIFIER" object="true"/>
  <relinst type="role is chapter y" subject="CHAPTER_Y_BIOPSY" object="true"/>

  <relinst type="role position ordinal" subject="BODY_SYSTEM_METHOD" object="1"/>
  <relinst type="role position ordinal" subject="CHAPTER_Y_METHOD_QUALIFIER" object="2"/>
  <relinst type="role position ordinal" subject="SITE_CODE" object="3"/>
  <relinst type="role position ordinal" subject="CHAPTER_Y_BIOPSY" object="4"/>
  <relinst type="role position ordinal" subject="BIOPSY_SITE_CODE" object="5"/>

  <!-- RF-3.6 secondary sequencing bands, in the order the specification
       lists them. Flagged as unconfirmed local policy. -->
  <relinst type="band ordinal" subject="SECONDARY_TREATED" object="2"/>
  <relinst type="band ordinal" subject="SECONDARY_INVESTIGATED" object="3"/>
  <relinst type="band ordinal" subject="INCIDENTAL_FINDING" object="4"/>
  <relinst type="band ordinal" subject="CURRENT_COMORBIDITY" object="5"/>
  <relinst type="band ordinal" subject="LOCAL_POLICY_CODE" object="6"/>
  <relinst type="band ordinal" subject="HISTORY_OR_STATUS" object="7"/>
  <relinst type="band ordinal" subject="FAMILY_HISTORY_BAND" object="8"/>

  <!-- ............ SET MEMBERSHIP TABLES ............
       The specification states many conditions as set tests. Holding each
       set as data rather than as a string comparison inside an expression
       keeps the set auditable and lets a coding lead change policy without
       a rule edit. -->

  <!-- RF-2.1. OTHER_CLINICIAN excludes because the report cannot establish
       delegation. Flagged unconfirmed, SME question 2. -->
  <relinst type="attribution excludes diagnosis" subject="UNATTRIBUTED" object="true"/>
  <relinst type="attribution excludes diagnosis" subject="PATIENT_REPORTED" object="true"/>
  <relinst type="attribution excludes diagnosis" subject="OTHER_CLINICIAN" object="true"/>
  <relinst type="attribution excludes diagnosis" subject="RESPONSIBLE_CONSULTANT" object="false"/>
  <relinst type="attribution excludes diagnosis" subject="DESIGNATED_REPRESENTATIVE" object="false"/>
  <relinst type="attribution is consultant level" subject="RESPONSIBLE_CONSULTANT" object="true"/>
  <relinst type="attribution is consultant level" subject="DESIGNATED_REPRESENTATIVE" object="true"/>
  <relinst type="attribution is consultant level" subject="OTHER_CLINICIAN" object="false"/>
  <relinst type="attribution is consultant level" subject="UNATTRIBUTED" object="false"/>
  <relinst type="attribution is consultant level" subject="PATIENT_REPORTED" object="false"/>

  <!-- RF-2.2 -->
  <relinst type="kind is not a diagnosis statement" subject="PATHOLOGY_OBSERVATION" object="true"/>
  <relinst type="kind is not a diagnosis statement" subject="MEASUREMENT" object="true"/>

  <!-- RF-3.2 -->
  <relinst type="kind is symptom like" subject="SYMPTOM" object="true"/>
  <relinst type="kind is symptom like" subject="ABNORMAL_FINDING" object="true"/>
  <relinst type="kind is symptom like" subject="PROBLEM" object="true"/>

  <!-- RF-2.7 and RF-2.9. DEFINITIVE is listed here because the source has
       no rule making a plainly definitive diagnosis treated as definitive,
       yet RF-3.1 requires it. Recorded as RF-2.9, a source gap. -->
  <relinst type="certainty is treated as definitive" subject="DEFINITIVE" object="true"/>
  <relinst type="certainty is treated as definitive" subject="WORKING" object="true"/>
  <relinst type="certainty is treated as definitive" subject="PRESUMED" object="true"/>
  <relinst type="certainty is treated as definitive" subject="PROBABLE" object="true"/>
  <relinst type="certainty is treated as definitive" subject="TREAT_AS" object="true"/>

  <!-- RF-2.6 -->
  <relinst type="certainty needs clarification" subject="UNRESOLVED_DIFFERENTIAL" object="true"/>
  <relinst type="certainty needs clarification" subject="AMBIGUOUS" object="true"/>

  <!-- RF-2.4 needs BOTH a non current temporality and a non current
       relevance, so the two tables are separate. -->
  <relinst type="temporality is not current episode" subject="HISTORICAL" object="true"/>
  <relinst type="temporality is not current episode" subject="RESOLVED" object="true"/>
  <relinst type="temporality is not current episode" subject="CURRENT" object="false"/>
  <relinst type="relevance is not current episode" subject="IRRELEVANT" object="true"/>
  <relinst type="relevance is not current episode" subject="UNKNOWN" object="true"/>

  <!-- RF-3.1 primary needs TREATED or INVESTIGATED. RF-3.5 secondary
       additionally admits MANAGEMENT_RELEVANT and INCIDENTAL. -->
  <relinst type="relevance permits primary" subject="TREATED" object="true"/>
  <relinst type="relevance permits primary" subject="INVESTIGATED" object="true"/>
  <relinst type="relevance permits secondary" subject="TREATED" object="true"/>
  <relinst type="relevance permits secondary" subject="INVESTIGATED" object="true"/>
  <relinst type="relevance permits secondary" subject="MANAGEMENT_RELEVANT" object="true"/>
  <relinst type="relevance permits secondary" subject="INCIDENTAL" object="true"/>

  <!-- RF-1.9 and the local addition that a CLARIFICATION field may be
       forwarded to a clinician but never coded from. Forwarding a field and
       coding from a field are separate permissions. -->
  <relinst type="field permits code generation" subject="DIAGNOSIS_OR_CONTEXT" object="true"/>
  <relinst type="field permits code generation" subject="DIAGNOSIS_AND_PROCEDURE" object="true"/>
  <relinst type="field permits code generation" subject="PROCEDURE" object="true"/>
  <relinst type="field permits code generation" subject="PROCEDURE_SITE" object="true"/>
  <relinst type="field permits code generation" subject="LOCAL_POLICY_CONTEXT" object="true"/>
  <relinst type="field permits code generation" subject="CLARIFICATION" object="false"/>
  <relinst type="field permits code generation" subject="AUDIT_ONLY" object="false"/>

  <!-- RF-3.6 band 3, incidental findings from these two fields -->
  <relinst type="field is findings field" subject="Findings" object="true"/>
  <relinst type="field is findings field" subject="NEDProcedureDiagnosis" object="true"/>

  <!-- RF-4.1 -->
  <relinst type="field permits anticoagulant policy" subject="ENRAnticoagulants" object="true"/>
  <relinst type="field permits anticoagulant policy" subject="Custom2" object="true"/>

  <!-- RF-5.5. The table is TOTAL over the seven sampling acts, with BRUSHING
       and NO_SAMPLING carrying an explicit false. A biopsy status of false is
       just as load bearing as true: the diagnostic mapping is keyed on
       (procedure type, biopsy status), so an act with NO row at all leaves the
       status underived and the procedure code unreachable. That is what
       silently lost G45.9 on a no sampling upper GI examination. HOT_BIOPSY and
       COLD_BIOPSY are absent on purpose, because RF-7.2, RF-7.3 and RF-7.4
       decide those two directly from the removal wording. -->
  <relinst type="sampling is diagnostic biopsy" subject="COLD_BIOPSY" object="true"/>
  <relinst type="sampling is diagnostic biopsy" subject="CLO_TEST" object="true"/>
  <relinst type="sampling is diagnostic biopsy" subject="SERIAL_BIOPSY" object="true"/>
  <relinst type="sampling is diagnostic biopsy" subject="RANDOM_BIOPSY" object="true"/>
  <relinst type="sampling is diagnostic biopsy" subject="BRUSHING" object="false"/>
  <relinst type="sampling is diagnostic biopsy" subject="NO_SAMPLING" object="false"/>

  <!-- RF-5.1. The fibreoptic default must not reach a rigid procedure. -->
  <relinst type="procedure type is rigid" subject="RIGID_OESOPHAGOSCOPY" object="true"/>
  <relinst type="procedure type is rigid" subject="RIGID_SIGMOIDOSCOPY" object="true"/>
  <relinst type="procedure type is rigid" subject="OGD" object="false"/>
  <relinst type="procedure type is rigid" subject="FLEXIBLE_OESOPHAGOSCOPY" object="false"/>
  <relinst type="procedure type is rigid" subject="GASTROSCOPY" object="false"/>
  <relinst type="procedure type is rigid" subject="COLONOSCOPY" object="false"/>
  <relinst type="procedure type is rigid" subject="FLEXIBLE_SIGMOIDOSCOPY" object="false"/>
  <relinst type="procedure type is rigid" subject="ERCP" object="false"/>
  <relinst type="procedure type is rigid" subject="ENTEROSCOPY" object="false"/>
  <relinst type="procedure type is rigid" subject="UNSPECIFIED_ENDOSCOPY" object="false"/>

  <!-- Both strategies select the furthest site EXAMINED. EXTENT_SITE_ONLY
       exists so the RF-6.6b override can outrank FURTHEST_SITE_BIOPSIED in
       the priority ladder while producing the same target selection. -->
  <relinst type="strategy uses examined depth" subject="FURTHEST_SITE_EXAMINED" object="true"/>
  <relinst type="strategy uses examined depth" subject="EXTENT_SITE_ONLY" object="true"/>

  <!-- Roles of the fixed local codes. The role of a code in this approved
       set is intrinsic, so it is data rather than a derivation. A site code
       standing in the biopsy position takes BIOPSY_SITE_CODE in the
       sequence entry, which is computed per emission. -->
  <relinst type="has code role" subject="ICD-10:Z12.1" object="PRIMARY_DIAGNOSIS"/>
  <relinst type="has code role" subject="ICD-10:Z80.0" object="SECONDARY_DIAGNOSIS"/>
  <relinst type="has code role" subject="ICD-10:Z92.1" object="SECONDARY_DIAGNOSIS"/>
  <relinst type="has code role" subject="OPCS-4:G45.9" object="BODY_SYSTEM_METHOD"/>
  <relinst type="has code role" subject="OPCS-4:G45.1" object="BODY_SYSTEM_METHOD"/>
  <relinst type="has code role" subject="OPCS-4:G44.2" object="BODY_SYSTEM_METHOD"/>
  <relinst type="has code role" subject="OPCS-4:G43.3" object="BODY_SYSTEM_METHOD"/>
  <relinst type="has code role" subject="OPCS-4:G43.5" object="BODY_SYSTEM_METHOD"/>
  <relinst type="has code role" subject="OPCS-4:G14.5" object="BODY_SYSTEM_METHOD"/>
  <relinst type="has code role" subject="OPCS-4:G17.8" object="BODY_SYSTEM_METHOD"/>
  <relinst type="has code role" subject="OPCS-4:H22.1" object="BODY_SYSTEM_METHOD"/>
  <relinst type="has code role" subject="OPCS-4:H20.1" object="BODY_SYSTEM_METHOD"/>
  <relinst type="has code role" subject="OPCS-4:H20.2" object="BODY_SYSTEM_METHOD"/>
  <relinst type="has code role" subject="OPCS-4:H20.5" object="BODY_SYSTEM_METHOD"/>
  <relinst type="has code role" subject="OPCS-4:H20.6" object="BODY_SYSTEM_METHOD"/>
  <relinst type="has code role" subject="OPCS-4:H23.1" object="BODY_SYSTEM_METHOD"/>
  <relinst type="has code role" subject="OPCS-4:Z27.1" object="SITE_CODE"/>
  <relinst type="has code role" subject="OPCS-4:Z27.2" object="SITE_CODE"/>
  <relinst type="has code role" subject="OPCS-4:Z27.3" object="SITE_CODE"/>
  <relinst type="has code role" subject="OPCS-4:Z27.4" object="SITE_CODE"/>
  <relinst type="has code role" subject="OPCS-4:Z27.5" object="SITE_CODE"/>
  <relinst type="has code role" subject="OPCS-4:Z27.6" object="SITE_CODE"/>
  <relinst type="has code role" subject="OPCS-4:Z27.7" object="SITE_CODE"/>
  <relinst type="has code role" subject="OPCS-4:Z28.2" object="SITE_CODE"/>
  <relinst type="has code role" subject="OPCS-4:Z28.3" object="SITE_CODE"/>
  <relinst type="has code role" subject="OPCS-4:Z28.4" object="SITE_CODE"/>
  <relinst type="has code role" subject="OPCS-4:Z28.5" object="SITE_CODE"/>
  <relinst type="has code role" subject="OPCS-4:Z28.6" object="SITE_CODE"/>
  <relinst type="has code role" subject="OPCS-4:Z28.7" object="SITE_CODE"/>
  <relinst type="has code role" subject="OPCS-4:Z29.1" object="SITE_CODE"/>
  <relinst type="has code role" subject="OPCS-4:Z29.2" object="SITE_CODE"/>
  <relinst type="has code role" subject="OPCS-4:Z29.3" object="SITE_CODE"/>
  <relinst type="has code role" subject="OPCS-4:Z29.4" object="SITE_CODE"/>
  <relinst type="has code role" subject="OPCS-4:O11.1" object="SITE_CODE"/>
  <relinst type="has code role" subject="OPCS-4:O30.1" object="SITE_CODE"/>
  <relinst type="has code role" subject="OPCS-4:O30.2" object="SITE_CODE"/>

  <!-- Every code in the approved local set is a first pass candidate only.
       All of them require RF-9 tabular verification before release, so the
       flag is data on the code rather than a rule conclusion. -->
  <relinst type="requires tabular verification" subject="ICD-10:Z12.1" object="true"/>
  <relinst type="requires tabular verification" subject="ICD-10:Z80.0" object="true"/>
  <relinst type="requires tabular verification" subject="ICD-10:Z92.1" object="true"/>
  <relinst type="requires tabular verification" subject="OPCS-4:G45.9" object="true"/>
  <relinst type="requires tabular verification" subject="OPCS-4:G45.1" object="true"/>
  <relinst type="requires tabular verification" subject="OPCS-4:G44.2" object="true"/>
  <relinst type="requires tabular verification" subject="OPCS-4:G43.3" object="true"/>
  <relinst type="requires tabular verification" subject="OPCS-4:G43.5" object="true"/>
  <relinst type="requires tabular verification" subject="OPCS-4:G14.5" object="true"/>
  <relinst type="requires tabular verification" subject="OPCS-4:G17.8" object="true"/>
  <relinst type="requires tabular verification" subject="OPCS-4:H22.1" object="true"/>
  <relinst type="requires tabular verification" subject="OPCS-4:H20.1" object="true"/>
  <relinst type="requires tabular verification" subject="OPCS-4:H20.2" object="true"/>
  <relinst type="requires tabular verification" subject="OPCS-4:H20.5" object="true"/>
  <relinst type="requires tabular verification" subject="OPCS-4:H20.6" object="true"/>
  <relinst type="requires tabular verification" subject="OPCS-4:H23.1" object="true"/>
  <relinst type="requires tabular verification" subject="OPCS-4:Y20.9" object="true"/>
  <relinst type="requires tabular verification" subject="OPCS-4:Y20.3" object="true"/>
  <relinst type="requires tabular verification" subject="OPCS-4:Y13.1" object="true"/>
  <relinst type="requires tabular verification" subject="OPCS-4:Y17.1" object="true"/>
  <relinst type="requires tabular verification" subject="OPCS-4:Y13.4" object="true"/>

  <!-- RF-11 feedback disposition table. Note that automatic production
       change is false in every row with no default path to true. The
       governed improvement cycle is the only route to a map change. -->
  <relinst type="maps to category" subject="MISSING_DOCUMENTATION" object="DOCUMENTATION_ISSUE"/>
  <relinst type="requires governance review" subject="MISSING_DOCUMENTATION" object="false"/>
  <relinst type="automatic production change allowed" subject="MISSING_DOCUMENTATION" object="false"/>
  <relinst type="maps to category" subject="AMBIGUOUS_DOCUMENTATION" object="DOCUMENTATION_ISSUE"/>
  <relinst type="requires governance review" subject="AMBIGUOUS_DOCUMENTATION" object="false"/>
  <relinst type="automatic production change allowed" subject="AMBIGUOUS_DOCUMENTATION" object="false"/>
  <relinst type="maps to category" subject="CLINICIAN_CLARIFICATION" object="DOCUMENTATION_ISSUE"/>
  <relinst type="requires governance review" subject="CLINICIAN_CLARIFICATION" object="false"/>
  <relinst type="automatic production change allowed" subject="CLINICIAN_CLARIFICATION" object="false"/>
  <relinst type="maps to category" subject="MISSED_CONCEPT" object="EXTRACTION_ISSUE"/>
  <relinst type="requires governance review" subject="MISSED_CONCEPT" object="true"/>
  <relinst type="automatic production change allowed" subject="MISSED_CONCEPT" object="false"/>
  <relinst type="maps to category" subject="WRONG_NEGATION" object="EXTRACTION_ISSUE"/>
  <relinst type="requires governance review" subject="WRONG_NEGATION" object="true"/>
  <relinst type="automatic production change allowed" subject="WRONG_NEGATION" object="false"/>
  <relinst type="maps to category" subject="WRONG_STATUS" object="EXTRACTION_ISSUE"/>
  <relinst type="requires governance review" subject="WRONG_STATUS" object="true"/>
  <relinst type="automatic production change allowed" subject="WRONG_STATUS" object="false"/>
  <relinst type="maps to category" subject="WRONG_SOURCE_SPAN" object="EXTRACTION_ISSUE"/>
  <relinst type="requires governance review" subject="WRONG_SOURCE_SPAN" object="true"/>
  <relinst type="automatic production change allowed" subject="WRONG_SOURCE_SPAN" object="false"/>
  <relinst type="maps to category" subject="WRONG_INDEX_TRAIL" object="LOOKUP_ISSUE"/>
  <relinst type="requires governance review" subject="WRONG_INDEX_TRAIL" object="true"/>
  <relinst type="automatic production change allowed" subject="WRONG_INDEX_TRAIL" object="false"/>
  <relinst type="maps to category" subject="WRONG_TABULAR_RECORD" object="LOOKUP_ISSUE"/>
  <relinst type="requires governance review" subject="WRONG_TABULAR_RECORD" object="true"/>
  <relinst type="automatic production change allowed" subject="WRONG_TABULAR_RECORD" object="false"/>
  <relinst type="maps to category" subject="EDITION_MISMATCH_FEEDBACK" object="LOOKUP_ISSUE"/>
  <relinst type="requires governance review" subject="EDITION_MISMATCH_FEEDBACK" object="true"/>
  <relinst type="automatic production change allowed" subject="EDITION_MISMATCH_FEEDBACK" object="false"/>
  <relinst type="maps to category" subject="SITE_UNAVAILABLE" object="LOOKUP_ISSUE"/>
  <relinst type="requires governance review" subject="SITE_UNAVAILABLE" object="true"/>
  <relinst type="automatic production change allowed" subject="SITE_UNAVAILABLE" object="false"/>
  <relinst type="maps to category" subject="RULE_MISMATCH" object="KNOWLEDGE_MAP_ISSUE"/>
  <relinst type="requires governance review" subject="RULE_MISMATCH" object="true"/>
  <relinst type="automatic production change allowed" subject="RULE_MISMATCH" object="false"/>
  <relinst type="maps to category" subject="CONFIDENCE_ROUTING" object="KNOWLEDGE_MAP_ISSUE"/>
  <relinst type="requires governance review" subject="CONFIDENCE_ROUTING" object="true"/>
  <relinst type="automatic production change allowed" subject="CONFIDENCE_ROUTING" object="false"/>
  <relinst type="maps to category" subject="SEQUENCING_RULE" object="KNOWLEDGE_MAP_ISSUE"/>
  <relinst type="requires governance review" subject="SEQUENCING_RULE" object="true"/>
  <relinst type="automatic production change allowed" subject="SEQUENCING_RULE" object="false"/>
  <relinst type="maps to category" subject="UNSUPPORTED_AGENT_CODE" object="AGENT_ISSUE"/>
  <relinst type="requires governance review" subject="UNSUPPORTED_AGENT_CODE" object="true"/>
  <relinst type="automatic production change allowed" subject="UNSUPPORTED_AGENT_CODE" object="false"/>
  <relinst type="maps to category" subject="MISSED_AMBIGUITY" object="AGENT_ISSUE"/>
  <relinst type="requires governance review" subject="MISSED_AMBIGUITY" object="true"/>
  <relinst type="automatic production change allowed" subject="MISSED_AMBIGUITY" object="false"/>
  <relinst type="maps to category" subject="PROMPT_INJECTION" object="AGENT_ISSUE"/>
  <relinst type="requires governance review" subject="PROMPT_INJECTION" object="true"/>
  <relinst type="automatic production change allowed" subject="PROMPT_INJECTION" object="false"/>
  <relinst type="maps to category" subject="NAMESPACE_COLLISION_FEEDBACK" object="AGENT_ISSUE"/>
  <relinst type="requires governance review" subject="NAMESPACE_COLLISION_FEEDBACK" object="true"/>
  <relinst type="automatic production change allowed" subject="NAMESPACE_COLLISION_FEEDBACK" object="false"/>
  <relinst type="maps to category" subject="NATIONAL_STANDARD_CHANGE" object="POLICY_ISSUE"/>
  <relinst type="requires governance review" subject="NATIONAL_STANDARD_CHANGE" object="true"/>
  <relinst type="automatic production change allowed" subject="NATIONAL_STANDARD_CHANGE" object="false"/>
  <relinst type="maps to category" subject="LOCAL_POLICY_CHANGE" object="POLICY_ISSUE"/>
  <relinst type="requires governance review" subject="LOCAL_POLICY_CHANGE" object="true"/>
  <relinst type="automatic production change allowed" subject="LOCAL_POLICY_CHANGE" object="false"/>
  <relinst type="maps to category" subject="CLASSIFICATION_CHANGE" object="POLICY_ISSUE"/>
  <relinst type="requires governance review" subject="CLASSIFICATION_CHANGE" object="true"/>
  <relinst type="automatic production change allowed" subject="CLASSIFICATION_CHANGE" object="false"/>

  <relinst type="code is screening code" subject="ICD-10:Z12.1" object="true"/>

  <relinst type="pattern emits diagnostic procedure code" subject="DIAGNOSTIC_ONLY" object="true"/>
  <relinst type="pattern emits diagnostic procedure code" subject="DIAGNOSTIC_WITH_BIOPSY" object="true"/>

  <relinst type="feedback reason is listed" subject="MISSING_DOCUMENTATION" object="true"/>
  <relinst type="feedback reason is listed" subject="AMBIGUOUS_DOCUMENTATION" object="true"/>
  <relinst type="feedback reason is listed" subject="CLINICIAN_CLARIFICATION" object="true"/>
  <relinst type="feedback reason is listed" subject="MISSED_CONCEPT" object="true"/>
  <relinst type="feedback reason is listed" subject="WRONG_NEGATION" object="true"/>
  <relinst type="feedback reason is listed" subject="WRONG_STATUS" object="true"/>
  <relinst type="feedback reason is listed" subject="WRONG_SOURCE_SPAN" object="true"/>
  <relinst type="feedback reason is listed" subject="WRONG_INDEX_TRAIL" object="true"/>
  <relinst type="feedback reason is listed" subject="WRONG_TABULAR_RECORD" object="true"/>
  <relinst type="feedback reason is listed" subject="EDITION_MISMATCH_FEEDBACK" object="true"/>
  <relinst type="feedback reason is listed" subject="SITE_UNAVAILABLE" object="true"/>
  <relinst type="feedback reason is listed" subject="RULE_MISMATCH" object="true"/>
  <relinst type="feedback reason is listed" subject="CONFIDENCE_ROUTING" object="true"/>
  <relinst type="feedback reason is listed" subject="SEQUENCING_RULE" object="true"/>
  <relinst type="feedback reason is listed" subject="UNSUPPORTED_AGENT_CODE" object="true"/>
  <relinst type="feedback reason is listed" subject="MISSED_AMBIGUITY" object="true"/>
  <relinst type="feedback reason is listed" subject="PROMPT_INJECTION" object="true"/>
  <relinst type="feedback reason is listed" subject="NAMESPACE_COLLISION_FEEDBACK" object="true"/>
  <relinst type="feedback reason is listed" subject="NATIONAL_STANDARD_CHANGE" object="true"/>
  <relinst type="feedback reason is listed" subject="LOCAL_POLICY_CHANGE" object="true"/>
  <relinst type="feedback reason is listed" subject="CLASSIFICATION_CHANGE" object="true"/>

  <!-- RF-7.2 and RF-7.3 and RF-7.4. Hot and cold biopsy both reclassify the
       event, so the documented intent and method must not be used. -->
  <relinst type="sampling overrides documented intent" subject="HOT_BIOPSY" object="true"/>
  <relinst type="sampling overrides documented intent" subject="COLD_BIOPSY" object="true"/>

  <!-- R-H-5. Lower GI depths are lifted clear of upper GI so a single
       maximum cannot compare across the two scales by accident. -->
  <relinst type="tract depth offset" subject="UpperGI" object="0"/>
  <relinst type="tract depth offset" subject="LowerGI" object="1000"/>

  <!-- ================================================================
       L2  RF-1  FIELD RELEVANCE AND ELIGIBILITY
       ================================================================ -->

  <relinst type="concept field relevance" name="RF-1.1 to RF-1.8 concept inherits its field relevance [LOCAL-FIELD-1..7]"
           cf="100" alt="The concept came from a report field whose local relevance is {{%O}}">
    <condition rel="appears in field" subject="%S" object="%FIELD"/>
    <condition rel="has field relevance" subject="%FIELD" object="%O"/>
  </relinst>

  <!-- RF-1.8 default. A field with no relevance row is AUDIT_ONLY, the
       safe direction: unknown fields cannot generate codes. -->
  <relinst type="concept field relevance" object="AUDIT_ONLY"
           name="RF-1.8 default relevance for an unlisted field [LOCAL-FIELD-DEFAULT]" cf="100"
           alt="The field is not in the local relevance table so it is treated as audit only">
    <condition rel="appears in field" subject="%S" object="%FIELD" weight="1"/>
    <condition expression="countRelationshipInstances(%FIELD,'has field relevance',*) is equal to 0"
               alt="The report field {{%FIELD}} has no entry in the local field relevance table"/>
  </relinst>

  <relinst type="is eligible for code generation" object="true"
           name="RF-1 concept from a code bearing field is eligible [LOCAL-FIELD-1]" cf="100"
           alt="The concept comes from a field the local guidance permits coding from">
    <condition rel="concept field relevance" subject="%S" object="%REL"/>
    <condition rel="field permits code generation" subject="%REL" object="true"/>
  </relinst>

  <!-- RF-1.9 NEGATIVE. The single most important negative pair in the
       model. The OPCS4Codes field holds codes the endoscopy unit already
       entered and local guidance is explicit that they are not a source. -->
  <relinst type="is eligible for code generation" object="false"
           name="RF-1.9 concept from an audit only or clarification field is not eligible [LOCAL-FIELD-DEFAULT]" cf="100"
           alt="The concept comes from a field that must not generate codes">
    <condition rel="concept field relevance" subject="%S" object="%REL"/>
    <condition rel="field permits code generation" subject="%REL" object="false"/>
  </relinst>

  <!-- ================================================================
       L3  RF-2  CONCEPT DISPOSITION
       Every rule asserts a CANDIDATE freely; the ladder picks the winner by
       minimum priority. This resolves the family self contradiction: the
       source says first satisfied wins yet RF-2.8 carries no exclusion
       disposition holds, which presupposes the earlier rules already ran.
       Losing candidates stay visible, which is what G13 needs.
       ================================================================ -->

  <relinst type="candidate disposition" object="EXCLUDE_NOT_ELIGIBLE"
           name="RF-2.0 ineligible concept excluded [LOCAL-FIELD-DEFAULT]" cf="100"
           alt="The concept is not eligible for code generation">
    <condition rel="is eligible for code generation" subject="%S" object="false"/>
  </relinst>

  <relinst type="candidate disposition" object="EXCLUDE_UNATTRIBUTED"
           name="RF-2.1 diagnosis without consultant attribution excluded [DGCS.4]" cf="100"
           alt="A diagnosis attributed as {{%ATTR}} cannot be coded because DGCS.4 requires a responsible consultant">
    <condition rel="has kind" subject="%S" object="DIAGNOSIS"/>
    <condition rel="is attributed to" subject="%S" object="%ATTR"/>
    <condition rel="attribution excludes diagnosis" subject="%ATTR" object="true"/>
  </relinst>

  <relinst type="requires clarification" object="true"
           name="RF-2.1 unattributed diagnosis requires clarification [DGCS.4]" cf="100"
           alt="The diagnosis needs clinician attribution before it can be coded">
    <condition rel="has kind" subject="%S" object="DIAGNOSIS"/>
    <condition rel="is attributed to" subject="%S" object="%ATTR"/>
    <condition rel="attribution excludes diagnosis" subject="%ATTR" object="true"/>
  </relinst>

  <!-- RF-2.2 NEGATIVE. A pathology observation or measurement is not a
       diagnosis unless a clinician diagnosis shares its sentence. -->
  <relinst type="candidate disposition" object="EXCLUDE_NOT_A_DIAGNOSIS"
           name="RF-2.2 pathology observation with no diagnosis in the same sentence excluded [DGCS.4]" cf="100"
           alt="The observation is not a clinician diagnosis and no diagnosis shares its sentence">
    <condition rel="has kind" subject="%S" object="%KIND"/>
    <condition rel="kind is not a diagnosis statement" subject="%KIND" object="true"/>
    <condition rel="shares sentence with diagnosis" subject="%S" object="false"/>
  </relinst>

  <relinst type="candidate disposition" object="EXCLUDE_NEGATED"
           name="RF-2.3 negated concept excluded [SDD 5.3]" cf="100"
           alt="The report negates this concept">
    <condition rel="has documented certainty" subject="%S" object="NEGATED"/>
  </relinst>

  <relinst type="candidate disposition" object="EXCLUDE_NOT_CURRENT_EPISODE"
           name="RF-2.4 historical concept irrelevant to this episode excluded [DGCS.3]" cf="100"
           alt="The concept is {{%TEMP}} and its relevance to this episode is {{%REL}}">
    <condition rel="has temporality" subject="%S" object="%TEMP"/>
    <condition rel="temporality is not current episode" subject="%TEMP" object="true"/>
    <condition rel="has episode relevance" subject="%S" object="%REL"/>
    <condition rel="relevance is not current episode" subject="%REL" object="true"/>
  </relinst>

  <!-- RF-2.5 caps at 90. Current versus historical relevance is the
       commonest source of coder disagreement, so the cap forces FULL
       review rather than EXPEDITED. -->
  <relinst type="candidate disposition" object="SECONDARY_CANDIDATE_HISTORY"
           name="RF-2.5 management relevant history becomes a secondary candidate [DGCS.3]" cf="90"
           alt="A historical condition recorded in the past history field is relevant to managing this episode">
    <condition rel="has temporality" subject="%S" object="HISTORICAL"/>
    <condition rel="appears in field" subject="%S" object="Custom2"/>
    <condition rel="has episode relevance" subject="%S" object="MANAGEMENT_RELEVANT"/>
  </relinst>

  <relinst type="requires lookup instruction"
           name="RF-2.5 lookup instruction for a history or status code [DGCS.3]" cf="90">
    <condition rel="has temporality" subject="%S" object="HISTORICAL"/>
    <condition rel="appears in field" subject="%S" object="Custom2"/>
    <condition rel="has episode relevance" subject="%S" object="MANAGEMENT_RELEVANT"/>
    <condition rel="has normalised term" subject="%S" object="%TERM"/>
    <condition expression="'Alphabetical;' + %TERM + ';personal history or presence of device or status;SECONDARY_DIAGNOSIS;RF-2.5 historical condition relevant to management'" value="%O"/>
  </relinst>

  <relinst type="candidate disposition" object="USE_DOCUMENTED_SYMPTOM_OR_CLARIFY"
           name="RF-2.6 unresolved differential uses the documented symptom or is clarified [DGCS.2]" cf="100"
           alt="The documented certainty is {{%CERT}} so the differential is unresolved">
    <condition rel="has documented certainty" subject="%S" object="%CERT"/>
    <condition rel="certainty needs clarification" subject="%CERT" object="true"/>
  </relinst>

  <relinst type="requires clarification" object="true"
           name="RF-2.6 unresolved differential requires clarification [DGCS.2]" cf="100"
           alt="An unresolved differential needs clinician clarification before coding">
    <condition rel="has documented certainty" subject="%S" object="%CERT"/>
    <condition rel="certainty needs clarification" subject="%CERT" object="true"/>
  </relinst>

  <!-- RF-2.7 with RF-2.9 folded into the same certainty table. Local
       guidance: code presumed, probable or treat as as a definitive
       diagnosis. RF-2.9 adds DEFINITIVE itself, which the source omits
       although RF-3.1 requires it. -->
  <relinst type="is treated as definitive" object="true"
           name="RF-2.7 and RF-2.9 qualified or definitive diagnosis is treated as definitive [DGCS.2]" cf="100"
           alt="A diagnosis documented as {{%CERT}} by a consultant is coded as definitive">
    <condition rel="has documented certainty" subject="%S" object="%CERT"/>
    <condition rel="certainty is treated as definitive" subject="%CERT" object="true"/>
    <condition rel="is attributed to" subject="%S" object="%ATTR"/>
    <condition rel="attribution is consultant level" subject="%ATTR" object="true"/>
    <condition rel="has temporality" subject="%S" object="CURRENT"/>
  </relinst>

  <!-- RF-2.8. No negative condition is needed: CODEABLE_CURRENT sits last
       at priority 80 so any exclusion candidate outranks it. -->
  <relinst type="candidate disposition" object="CODEABLE_CURRENT"
           name="RF-2.8 eligible current concept is codeable [DGCS.1]" cf="100"
           alt="The concept is eligible, current, and no exclusion outranks it">
    <condition rel="is eligible for code generation" subject="%S" object="true"/>
    <condition rel="has temporality" subject="%S" object="CURRENT"/>
  </relinst>

  <!-- The generic disposition ladder. The prime bind leads so the count
       drives derivation of the candidate family; a count filtered by a
       bound variable does not. -->
  <relinst type="candidate disposition priority"
           name="RF-2 ladder join candidate disposition to its priority" cf="100">
    <condition rel="candidate disposition" subject="%S" object="%DISP"/>
    <condition rel="disposition selection priority" subject="%DISP" object="%O"/>
  </relinst>

  <relinst type="selected disposition priority"
           name="RF-2 ladder select the highest ranking disposition" cf="100">
    <condition rel="candidate disposition" subject="%S" object="%ANY" weight="1"/>
    <condition expression="countRelationshipInstances(%S,'candidate disposition priority',*) is greater than or equal to 1"
               alt="The concept has at least one candidate disposition" weight="1"/>
    <condition expression="minObjects(%S,'candidate disposition priority',*)" value="%O"
               alt="The highest ranking disposition has priority {{%O}}"/>
  </relinst>

  <relinst type="has disposition"
           name="RF-2.10 exactly one disposition per concept [DGCS.1]" cf="100"
           alt="The concept disposition is {{%O}}">
    <condition rel="selected disposition priority" subject="%S" object="%WIN"/>
    <condition rel="candidate disposition" subject="%S" object="%O"/>
    <condition rel="disposition selection priority" subject="%O" object="%WIN"/>
  </relinst>

  <!-- Exclusion visibility for G13. A concept can carry an exclusion
       candidate even when a different disposition wins, and the coder needs
       to see it. -->
  <relinst type="has exclusion candidate" object="true"
           name="RF-2 record that an exclusion was considered [DGCS.1]" cf="100"
           alt="At least one exclusion disposition was raised for this concept">
    <condition rel="candidate disposition" subject="%S" object="%DISP" weight="1"/>
    <condition rel="disposition selection priority" subject="%DISP" object="%P"/>
    <condition expression="%P is less than 50" alt="The disposition {{%DISP}} is an exclusion"/>
  </relinst>

  <!-- ================================================================
       L4  RF-3 and RF-4  DIAGNOSIS SELECTION AND SEQUENCING
       ================================================================ -->

  <relinst type="is primary candidate from findings" object="true"
           name="RF-3.1 main condition treated or investigated is the primary candidate [DGCS.1i]" cf="100"
           alt="The concept is a definitive current diagnosis that was {{%REL}} in this episode">
    <condition rel="has disposition" subject="%S" object="CODEABLE_CURRENT"/>
    <condition rel="has kind" subject="%S" object="DIAGNOSIS"/>
    <condition rel="is treated as definitive" subject="%S" object="true"/>
    <condition rel="has episode relevance" subject="%S" object="%REL"/>
    <condition rel="relevance permits primary" subject="%REL" object="true"/>
  </relinst>

  <relinst type="is primary diagnosis candidate" object="true"
           name="RF-3.1 promote the findings primary candidate [DGCS.1i]" cf="100"
           alt="The diagnosis from the findings is a primary diagnosis candidate">
    <condition rel="is primary candidate from findings" subject="%S" object="true"/>
  </relinst>

  <relinst type="has definitive primary candidate"
           name="RF-3 project findings primary candidates onto the case [DGCS.1]" cf="100">
    <condition rel="has clinical concept" subject="%S" object="%O"/>
    <condition rel="is primary candidate from findings" subject="%O" object="true"/>
  </relinst>

  <!-- RF-3.2. If no diagnosis is made from the findings the indications
       become the first codes assigned. The prime bind leads so the zero
       count drives derivation of the findings candidate family. -->
  <relinst type="is primary diagnosis candidate" object="true"
           name="RF-3.2 indication becomes primary when no diagnosis was made [DGCS.1ii]" cf="100"
           alt="No diagnosis was made from the findings so the documented indication is coded first">
    <condition rel="has disposition" subject="%S" object="CODEABLE_CURRENT"/>
    <condition rel="belongs to case" subject="%S" object="%CASE" weight="1"/>
    <condition rel="has kind" subject="%S" object="%KIND"/>
    <condition rel="kind is symptom like" subject="%KIND" object="true"/>
    <condition rel="appears in field" subject="%S" object="IndicationForExam"/>
    <condition expression="countRelationshipInstances(%CASE,'has definitive primary candidate',*) is equal to 0"
               alt="No concept in the case is a definitive diagnosis from the findings"/>
  </relinst>

  <!-- RF-3.3 specificity reselection. The equivalence is asserted by
       extraction only where the report states it, never inferred from
       clinical similarity, which would be silent re-diagnosis. -->
  <relinst type="is primary diagnosis candidate" object="true"
           name="RF-3.3 more specific concept replaces the primary candidate [ICD-SPECIFICITY]" cf="100"
           alt="This concept describes the same condition with documented specificity the other lacks">
    <condition rel="describes the same condition as" subject="%S" object="%OTHER"/>
    <condition rel="is primary candidate from findings" subject="%OTHER" object="true"/>
    <condition rel="adds documented specificity" subject="%S" object="true"/>
    <condition rel="has disposition" subject="%S" object="CODEABLE_CURRENT"/>
  </relinst>

  <relinst type="is superseded by"
           name="RF-3.3 record the supersession [ICD-SPECIFICITY]" cf="100"
           alt="The less specific concept is superseded">
    <condition rel="describes the same condition as" subject="%O" object="%S"/>
    <condition rel="is primary candidate from findings" subject="%S" object="true"/>
    <condition rel="adds documented specificity" subject="%O" object="true"/>
    <condition rel="has disposition" subject="%O" object="CODEABLE_CURRENT"/>
  </relinst>

  <relinst type="candidate disposition" object="EXCLUDE_LESS_SPECIFIC"
           name="RF-3.3 superseded concept is excluded as less specific [ICD-SPECIFICITY]" cf="100"
           alt="A more specific concept describing the same condition was coded instead">
    <condition rel="is superseded by" subject="%S" object="%OTHER"/>
  </relinst>

  <relinst type="has primary candidate concept"
           name="RF-3 project all primary candidates onto the case [DGCS.1]" cf="100">
    <condition rel="has clinical concept" subject="%S" object="%O"/>
    <condition rel="is primary diagnosis candidate" subject="%O" object="true"/>
  </relinst>

  <relinst type="has superseded concept"
           name="RF-3 project superseded concepts onto the case [ICD-SPECIFICITY]" cf="100">
    <condition rel="has clinical concept" subject="%S" object="%O"/>
    <condition rel="is superseded by" subject="%O" object="%ANY"/>
  </relinst>

  <!-- RF-3.4 HARD STOP. More than one unordered primary candidate. The two
       counts are compared rather than testing for exactly one supersession,
       so a partial ordering still stops. -->
  <relinst type="has hard stop" object="MULTIPLE_UNRESOLVED_PRIMARY_CANDIDATES"
           name="RF-3.4 more than one primary candidate with no supersession is a hard stop [DGCS.1]" cf="100"
           alt="The case has {{%PC}} primary diagnosis candidates and {{%SC}} of them are superseded">
    <condition rel="has primary candidate concept" subject="%S" object="%ANY" weight="1"/>
    <condition expression="countRelationshipInstances(%S,'has primary candidate concept',*)" value="%PC"
               alt="The case has {{%PC}} primary diagnosis candidates"/>
    <condition expression="countRelationshipInstances(%S,'has superseded concept',*)" value="%SC"
               alt="{{%SC}} concepts in the case are superseded by a more specific one"/>
    <condition expression="%PC is greater than 1" alt="More than one concept claims the primary position"/>
    <condition expression="%SC is equal to 0" alt="No supersession relationship orders them"/>
  </relinst>

  <relinst type="has diagnosis role" object="PRIMARY_DIAGNOSIS"
           name="RF-3.6 primary diagnosis takes ICD position one [DGCS.1]" cf="100"
           alt="The primary diagnosis is sequenced first">
    <condition rel="is primary diagnosis candidate" subject="%S" object="true"/>
    <condition expression="countRelationshipInstances(%S,'is superseded by',*) is equal to 0"
               alt="The concept is not superseded by a more specific one"/>
  </relinst>

  <relinst type="icd sequence number" object="1"
           name="RF-3.6 primary diagnosis sequence number [DGCS.1]" cf="100"
           alt="The primary diagnosis is sequence position one">
    <condition rel="has diagnosis role" subject="%S" object="PRIMARY_DIAGNOSIS"/>
  </relinst>

  <!-- RF-3.5. All other relevant diagnoses must be coded in addition to
       the primary diagnosis. -->
  <relinst type="has diagnosis role" object="SECONDARY_DIAGNOSIS"
           name="RF-3.5 other relevant concepts are secondary diagnoses [DGCS.1]" cf="100"
           alt="The concept is relevant to the episode but is not the primary diagnosis">
    <condition rel="has disposition" subject="%S" object="CODEABLE_CURRENT"/>
    <condition rel="has episode relevance" subject="%S" object="%REL"/>
    <condition rel="relevance permits secondary" subject="%REL" object="true"/>
    <condition expression="countRelationshipInstances(%S,'is primary diagnosis candidate',*) is equal to 0"
               alt="The concept is not a primary diagnosis candidate"/>
  </relinst>

  <relinst type="has diagnosis role" object="SECONDARY_DIAGNOSIS"
           name="RF-2.5 management relevant history is a secondary diagnosis [DGCS.3]" cf="90"
           alt="A relevant historical condition is coded as a secondary diagnosis">
    <condition rel="has disposition" subject="%S" object="SECONDARY_CANDIDATE_HISTORY"/>
  </relinst>

  <!-- RF-3.6 secondary sequencing bands, in the order the source lists
       them. Flagged as unconfirmed local policy, governance gate 5. The
       band is recorded on the fact so a coder can see WHY an order was
       chosen rather than only what it was. -->
  <relinst type="candidate sequence band" object="SECONDARY_TREATED"
           name="RF-3.6 band 1 secondary treated [DGCS.1]" cf="100"
           alt="The condition was treated in this episode">
    <condition rel="has diagnosis role" subject="%S" object="SECONDARY_DIAGNOSIS"/>
    <condition rel="has episode relevance" subject="%S" object="TREATED"/>
  </relinst>

  <relinst type="candidate sequence band" object="SECONDARY_INVESTIGATED"
           name="RF-3.6 band 2 secondary investigated [DGCS.1]" cf="100"
           alt="The condition was investigated in this episode">
    <condition rel="has diagnosis role" subject="%S" object="SECONDARY_DIAGNOSIS"/>
    <condition rel="has episode relevance" subject="%S" object="INVESTIGATED"/>
  </relinst>

  <relinst type="candidate sequence band" object="INCIDENTAL_FINDING"
           name="RF-3.6 band 3 incidental finding [DGCS.1]" cf="100"
           alt="The condition is an incidental finding recorded in the findings">
    <condition rel="has diagnosis role" subject="%S" object="SECONDARY_DIAGNOSIS"/>
    <condition rel="has episode relevance" subject="%S" object="INCIDENTAL"/>
    <condition rel="appears in field" subject="%S" object="%FIELD"/>
    <condition rel="field is findings field" subject="%FIELD" object="true"/>
  </relinst>

  <relinst type="candidate sequence band" object="CURRENT_COMORBIDITY"
           name="RF-3.6 band 4 current comorbidity [DGCS.1]" cf="100"
           alt="The condition is a current comorbidity relevant to management">
    <condition rel="has diagnosis role" subject="%S" object="SECONDARY_DIAGNOSIS"/>
    <condition rel="has episode relevance" subject="%S" object="MANAGEMENT_RELEVANT"/>
    <condition rel="appears in field" subject="%S" object="Custom2"/>
    <condition rel="has temporality" subject="%S" object="CURRENT"/>
  </relinst>

  <relinst type="candidate sequence band" object="HISTORY_OR_STATUS"
           name="RF-3.6 band 6 personal history or status [DGCS.3]" cf="90"
           alt="The condition is a personal history or status code">
    <condition rel="has disposition" subject="%S" object="SECONDARY_CANDIDATE_HISTORY"/>
  </relinst>

  <relinst type="candidate sequence band" object="FAMILY_HISTORY_BAND"
           name="RF-3.6 band 7 family history [LOCAL-ICD-SCREEN-2]" cf="100"
           alt="The concept is a family history item">
    <condition rel="has diagnosis role" subject="%S" object="SECONDARY_DIAGNOSIS"/>
    <condition rel="has kind" subject="%S" object="FAMILY_HISTORY_ITEM"/>
  </relinst>

  <!-- R-E-7 band ladder. Where a concept satisfies several bands the HIGHEST
       band ordinal wins, because the bands run general to specific: a family
       history item is investigated in every screening episode, so band 2 would
       otherwise mask band 7 and Z80.0 would sort above the personal history
       codes. The prime bind leads so the count drives derivation of the
       candidate family, per the count and backward chaining finding. -->
  <relinst type="candidate band ordinal"
           name="RF-3.6 join each candidate band to its ordinal [DGCS.1]" cf="100">
    <condition rel="candidate sequence band" subject="%S" object="%BAND"/>
    <condition rel="band ordinal" subject="%BAND" object="%O"/>
  </relinst>

  <relinst type="selected band ordinal"
           name="RF-3.6 the most specific band wins [DGCS.1]" cf="100">
    <condition rel="candidate sequence band" subject="%S" object="%ANY" weight="1"/>
    <condition expression="countRelationshipInstances(%S,'candidate band ordinal',*) is greater than or equal to 1"
               alt="The concept falls in at least one sequencing band" weight="1"/>
    <condition expression="maxObjects(%S,'candidate band ordinal',*)" value="%O"
               alt="The most specific band this concept falls in is band {{%O}}"/>
  </relinst>

  <relinst type="has sequence band"
           name="RF-3.6 exactly one sequencing band per concept [DGCS.1]" cf="100"
           alt="The sequencing band is {{%O}}">
    <condition rel="selected band ordinal" subject="%S" object="%WIN"/>
    <condition rel="candidate sequence band" subject="%S" object="%O"/>
    <condition rel="band ordinal" subject="%O" object="%WIN"/>
  </relinst>

  <!-- Within band ordering is by first source span offset. One arithmetic
       operator per expression, per the build rule. -->
  <relinst type="icd band scaled"
           name="RF-3.6 scale the band ordinal [DGCS.1]" cf="100">
    <condition rel="has sequence band" subject="%S" object="%BAND"/>
    <condition rel="band ordinal" subject="%BAND" object="%B"/>
    <condition expression="%B * 1000" value="%O" alt="Band {{%BAND}} scales to {{%O}}"/>
  </relinst>

  <relinst type="icd sequence number"
           name="RF-3.6 secondary sequence number is band then span offset [DGCS.1]" cf="100">
    <condition rel="icd band scaled" subject="%S" object="%BASE"/>
    <condition rel="has span start offset" subject="%S" object="%OFF"/>
    <condition expression="%BASE + %OFF" value="%O" alt="The sequence position is {{%O}}"/>
  </relinst>

  <!-- G2 returns ordered concepts with their sequence band, so the ordering
       has to be queryable at case level, not merely held per concept. The entry
       embeds the position, the concept, its role and its band, so a caller can
       sort on the position without a second round trip. -->
  <!-- R-E-7 requires the band to be recorded on the fact so the coder can see
       why an order was chosen. That is one entry per concept CARRYING the band,
       not a second parallel entry: two rules concluding this relationship with
       overlapping gates listed every banded concept twice, once with the band
       and once without, which a consumer reading the sequence would double
       count. The gates are therefore disjoint on whether a band exists, and the
       banded rule uses the concept's actual role rather than assuming secondary.
       Primaries carry no band, so between them the two rules cover every
       sequenced concept exactly once. -->
  <relinst type="has icd sequence entry"
           name="RF-3.6 the ordered ICD sequence for the case [DGCS.1]" cf="100"
           alt="Position {{%ORD}} of the ICD sequence is {{%C}}">
    <condition rel="has clinical concept" subject="%S" object="%C"/>
    <condition rel="icd sequence number" subject="%C" object="%ORD"/>
    <condition rel="has diagnosis role" subject="%C" object="%ROLE"/>
    <condition expression="countRelationshipInstances(%C,'has sequence band',*) is equal to 0"
               alt="The concept falls in no sequencing band"/>
    <condition expression="'ICD;' + %ORD + ';' + %C + ';' + %ROLE" value="%O"
               alt="Sequence entry {{%O}}"/>
  </relinst>

  <relinst type="has icd sequence entry"
           name="RF-3.6 the ordered ICD sequence carries the band [DGCS.1]" cf="100"
           alt="Position {{%ORD}} of the ICD sequence is {{%C}} in band {{%BAND}}">
    <condition rel="has clinical concept" subject="%S" object="%C"/>
    <condition rel="icd sequence number" subject="%C" object="%ORD"/>
    <condition rel="has diagnosis role" subject="%C" object="%ROLE"/>
    <condition rel="has sequence band" subject="%C" object="%BAND"/>
    <condition expression="'ICD;' + %ORD + ';' + %C + ';' + %ROLE" value="%HEAD"
               alt="Sequence entry {{%HEAD}}"/>
    <condition expression="%HEAD + ';' + %BAND" value="%O"
               alt="Sequence entry {{%O}}"/>
  </relinst>

  <!-- ============ RF-4  LOCAL ICD-10 POLICY ============ -->

  <!-- RF-4.1. Local guidance says patients on long term anticoagulants
       must ALWAYS be coded Z92.1. Always makes this unconditional on
       episode relevance, an intentional exception to DGCS.3. -->
  <relinst type="has tentative code" object="ICD-10:Z92.1"
           name="RF-4.1 long term anticoagulant use is always coded [LOCAL-ICD-ANTICOAG-1]" cf="100"
           alt="The patient is documented on {{%DRUG}}, an approved anticoagulant, so Z92.1 is always assigned">
    <condition rel="has clinical concept" subject="%S" object="%C"/>
    <condition rel="has kind" subject="%C" object="MEDICATION_USE"/>
    <condition rel="names drug" subject="%C" object="%DRUG"/>
    <condition rel="is approved anticoagulant" subject="%DRUG" object="true"/>
    <condition rel="documents long term or current use" subject="%C" object="true"/>
    <condition rel="appears in field" subject="%C" object="%FIELD"/>
    <condition rel="field permits anticoagulant policy" subject="%FIELD" object="true"/>
  </relinst>

  <!-- RF-4.2 NEGATIVE. An unlisted anticoagulant raises an ambiguity and
       must NOT produce Z92.1. The list is closed at six entries and an
       agent must not extend it. -->
  <!-- RF-4.2 support. Projects the two hop test approved drug named onto
       the concept as a flag, so the ambiguity can count it with an
       unfiltered count. A count cannot traverse two hops, and counting
       names drug alone is what made an unlisted drug name suppress the
       ambiguity it should raise. -->
  <relinst type="names approved anticoagulant" object="true"
           name="RF-4.2 project whether the concept names an approved anticoagulant [LOCAL-ICD-ANTICOAG-1]" cf="100"
           alt="The concept names {{%DRUG}}, which is on the approved local anticoagulant list">
    <condition rel="names drug" subject="%S" object="%DRUG"/>
    <condition rel="is approved anticoagulant" subject="%DRUG" object="true"/>
  </relinst>

  <relinst type="has ambiguity" object="UNLISTED_ANTICOAGULANT"
           name="RF-4.2 anticoagulant outside the approved list raises an ambiguity [LOCAL-ICD-ANTICOAG-1]" cf="100"
           alt="The report describes an anticoagulant that is not on the approved local list">
    <condition rel="has clinical concept" subject="%S" object="%C"/>
    <condition rel="has kind" subject="%C" object="MEDICATION_USE"/>
    <condition rel="is described as anticoagulant" subject="%C" object="true"/>
    <condition expression="countRelationshipInstances(%C,'names approved anticoagulant',*) is equal to 0"
               alt="No approved anticoagulant was named, so the drug is outside the local list"/>
  </relinst>

  <relinst type="has tentative code" object="ICD-10:Z80.0"
           name="RF-4.3 family history of colorectal cancer is coded [LOCAL-ICD-SCREEN-2]" cf="100"
           alt="The report documents a family history of colorectal cancer">
    <condition rel="has clinical concept" subject="%S" object="%C"/>
    <condition rel="has kind" subject="%C" object="FAMILY_HISTORY_ITEM"/>
    <condition rel="concerns colorectal cancer" subject="%C" object="true"/>
  </relinst>

  <relinst type="has neoplasm diagnosis concept"
           name="RF-4 project neoplasm diagnoses onto the case [LOCAL-ICD-SCREEN-1]" cf="100">
    <condition rel="has clinical concept" subject="%S" object="%O"/>
    <condition rel="has kind" subject="%O" object="DIAGNOSIS"/>
    <condition rel="has neoplasm nature" subject="%O" object="true"/>
  </relinst>

  <relinst type="has treated codeable concept"
           name="RF-4 project treated codeable concepts onto the case [LOCAL-ICD-SCREEN-1]" cf="100">
    <condition rel="has clinical concept" subject="%S" object="%O"/>
    <condition rel="has disposition" subject="%O" object="CODEABLE_CURRENT"/>
    <condition rel="has episode relevance" subject="%O" object="TREATED"/>
  </relinst>

  <!-- RF-4.4, resolving X-6b, a contradiction inside the source itself.
       R-F-5 states RF-4.4 is gated on BOTH no neoplasm and nothing treated,
       yet R-F-7 makes RF-4.6 DEMOTE Z12.1 when something was treated. Those
       cannot both hold: the treated gate means Z12.1 never exists in the very
       case RF-4.6 exists to re-rank, so RF-4.6 is dead code and WE-22's
       expected output is unreachable, which structural assertion 12 makes a
       build failure.

       Resolution, and it follows the source's own division of labour in R-F-8,
       one rule asserts, one suppresses, one re-ranks: a gate on the ASSERTION
       is right where the consequence is total, so the neoplasm gate stays
       (belt and braces with RF-4.5, which suppresses on the same ground and is
       what carries the reason text). The treated case is a RE-RANK, not a
       suppression, so the code must be asserted for RF-4.6 to have something to
       demote. The treated gate is therefore removed from the assertion and the
       work is done by RF-4.6 below. Net behaviour: nothing treated gives Z12.1
       primary and undemoted, WE-20; a neoplasm suppresses it outright, WE-21;
       a treated finding demotes it to position 9000, WE-22. -->
  <relinst type="has tentative code" object="ICD-10:Z12.1"
           name="RF-4.4 screening colonoscopy takes the screening code [LOCAL-ICD-SCREEN-1]" cf="100"
           alt="A screening colonoscopy for a family history of colorectal cancer takes the screening code">
    <condition rel="has procedure event" subject="%S" object="%E" weight="1"/>
    <condition rel="has procedure type" subject="%E" object="COLONOSCOPY"/>
    <condition rel="has screening context" subject="%S" object="FAMILY_HISTORY_CRC"/>
  </relinst>

  <!-- RF-4.5 NEGATIVE. A malignancy invalidates the screening code
       entirely, where RF-4.6 merely demotes it. That asymmetry is the
       source's, and both vectors are constructed rather than source keyed. -->
  <relinst type="is suppressed in case" object="true"
           name="RF-4.5 malignancy found suppresses the screening code [LOCAL-ICD-SCREEN-1]" cf="100"
           alt="A malignancy was found so the screening code no longer applies">
    <condition rel="is tentative in case" subject="%S" object="%CASE"/>
    <condition rel="code is screening code" subject="%S" object="true"/>
    <condition expression="countRelationshipInstances(%CASE,'has neoplasm diagnosis concept',*) is greater than or equal to 1"
               alt="The case has a diagnosis with a neoplasm nature"/>
  </relinst>

  <relinst type="suppression reason"
           name="RF-4.5 reason the screening code was suppressed [LOCAL-ICD-SCREEN-1]" cf="100">
    <condition rel="is tentative in case" subject="%S" object="%CASE"/>
    <condition rel="code is screening code" subject="%S" object="true"/>
    <condition expression="countRelationshipInstances(%CASE,'has neoplasm diagnosis concept',*) is greater than or equal to 1"
               alt="The case has a diagnosis with a neoplasm nature"/>
    <condition expression="'RF-4.5;Malignancy found so the screening code is no longer applicable'" value="%O"/>
  </relinst>

  <relinst type="is primary diagnosis candidate" object="true"
           name="RF-4.6 treated incidental finding during screening becomes primary [LOCAL-ICD-SCREEN-1]" cf="100"
           alt="A finding treated during a screening examination outranks the screening code">
    <condition rel="belongs to case" subject="%S" object="%CASE"/>
    <condition rel="has screening context" subject="%CASE" object="FAMILY_HISTORY_CRC"/>
    <condition rel="has disposition" subject="%S" object="CODEABLE_CURRENT"/>
    <condition rel="has episode relevance" subject="%S" object="TREATED"/>
  </relinst>

  <relinst type="is demoted from primary" object="true"
           name="RF-4.6 screening code is demoted when a finding was treated [LOCAL-ICD-SCREEN-1]" cf="100"
           alt="The screening code is demoted below the treated finding">
    <condition rel="is tentative in case" subject="%S" object="%CASE"/>
    <condition rel="code is screening code" subject="%S" object="true"/>
    <condition expression="countRelationshipInstances(%CASE,'has treated codeable concept',*) is greater than or equal to 1"
               alt="Something was treated during the screening examination"/>
  </relinst>

  <!-- The ordered ICD code list. Distinct from the concept sequence above:
       the RF-4 policy codes attach to the CASE, not to a clinical concept, so
       they have no concept ordinal. A suppressed code (RF-4.5) is excluded
       outright; a demoted one (RF-4.6) is pushed to position 9000, below every
       band, which is exactly the RF-4.5 versus RF-4.6 asymmetry the source
       states and X-6 records. -->
  <relinst type="has icd code entry"
           name="RF-4 an undemoted policy code keeps its role position [LOCAL-ICD-SCREEN-1]" cf="100"
           alt="ICD code {{%C}} takes its documented role position">
    <condition rel="has tentative code" subject="%S" object="%C"/>
    <condition rel="has classification" subject="%C" object="ICD-10"/>
    <condition rel="has code role" subject="%C" object="%ROLE"/>
    <condition expression="countRelationshipInstances(%C,'is suppressed in case',*) is equal to 0"
               alt="The code was not suppressed by RF-4.5"/>
    <condition expression="countRelationshipInstances(%C,'is demoted from primary',*) is equal to 0"
               alt="The code was not demoted by RF-4.6"/>
    <condition expression="'ICD;' + %C + ';' + %ROLE + ';NOT_DEMOTED'" value="%O"
               alt="ICD code entry {{%O}}"/>
  </relinst>

  <relinst type="has icd code entry"
           name="RF-4.6 a demoted screening code sorts below every band [LOCAL-ICD-SCREEN-1]" cf="100"
           alt="ICD code {{%C}} was demoted so it sorts last">
    <condition rel="has tentative code" subject="%S" object="%C"/>
    <condition rel="has classification" subject="%C" object="ICD-10"/>
    <condition rel="is demoted from primary" subject="%C" object="true"/>
    <condition expression="countRelationshipInstances(%C,'is suppressed in case',*) is equal to 0"
               alt="The code was not also suppressed by RF-4.5"/>
    <condition expression="'ICD;9000;' + %C + ';SECONDARY_DIAGNOSIS;DEMOTED'" value="%O"
               alt="ICD code entry {{%O}}"/>
  </relinst>

  <!-- ================================================================
       L5  RF-5.1 and RF-7.2 to RF-7.5  EFFECTIVE PROCEDURE
       These run before pattern selection because they change what the
       procedure IS. Hot biopsy is the clearest case: it is not a biopsy.
       ================================================================ -->

  <!-- RF-5.1 PGCS10 fibreoptic default, applied by the map and visible in
       the evidence tree rather than assumed at extraction time. Reversible
       by re-injection of an actual modality. -->
  <relinst type="has effective scope modality" object="FIBREOPTIC"
           name="RF-5.1 unstated scope modality defaults to fibreoptic [PGCS10]" cf="100"
           alt="The report does not state the scope type so the fibreoptic default applies">
    <condition rel="has scope modality" subject="%S" object="UNSTATED"/>
    <condition rel="has procedure type" subject="%S" object="%PT"/>
    <condition rel="procedure type is rigid" subject="%PT" object="false"/>
  </relinst>

  <relinst type="has effective scope modality"
           name="RF-5.1 a stated scope modality is used as documented [PGCS10]" cf="100"
           alt="The report states the scope modality as {{%O}}">
    <condition rel="has scope modality" subject="%S" object="%O"/>
    <condition expression="%O is not equal to 'UNSTATED'" alt="The scope modality is documented"/>
  </relinst>

  <!-- RF-5.1 second limb. A rigid procedure type keeps RIGID even when the
       modality field is blank, which is what makes WE-14 correct. -->
  <relinst type="has effective scope modality" object="RIGID"
           name="RF-5.1 rigid procedure type is never defaulted to fibreoptic [PGCS10]" cf="100"
           alt="The procedure type {{%PT}} is a rigid instrument procedure">
    <condition rel="has scope modality" subject="%S" object="UNSTATED"/>
    <condition rel="has procedure type" subject="%S" object="%PT"/>
    <condition rel="procedure type is rigid" subject="%PT" object="true"/>
  </relinst>

  <!-- RF-7.2. Hot biopsy is NOT a biopsy: local guidance says code it as a
       cauterisation of lesion. Getting this wrong changes the entire code
       set and the naming actively misleads. -->
  <relinst type="has effective intent" object="THERAPEUTIC"
           name="RF-7.2 hot biopsy is a therapeutic cauterisation [LOCAL-METHOD-HOTBX-1]" cf="100"
           alt="A hot biopsy is coded as a cauterisation of lesion, not as a biopsy">
    <condition rel="has sampling act" subject="%S" object="HOT_BIOPSY"/>
  </relinst>

  <relinst type="has effective method" object="CAUTERISATION"
           name="RF-7.2 hot biopsy maps to cauterisation [LOCAL-METHOD-HOTBX-1]" cf="100"
           alt="The hot biopsy is coded as a cauterisation of lesion">
    <condition rel="has sampling act" subject="%S" object="HOT_BIOPSY"/>
  </relinst>

  <relinst type="is a biopsy for coding" object="false"
           name="RF-7.2 hot biopsy is not a biopsy for coding [LOCAL-METHOD-HOTBX-1]" cf="100"
           alt="A hot biopsy does not earn a biopsy code">
    <condition rel="has sampling act" subject="%S" object="HOT_BIOPSY"/>
  </relinst>

  <!-- RF-7.3 and RF-7.4. Cold biopsy is a biopsy UNLESS the report states
       removal, resection or excision, in which case it is an excision.
       states removal is asserted only on those three documented verbs with
       a quoted span, never paraphrased. -->
  <relinst type="is a biopsy for coding" object="true"
           name="RF-7.3 cold biopsy without documented removal is a biopsy [LOCAL-METHOD-COLDBX-1]" cf="100"
           alt="The report describes a cold biopsy and does not state that the lesion was removed">
    <condition rel="has sampling act" subject="%S" object="COLD_BIOPSY"/>
    <condition rel="states removal" subject="%S" object="false"/>
  </relinst>

  <relinst type="has effective intent" object="DIAGNOSTIC"
           name="RF-7.3 cold biopsy without removal stays diagnostic [LOCAL-METHOD-COLDBX-1]" cf="100"
           alt="The cold biopsy is diagnostic">
    <condition rel="has sampling act" subject="%S" object="COLD_BIOPSY"/>
    <condition rel="states removal" subject="%S" object="false"/>
  </relinst>

  <relinst type="has effective intent" object="THERAPEUTIC"
           name="RF-7.4 cold biopsy with documented removal is therapeutic [LOCAL-METHOD-COLDBX-2]" cf="100"
           alt="The report states the lesion was removed with the cold biopsy">
    <condition rel="has sampling act" subject="%S" object="COLD_BIOPSY"/>
    <condition rel="states removal" subject="%S" object="true"/>
  </relinst>

  <relinst type="has effective method" object="COLD_EXCISION"
           name="RF-7.4 cold biopsy removal maps to an excision [LOCAL-METHOD-COLDBX-2]" cf="100"
           alt="A cold biopsy that removed the lesion is coded as a resection">
    <condition rel="has sampling act" subject="%S" object="COLD_BIOPSY"/>
    <condition rel="states removal" subject="%S" object="true"/>
  </relinst>

  <relinst type="is a biopsy for coding" object="false"
           name="RF-7.4 cold biopsy removal is not a biopsy for coding [LOCAL-METHOD-COLDBX-2]" cf="100"
           alt="The cold biopsy became an excision so it does not also earn a biopsy code">
    <condition rel="has sampling act" subject="%S" object="COLD_BIOPSY"/>
    <condition rel="states removal" subject="%S" object="true"/>
  </relinst>

  <!-- RF-7.5. A CLO test is a biopsy of the stomach. Asserting the site
       lets RF-6.2 do the work: OGD plus CLO gives Z27.2, but adding a
       duodenal biopsy gives Z27.4 because the duodenum is the furthest
       point biopsied and REPLACES the stomach. -->
  <relinst type="is a biopsy for coding" object="true"
           name="RF-7.5 a CLO test is a biopsy [LOCAL-METHOD-CLO-1]" cf="100"
           alt="A CLO test is a biopsy of the stomach">
    <condition rel="has sampling act" subject="%S" object="CLO_TEST"/>
  </relinst>

  <relinst type="has biopsy site" object="Stomach"
           name="RF-7.5 a CLO test is a biopsy of the stomach [LOCAL-METHOD-CLO-1]" cf="100"
           alt="The CLO test samples the stomach">
    <condition rel="has sampling act" subject="%S" object="CLO_TEST"/>
  </relinst>

  <!-- Cold biopsy is excluded here because RF-7.3 and RF-7.4 decide it: a
       documented removal turns it into an excision, so it must not be given
       a biopsy code by the generic rule. -->
  <relinst type="is a biopsy for coding" object="true"
           name="RF-5.5 a documented diagnostic sampling act is a biopsy [PGCS10]" cf="100"
           alt="The sampling act {{%ACT}} is a diagnostic biopsy">
    <condition rel="has sampling act" subject="%S" object="%ACT"/>
    <condition rel="sampling is diagnostic biopsy" subject="%ACT" object="true"/>
    <condition expression="countRelationshipInstances(%ACT,'sampling overrides documented intent',*) is equal to 0"
               alt="The sampling act does not reclassify the event"/>
  </relinst>

  <!-- RF-5.4 NEGATIVE, the other half of the RF-5.5 table. An act the table
       marks false earns NO biopsy code, and the status must be CONCLUDED rather
       than merely absent, because the diagnostic mapping lookup is keyed on it.
       BRUSHING and NO_SAMPLING reach this rule. -->
  <relinst type="is a biopsy for coding" object="false"
           name="RF-5.4 a sampling act the policy excludes is not a biopsy [PGCS10]" cf="100"
           alt="The sampling act {{%ACT}} does not earn a biopsy code">
    <condition rel="has sampling act" subject="%S" object="%ACT"/>
    <condition rel="sampling is diagnostic biopsy" subject="%ACT" object="false"/>
    <condition expression="countRelationshipInstances(%ACT,'sampling overrides documented intent',*) is equal to 0"
               alt="The sampling act does not reclassify the event"/>
  </relinst>

  <!-- The biopsy site defaults to the site the event concerns; the CLO
       rule above overrides it for a stomach sample. -->
  <relinst type="has biopsy site"
           name="RF-5.5 biopsy site is the site the event concerns [PGCS10]" cf="100"
           alt="The biopsy was taken from {{%O}}">
    <condition rel="is a biopsy for coding" subject="%S" object="true"/>
    <condition rel="concerns procedure site" subject="%S" object="%O"/>
  </relinst>

  <!-- Effective intent and method fall back to what was documented, unless a
       sampling act reclassified the event. -->
  <relinst type="has intent override" object="true"
           name="RF-7.2 to RF-7.4 mark an event whose sampling act reclassifies it [LOCAL-METHOD-HOTBX-1]" cf="100"
           alt="The sampling act {{%ACT}} reclassifies this event so the documented intent is not used">
    <condition rel="has sampling act" subject="%S" object="%ACT"/>
    <condition rel="sampling overrides documented intent" subject="%ACT" object="true"/>
  </relinst>

  <!-- The override test reads the ground reference table through the bound
       sampling act rather than counting the derived override flag: a count
       filtered to a literal object does not drive derivation of the
       relationship it counts, so counting the flag would silently see zero. -->
  <relinst type="has effective intent"
           name="RF-5 effective intent defaults to the documented intent [PGCS10]" cf="100"
           alt="The documented intent is {{%O}}">
    <condition rel="has documented intent" subject="%S" object="%O"/>
    <condition rel="has sampling act" subject="%S" object="%ACT"/>
    <condition expression="countRelationshipInstances(%ACT,'sampling overrides documented intent',*) is equal to 0"
               alt="The sampling act {{%ACT}} does not reclassify this event"/>
  </relinst>

  <relinst type="has effective method"
           name="RF-5 effective method defaults to the documented method [PGCS10]" cf="100"
           alt="The documented therapeutic method is {{%O}}">
    <condition rel="has therapeutic method" subject="%S" object="%O"/>
    <condition rel="has sampling act" subject="%S" object="%ACT"/>
    <condition expression="countRelationshipInstances(%ACT,'sampling overrides documented intent',*) is equal to 0"
               alt="The sampling act {{%ACT}} does not reclassify this event"/>
  </relinst>

  <relinst type="is therapeutic event" object="true"
           name="RF-5 mark a therapeutic event [PGCS10]" cf="100"
           alt="The event is therapeutic">
    <condition rel="has effective intent" subject="%S" object="THERAPEUTIC"/>
  </relinst>

  <!-- Case level projections used by the RF-5 counting rules. -->
  <relinst type="therapeutic method used"
           name="RF-5 project therapeutic methods onto the case [PGCS10]" cf="100">
    <condition rel="has procedure event" subject="%S" object="%E"/>
    <condition rel="is therapeutic event" subject="%E" object="true"/>
    <condition rel="has effective method" subject="%E" object="%O"/>
  </relinst>

  <relinst type="therapeutic site used"
           name="RF-5 project therapeutic sites onto the case [PGCS10]" cf="100">
    <condition rel="has procedure event" subject="%S" object="%E"/>
    <condition rel="is therapeutic event" subject="%E" object="true"/>
    <condition rel="concerns procedure site" subject="%E" object="%O"/>
  </relinst>

  <relinst type="excision site"
           name="RF-5.8 project excision sites onto the case [PGCS10]" cf="100">
    <condition rel="has procedure event" subject="%S" object="%E"/>
    <condition rel="is therapeutic event" subject="%E" object="true"/>
    <condition rel="has effective method" subject="%E" object="%M"/>
    <condition rel="method is excisional" subject="%M" object="true"/>
    <condition rel="concerns procedure site" subject="%E" object="%O"/>
  </relinst>

  <relinst type="biopsied site"
           name="RF-6.2 project biopsied sites onto the case [PGCS10]" cf="100">
    <condition rel="has procedure event" subject="%S" object="%E"/>
    <condition rel="is a biopsy for coding" subject="%E" object="true"/>
    <condition rel="has biopsy site" subject="%E" object="%O"/>
  </relinst>

  <relinst type="examined site"
           name="RF-6.1 project examined sites onto the case [PGCS10]" cf="100">
    <condition rel="has procedure event" subject="%S" object="%E"/>
    <condition rel="concerns procedure site" subject="%E" object="%O"/>
  </relinst>

  <relinst type="examined site"
           name="RF-6.1 the documented extent of examination is an examined site [PGCS10]" cf="100">
    <condition rel="has extent site" subject="%S" object="%O"/>
  </relinst>

  <relinst type="has biopsy event"
           name="RF-5 project biopsy events onto the case [PGCS10]" cf="100">
    <condition rel="has procedure event" subject="%S" object="%O"/>
    <condition rel="is a biopsy for coding" subject="%O" object="true"/>
  </relinst>

  <!-- ================================================================
       L5b  RF-9 driven lookup instructions, the G5 retrieval work order
       Built from normalised terms only. No patient identifier, no report
       text and no source span may appear here, because this is the one
       surface that leaves the controlled environment.
       ================================================================ -->

  <relinst type="requires lookup instruction"
           name="G5 codeable diagnosis needs an index lookup [DGCS.1]" cf="100">
    <condition rel="has disposition" subject="%S" object="CODEABLE_CURRENT"/>
    <condition rel="has kind" subject="%S" object="DIAGNOSIS"/>
    <condition rel="has normalised term" subject="%S" object="%TERM"/>
    <condition rel="has diagnosis role" subject="%S" object="%ROLE"/>
    <condition expression="'Alphabetical;' + %TERM + ';;' + %ROLE + ';Diagnosis requires an index trail and a tabular record'" value="%O"/>
  </relinst>

  <relinst type="requires lookup instruction"
           name="G5 symptom coded as primary needs an index lookup [DGCS.1ii]" cf="100">
    <condition rel="is primary diagnosis candidate" subject="%S" object="true"/>
    <condition rel="has kind" subject="%S" object="%KIND"/>
    <condition rel="kind is symptom like" subject="%KIND" object="true"/>
    <condition rel="has normalised term" subject="%S" object="%TERM"/>
    <condition expression="'Alphabetical;' + %TERM + ';;PRIMARY_DIAGNOSIS;Indication coded because no diagnosis was made'" value="%O"/>
  </relinst>

  <!-- ================================================================
       L6  RF-5.2 and RF-5.3  PGCS2 ABSORPTION
       ================================================================ -->

  <relinst type="has therapeutic event"
           name="RF-5 project therapeutic events onto the case [PGCS10]" cf="100">
    <condition rel="has procedure event" subject="%S" object="%O"/>
    <condition rel="is therapeutic event" subject="%O" object="true"/>
  </relinst>

  <!-- RF-5.2 PGCS2. If a diagnostic procedure proceeds to, or is performed
       at the same time as, a therapeutic procedure on the same site, only
       the therapeutic code is required. -->
  <relinst type="is absorbed by"
           name="RF-5.2 diagnostic event on the same site is absorbed by the therapeutic event [PGCS2]" cf="100"
           alt="A therapeutic procedure was performed at the same site so only the therapeutic code is required">
    <condition rel="has effective intent" subject="%S" object="DIAGNOSTIC"/>
    <condition rel="concerns procedure site" subject="%S" object="%SITE"/>
    <condition rel="event belongs to case" subject="%S" object="%CASE"/>
    <condition rel="has procedure event" subject="%CASE" object="%O"/>
    <condition rel="is therapeutic event" subject="%O" object="true"/>
    <condition rel="concerns procedure site" subject="%O" object="%SITE"/>
  </relinst>

  <relinst type="has event disposition" object="SUPPRESS_DIAGNOSTIC_CODE"
           name="RF-5.2 absorbed diagnostic event is suppressed [PGCS2]" cf="100"
           alt="The diagnostic code is absorbed by the therapeutic procedure at the same site">
    <condition rel="is absorbed by" subject="%S" object="%T"/>
  </relinst>

  <!-- RF-5.3. PGCS2's exception space. The model refuses to guess: it
       raises an ambiguity and caps at 85 so the case cannot be EXPEDITED. -->
  <relinst type="has ambiguity" object="DIAGNOSTIC_THERAPEUTIC_DIFFERENT_SITES"
           name="RF-5.3 diagnostic and therapeutic on different sites raises an ambiguity [PGCS2]" cf="85"
           alt="A diagnostic procedure at {{%S1}} accompanies a therapeutic procedure at {{%S2}}, outside PGCS2">
    <condition rel="has procedure event" subject="%S" object="%D"/>
    <condition rel="has effective intent" subject="%D" object="DIAGNOSTIC"/>
    <condition rel="concerns procedure site" subject="%D" object="%S1"/>
    <condition rel="has procedure event" subject="%S" object="%T"/>
    <condition rel="is therapeutic event" subject="%T" object="true"/>
    <condition rel="concerns procedure site" subject="%T" object="%S2"/>
    <condition expression="%S1 is not equal to %S2" alt="The two procedures concern different sites"/>
  </relinst>

  <relinst type="candidate review tier" object="FULL"
           name="RF-5.3 different site diagnostic and therapeutic needs full review [PGCS2]" cf="85"
           alt="The PGCS2 exception space requires full coder review">
    <condition rel="has ambiguity" subject="%S" object="DIAGNOSTIC_THERAPEUTIC_DIFFERENT_SITES"/>
  </relinst>

  <relinst type="certainty cap" object="85"
           name="RF-5.3 cap certainty at 85 [PGCS2]" cf="100"
           alt="The PGCS2 exception space caps certainty below the expedited threshold">
    <condition rel="has ambiguity" subject="%S" object="DIAGNOSTIC_THERAPEUTIC_DIFFERENT_SITES"/>
  </relinst>

  <!-- ================================================================
       L7  RF-5.4 to RF-5.9  THE PROCEDURE PATTERN LADDER
       Candidates are asserted freely and the minimum priority wins, which
       is how RF-5.6b is evaluated before RF-5.6 as R-G-9 requires.
       ================================================================ -->

  <relinst type="candidate pattern" object="DIAGNOSTIC_ONLY"
           name="RF-5.4 diagnostic examination with no sampling [PGCS10]" cf="100"
           alt="A single diagnostic examination with no sampling was performed">
    <condition rel="has procedure event" subject="%S" object="%E" weight="1"/>
    <condition rel="has effective intent" subject="%E" object="DIAGNOSTIC"/>
    <condition rel="has sampling act" subject="%E" object="NO_SAMPLING"/>
    <condition expression="countRelationshipInstances(%S,'has procedure event',*) is equal to 1"
               alt="The case has exactly one procedure event"/>
  </relinst>

  <relinst type="candidate pattern" object="DIAGNOSTIC_WITH_BIOPSY"
           name="RF-5.5 diagnostic examination with a biopsy and no therapy [PGCS10]" cf="100"
           alt="A diagnostic examination with sampling and no therapeutic procedure">
    <condition rel="has biopsy event" subject="%S" object="%E" weight="1"/>
    <condition expression="countRelationshipInstances(%S,'has biopsy event',*) is greater than or equal to 1"
               alt="At least one biopsy for coding purposes was taken"/>
    <condition expression="countRelationshipInstances(%S,'has therapeutic event',*) is equal to 0"
               alt="No therapeutic procedure was performed"/>
  </relinst>

  <relinst type="candidate pattern" object="THERAPEUTIC_SAME_SITE"
           name="RF-5.6 single therapeutic method on a single site [PGCS10]" cf="100"
           alt="One therapeutic method was used at one site">
    <condition rel="has therapeutic event" subject="%S" object="%E" weight="1"/>
    <condition expression="countRelationshipInstances(%S,'has therapeutic event',*) is equal to 1"
               alt="The case has exactly one therapeutic event"/>
    <condition expression="countRelationshipInstances(%S,'therapeutic method used',*) is equal to 1"
               alt="Exactly one distinct therapeutic method was used"/>
    <condition expression="countRelationshipInstances(%S,'therapeutic site used',*) is equal to 1"
               alt="All therapeutic procedures were at the same site"/>
  </relinst>

  <!-- RF-5.6b. Outranks RF-5.6 at priority 30 so a different site biopsy
       wins. Without it WE-04 and WE-17 fall through to the RF-5.9 hard stop. -->
  <relinst type="has different site biopsy" object="true"
           name="RF-5.6b detect a biopsy at a site other than the therapeutic site [PGCS10]" cf="100"
           alt="A biopsy was taken at {{%BS}} while the therapeutic procedure was at {{%TS}}">
    <condition rel="has biopsy event" subject="%S" object="%B"/>
    <condition rel="has biopsy site" subject="%B" object="%BS"/>
    <condition rel="has therapeutic event" subject="%S" object="%T"/>
    <condition rel="concerns procedure site" subject="%T" object="%TS"/>
    <condition expression="%BS is not equal to %TS" alt="The biopsy site differs from the therapeutic site"/>
  </relinst>

  <relinst type="candidate pattern" object="THERAPEUTIC_DIFFERENT_SITE_BIOPSY"
           name="RF-5.6b single therapeutic method with a biopsy elsewhere [PGCS10]" cf="100"
           alt="One therapeutic method was used and a biopsy was taken at a different site">
    <condition rel="has therapeutic event" subject="%S" object="%E" weight="1"/>
    <condition rel="has different site biopsy" subject="%S" object="true"/>
    <condition expression="countRelationshipInstances(%S,'has therapeutic event',*) is equal to 1"
               alt="The case has exactly one therapeutic event"/>
    <condition expression="countRelationshipInstances(%S,'therapeutic method used',*) is equal to 1"
               alt="Exactly one distinct therapeutic method was used"/>
  </relinst>

  <!-- RF-5.7. Where multiple therapeutic methods are used, a body system
       code for each method must be assigned followed by the site codes. -->
  <relinst type="candidate pattern" object="MULTI_METHOD"
           name="RF-5.7 more than one distinct therapeutic method [PGCS10]" cf="100"
           alt="{{%N}} distinct therapeutic methods were used during the procedure">
    <condition rel="therapeutic method used" subject="%S" object="%M" weight="1"/>
    <condition expression="countRelationshipInstances(%S,'therapeutic method used',*)" value="%N"
               alt="The case used {{%N}} distinct therapeutic methods"/>
    <condition expression="%N is greater than 1" alt="More than one distinct therapeutic method was used"/>
  </relinst>

  <!-- RF-5.8. Where multiple excisions using the same method have been
       performed, site codes must be assigned for each site of excision. -->
  <relinst type="candidate pattern" object="MULTI_SITE_SINGLE_METHOD"
           name="RF-5.8 one excisional method used at several sites [PGCS10]" cf="100"
           alt="One excisional method was used at {{%N}} distinct sites">
    <condition rel="excision site" subject="%S" object="%SITE" weight="1"/>
    <condition expression="countRelationshipInstances(%S,'therapeutic method used',*) is equal to 1"
               alt="Exactly one distinct therapeutic method was used"/>
    <condition expression="countRelationshipInstances(%S,'excision site',*)" value="%N"
               alt="The method was excisional and was used at {{%N}} distinct sites"/>
    <condition expression="%N is greater than 1" alt="More than one distinct site was excised"/>
  </relinst>

  <!-- RF-5.9 HARD STOP. Priority 999 so it only wins when nothing else
       matched. It is asserted unconditionally on any case with an event and
       loses the ladder whenever a real pattern was concluded. -->
  <relinst type="candidate pattern" object="CLARIFICATION_REQUIRED"
           name="RF-5.9 fallback pattern when no composition rule matched [PGCS10]" cf="100"
           alt="The procedure composition could not be resolved by any RF-5 rule">
    <condition rel="has procedure event" subject="%S" object="%E"/>
  </relinst>

  <relinst type="candidate pattern priority"
           name="RF-5 ladder join candidate pattern to its priority" cf="100">
    <condition rel="candidate pattern" subject="%S" object="%P"/>
    <condition rel="pattern selection priority" subject="%P" object="%O"/>
  </relinst>

  <relinst type="selected pattern priority"
           name="RF-5 ladder select the highest ranking pattern" cf="100">
    <condition rel="candidate pattern" subject="%S" object="%ANY" weight="1"/>
    <condition expression="countRelationshipInstances(%S,'candidate pattern priority',*) is greater than or equal to 1"
               alt="The case has at least one candidate procedure pattern" weight="1"/>
    <condition expression="minObjects(%S,'candidate pattern priority',*)" value="%O"
               alt="The highest ranking pattern has priority {{%O}}"/>
  </relinst>

  <relinst type="has procedure pattern"
           name="RF-5 the case takes exactly one procedure pattern [PGCS10]" cf="100"
           alt="The procedure pattern is {{%O}}">
    <condition rel="selected pattern priority" subject="%S" object="%WIN"/>
    <condition rel="candidate pattern" subject="%S" object="%O"/>
    <condition rel="pattern selection priority" subject="%O" object="%WIN"/>
  </relinst>

  <relinst type="has hard stop" object="PROCEDURE_PATTERN_UNRESOLVED"
           name="RF-5.9 unresolved procedure composition is a hard stop [PGCS10]" cf="100"
           alt="No RF-5 composition rule matched this procedure so a coder must resolve it">
    <condition rel="has procedure pattern" subject="%S" object="CLARIFICATION_REQUIRED"/>
  </relinst>

  <!-- ================================================================
       L8  RF-6  SITE STRATEGY LADDER
       ================================================================ -->

  <relinst type="candidate site strategy" object="FURTHEST_SITE_EXAMINED"
           name="RF-5.4 diagnostic only takes the furthest site examined [PGCS10]" cf="100"
           alt="A diagnostic examination is sited by the furthest point examined">
    <condition rel="has procedure pattern" subject="%S" object="DIAGNOSTIC_ONLY"/>
  </relinst>

  <!-- RF-5.5 and R-G-7. The biopsy site REPLACES the furthest examined
       site; it is not added to it. Priority 20 beats FURTHEST_SITE_EXAMINED
       at 50, and because exactly one strategy wins the examined site cannot
       also be emitted. Building this as exclusion rather than inclusion is
       the point of R-G-7. -->
  <relinst type="candidate site strategy" object="FURTHEST_SITE_BIOPSIED"
           name="RF-5.5 diagnostic with biopsy takes the furthest site biopsied [PGCS10]" cf="100"
           alt="The biopsy site replaces the furthest examined site">
    <condition rel="has procedure pattern" subject="%S" object="DIAGNOSTIC_WITH_BIOPSY"/>
  </relinst>

  <relinst type="candidate site strategy" object="THERAPEUTIC_SITE"
           name="RF-5.6 single site therapy takes the therapeutic site [PGCS10]" cf="100"
           alt="The site code identifies where the therapy was performed">
    <condition rel="has procedure pattern" subject="%S" object="THERAPEUTIC_SAME_SITE"/>
  </relinst>

  <relinst type="candidate site strategy" object="THERAPEUTIC_SITE"
           name="RF-5.6b therapy with a biopsy elsewhere takes the therapeutic site [PGCS10]" cf="100"
           alt="The therapeutic site is coded and the biopsy site is coded separately">
    <condition rel="has procedure pattern" subject="%S" object="THERAPEUTIC_DIFFERENT_SITE_BIOPSY"/>
  </relinst>

  <relinst type="candidate site strategy" object="EACH_EXCISION_SITE"
           name="RF-5.8 multiple excisions take a site code each [PGCS10]" cf="100"
           alt="Site codes are assigned for each site of excision">
    <condition rel="has procedure pattern" subject="%S" object="MULTI_SITE_SINGLE_METHOD"/>
  </relinst>

  <relinst type="candidate site strategy" object="EACH_EXCISION_SITE"
           name="RF-5.7 multi method sites are emitted per method block [PGCS10]" cf="100"
           alt="Each method block carries its own site codes">
    <condition rel="has procedure pattern" subject="%S" object="MULTI_METHOD"/>
  </relinst>

  <relinst type="candidate site strategy" object="UNRESOLVED"
           name="RF-5.9 unresolved composition leaves the site strategy unresolved [PGCS10]" cf="100"
           alt="The site strategy cannot be determined until the composition is clarified">
    <condition rel="has procedure pattern" subject="%S" object="CLARIFICATION_REQUIRED"/>
  </relinst>

  <!-- RF-6.5. Serial biopsy: the furthest point biopsied generally equals
       the furthest point examined. Generally is why this emits a note and
       not an equivalence. -->
  <relinst type="candidate site strategy" object="FURTHEST_SITE_BIOPSIED"
           name="RF-6.5 serial biopsy takes the furthest site biopsied [LOCAL-BX-SERIAL-1]" cf="100"
           alt="Serial biopsies are sited by the furthest point biopsied">
    <condition rel="has procedure event" subject="%S" object="%E"/>
    <condition rel="has sampling act" subject="%E" object="SERIAL_BIOPSY"/>
  </relinst>

  <relinst type="has coding note"
           name="RF-6.5 serial biopsy note [LOCAL-BX-SERIAL-1]" cf="100">
    <condition rel="has procedure event" subject="%S" object="%E"/>
    <condition rel="has sampling act" subject="%E" object="SERIAL_BIOPSY"/>
    <condition expression="'RF-6.5;Serial biopsy: the furthest point biopsied generally equals the furthest point examined; confirm'" value="%O"/>
  </relinst>

  <!-- RF-6.6b. A random biopsy with no documented site must not DISPLACE
       the site code the examination already earned. EXTENT_SITE_ONLY sits at
       priority 10, above FURTHEST_SITE_BIOPSIED at 20, so the examination
       site survives. Without this WE-23 is unreachable. -->
  <relinst type="has undocumented random biopsy" object="true"
           name="RF-6.6b detect a random biopsy with no documented site [LOCAL-BX-RANDOM-1]" cf="100"
           alt="A random biopsy was taken but the report does not say where from">
    <condition rel="has procedure event" subject="%S" object="%E"/>
    <condition rel="has sampling act" subject="%E" object="RANDOM_BIOPSY"/>
    <condition expression="countRelationshipInstances(%E,'concerns procedure site',*) is equal to 0"
               alt="No anatomical site is documented for the random biopsy"/>
  </relinst>

  <relinst type="candidate site strategy" object="EXTENT_SITE_ONLY"
           name="RF-6.6b undocumented random biopsy keeps the examined site [LOCAL-BX-RANDOM-1]" cf="100"
           alt="The random biopsy has no documented site so the examination site is kept">
    <condition rel="has undocumented random biopsy" subject="%S" object="true"/>
    <condition expression="countRelationshipInstances(%S,'biopsied site',*) is equal to 0"
               alt="No biopsy in the case has a documented site"/>
  </relinst>

  <relinst type="has coding note"
           name="RF-6.6b random biopsy site note [LOCAL-BX-RANDOM-1]" cf="100">
    <condition rel="has undocumented random biopsy" subject="%S" object="true"/>
    <condition expression="countRelationshipInstances(%S,'biopsied site',*) is equal to 0"
               alt="No biopsy in the case has a documented site"/>
    <condition expression="'RF-6.6b;Random biopsy site not documented so the site code for the extent of examination is retained in addition'" value="%O"/>
  </relinst>

  <relinst type="candidate strategy priority"
           name="RF-6 ladder join candidate strategy to its priority" cf="100">
    <condition rel="candidate site strategy" subject="%S" object="%ST"/>
    <condition rel="strategy selection priority" subject="%ST" object="%O"/>
  </relinst>

  <relinst type="selected strategy priority"
           name="RF-6 ladder select the highest ranking strategy" cf="100">
    <condition rel="candidate site strategy" subject="%S" object="%ANY" weight="1"/>
    <condition expression="countRelationshipInstances(%S,'candidate strategy priority',*) is greater than or equal to 1"
               alt="The case has at least one candidate site strategy" weight="1"/>
    <condition expression="minObjects(%S,'candidate strategy priority',*)" value="%O"
               alt="The highest ranking strategy has priority {{%O}}"/>
  </relinst>

  <relinst type="has site strategy"
           name="RF-6 the case takes exactly one site strategy [PGCS10]" cf="100"
           alt="The site strategy is {{%O}}">
    <condition rel="selected strategy priority" subject="%S" object="%WIN"/>
    <condition rel="candidate site strategy" subject="%S" object="%O"/>
    <condition rel="strategy selection priority" subject="%O" object="%WIN"/>
  </relinst>

  <!-- ============ Depth arithmetic and site targets ============ -->

  <relinst type="site offset depth"
           name="RF-6 lift each site depth by its tract offset [PGCS10]" cf="100">
    <condition rel="has depth rank" subject="%S" object="%D"/>
    <condition rel="belongs to tract" subject="%S" object="%TRACT"/>
    <condition rel="tract depth offset" subject="%TRACT" object="%OFF"/>
    <condition expression="%D + %OFF" value="%O" alt="The tract adjusted depth of {{%S}} is {{%O}}"/>
  </relinst>

  <relinst type="examined depth in case"
           name="RF-6.1 collect examined depths [PGCS10]" cf="100">
    <condition rel="examined site" subject="%S" object="%SITE"/>
    <condition rel="site offset depth" subject="%SITE" object="%O"/>
  </relinst>

  <relinst type="biopsied depth in case"
           name="RF-6.2 collect biopsied depths [PGCS10]" cf="100">
    <condition rel="biopsied site" subject="%S" object="%SITE"/>
    <condition rel="site offset depth" subject="%SITE" object="%O"/>
  </relinst>

  <relinst type="furthest examined depth"
           name="RF-6.1 the furthest examined depth [PGCS10]" cf="100">
    <condition rel="examined site" subject="%S" object="%ANY" weight="1"/>
    <condition expression="countRelationshipInstances(%S,'examined depth in case',*) is greater than or equal to 1"
               alt="At least one examined site has a known depth" weight="1"/>
    <condition expression="maxObjects(%S,'examined depth in case',*)" value="%O"
               alt="The furthest examined depth is {{%O}}"/>
  </relinst>

  <relinst type="furthest biopsied depth"
           name="RF-6.2 the furthest biopsied depth [PGCS10]" cf="100">
    <condition rel="biopsied site" subject="%S" object="%ANY" weight="1"/>
    <condition expression="countRelationshipInstances(%S,'biopsied depth in case',*) is greater than or equal to 1"
               alt="At least one biopsied site has a known depth" weight="1"/>
    <condition expression="maxObjects(%S,'biopsied depth in case',*)" value="%O"
               alt="The furthest biopsied depth is {{%O}}"/>
  </relinst>

  <!-- RF-6.1. Where multiple sites are examined during a diagnostic
       endoscopy, a site code identifies the furthest site examined. -->
  <relinst type="has site code target"
           name="RF-6.1 furthest examined site is the target [PGCS10]" cf="100"
           alt="{{%O}} is the furthest site examined">
    <condition rel="has site strategy" subject="%S" object="FURTHEST_SITE_EXAMINED"/>
    <condition rel="furthest examined depth" subject="%S" object="%MAX"/>
    <condition rel="examined site" subject="%S" object="%O"/>
    <condition rel="site offset depth" subject="%O" object="%MAX"/>
  </relinst>

  <!-- RF-6.6b uses the examined depth too, which is what makes it an
       override of the biopsy strategy rather than a separate scheme. -->
  <relinst type="has site code target"
           name="RF-6.6b extent site only keeps the furthest examined site [LOCAL-BX-RANDOM-1]" cf="100"
           alt="{{%O}} is the documented extent of the examination">
    <condition rel="has site strategy" subject="%S" object="%ST"/>
    <condition rel="strategy uses examined depth" subject="%ST" object="true"/>
    <condition rel="furthest examined depth" subject="%S" object="%MAX"/>
    <condition rel="examined site" subject="%S" object="%O"/>
    <condition rel="site offset depth" subject="%O" object="%MAX"/>
  </relinst>

  <!-- RF-6.2. Where multiple biopsies are taken it is only necessary to
       assign a site code for the furthest point biopsied. -->
  <relinst type="has site code target"
           name="RF-6.2 furthest biopsied site is the target [PGCS10]" cf="100"
           alt="{{%O}} is the furthest point biopsied">
    <condition rel="has site strategy" subject="%S" object="FURTHEST_SITE_BIOPSIED"/>
    <condition rel="furthest biopsied depth" subject="%S" object="%MAX"/>
    <condition rel="biopsied site" subject="%S" object="%O"/>
    <condition rel="site offset depth" subject="%O" object="%MAX"/>
  </relinst>

  <relinst type="has site code target"
           name="RF-6 therapeutic site is the target [PGCS10]" cf="100"
           alt="{{%O}} is where the therapeutic procedure was performed">
    <condition rel="has site strategy" subject="%S" object="THERAPEUTIC_SITE"/>
    <condition rel="therapeutic site used" subject="%S" object="%O"/>
  </relinst>

  <!-- RF-6.3. Every excision site, not just the furthest. -->
  <relinst type="has site code target"
           name="RF-6.3 every excision site is a target [PGCS10]" cf="100"
           alt="{{%O}} was excised so it takes its own site code">
    <condition rel="has site strategy" subject="%S" object="EACH_EXCISION_SITE"/>
    <condition rel="therapeutic site used" subject="%S" object="%O"/>
  </relinst>

  <!-- RF-6.4. A target site with an approved local site code. -->
  <relinst type="has tentative code"
           name="RF-6.4 emit the approved local site code [LOCAL-SITE-TABLE]" cf="100"
           alt="{{%SITE}} takes the approved local site code {{%O}}">
    <condition rel="has site code target" subject="%S" object="%SITE"/>
    <condition rel="has approved site code" subject="%SITE" object="true"/>
    <condition rel="has approved local site code" subject="%SITE" object="%O"/>
  </relinst>

  <!-- RF-6.8. The exact mirror of RF-6.4 on the same boolean, so a site can
       never both emit a code and raise the instruction. The model must NOT
       silently substitute the caecum code for the ileocaecal valve. -->
  <relinst type="has ambiguity" object="SITE_CODE_NOT_IN_LOCAL_TABLE"
           name="RF-6.8 target site absent from the local table raises an ambiguity [LOCAL-SITE-TABLE]" cf="100"
           alt="{{%SITE}} has no approved local site code so it must be derived from the Index">
    <condition rel="has site code target" subject="%S" object="%SITE"/>
    <condition rel="has approved site code" subject="%SITE" object="false"/>
  </relinst>

  <relinst type="case requires lookup instruction"
           name="RF-6.8 lookup instruction for a site absent from the local table [LOCAL-SITE-TABLE]" cf="100">
    <condition rel="has site code target" subject="%S" object="%SITE"/>
    <condition rel="has approved site code" subject="%SITE" object="false"/>
    <condition expression="'Alphabetical;' + %SITE + ';Chapter Z site code;SITE_CODE;RF-6.8 site not in the local table and must not be substituted'" value="%O"/>
  </relinst>

  <!-- RF-6.6 NEGATIVE. If we do not know where the biopsy was taken from,
       do not assign the colon NEC site code in addition, because it adds no
       further information. A rule that exists purely to prevent a code. -->
  <relinst type="is suppressed in case" object="true"
           name="RF-6.6 colon NEC suppressed when the biopsy site is unknown [LOCAL-BX-RANDOM-1]" cf="100"
           alt="The biopsy site is unknown so the colon NEC code adds no further information">
    <condition rel="is tentative in case" subject="%S" object="%CASE"/>
    <condition rel="has approved local site code" subject="ColonNEC" object="%S"/>
    <condition rel="has undocumented random biopsy" subject="%CASE" object="true"/>
  </relinst>

  <relinst type="suppression reason"
           name="RF-6.6 reason colon NEC was suppressed [LOCAL-BX-RANDOM-1]" cf="100">
    <condition rel="is tentative in case" subject="%S" object="%CASE"/>
    <condition rel="has approved local site code" subject="ColonNEC" object="%S"/>
    <condition rel="has undocumented random biopsy" subject="%CASE" object="true"/>
    <condition expression="'RF-6.6;Site unknown; ColonNEC adds no further information'" value="%O"/>
  </relinst>

  <!-- RF-6.7 NEGATIVE. A site code is suppressed when another site code in
       the case names a more specific site within the same organ. -->
  <relinst type="is suppressed in case" object="true"
           name="RF-6.7 less specific site code suppressed by a more specific one [LOCAL-SITE-TABLE]" cf="100"
           alt="Another site code in the case names a more specific site">
    <condition rel="is tentative in case" subject="%S" object="%CASE"/>
    <condition rel="has approved local site code" subject="%SITE" object="%S"/>
    <condition rel="has site code target" subject="%CASE" object="%OTHER"/>
    <condition rel="is more specific than site" subject="%OTHER" object="%SITE"/>
    <condition rel="has approved local site code" subject="%OTHER" object="%FINER"/>
  </relinst>

  <relinst type="suppression reason"
           name="RF-6.7 reason the less specific site code was suppressed [LOCAL-SITE-TABLE]" cf="100">
    <condition rel="is tentative in case" subject="%S" object="%CASE"/>
    <condition rel="has approved local site code" subject="%SITE" object="%S"/>
    <condition rel="has site code target" subject="%CASE" object="%OTHER"/>
    <condition rel="is more specific than site" subject="%OTHER" object="%SITE"/>
    <condition expression="'RF-6.7;A more specific site code within the same organ is assigned instead'" value="%O"/>
  </relinst>

  <!-- RF-6.9 HARD STOP. Sites in both GI tracts examined under a single
       procedure event. Terminal ileum and ileocaecal valve are members of
       the lower GI tract for this test, so an ileoscopy does not stop. -->
  <relinst type="examined tract"
           name="RF-6.9 collect the tracts examined [PGCS10]" cf="100">
    <condition rel="examined site" subject="%S" object="%SITE"/>
    <condition rel="belongs to tract" subject="%SITE" object="%O"/>
  </relinst>

  <relinst type="has hard stop" object="INCOMPATIBLE_SITE_SET_FOR_SINGLE_PROCEDURE"
           name="RF-6.9 both GI tracts examined under one procedure is a hard stop [PGCS10]" cf="100"
           alt="Sites in both the upper and lower GI tract were examined under a single procedure event">
    <condition rel="examined tract" subject="%S" object="%ANY" weight="1"/>
    <condition expression="countRelationshipInstances(%S,'examined tract',*) is greater than 1"
               alt="Sites from more than one GI tract were examined"/>
    <condition expression="countRelationshipInstances(%S,'has procedure event',*) is equal to 1"
               alt="The case records exactly one procedure event"/>
  </relinst>

  <!-- ================================================================
       L9  RF-7  METHOD AND PROCEDURE CODE EMISSION
       Every code comes from a Section 6.2 mapping fact, never from a
       hardcoded conclusion, so structural assertions 2 and 13 hold by
       construction: there is exactly one place a code can enter the model.
       ================================================================ -->

  <!-- R-G-11. An event opens a new coding block only if no EARLIER event in the
       case used the same effective method. Where one method is used at several
       sites the block is opened once, so the later events add only their site
       codes. Earlier is decided on the documented order, which is also what the
       block ordinal is built from, so the opener is always the lowest ordinal
       and the choice is deterministic. -->
  <relinst type="method block already opened" object="true"
           name="R-G-11 a repeat of an earlier method does not reopen its block [PGCS10]" cf="100"
           alt="An earlier event in the case already used method {{%M}}">
    <condition rel="is therapeutic event" subject="%S" object="true"/>
    <condition rel="has effective method" subject="%S" object="%M"/>
    <condition rel="has documented order" subject="%S" object="%ORD"/>
    <condition rel="event belongs to case" subject="%S" object="%CASE"/>
    <condition rel="has procedure event" subject="%CASE" object="%OTHER"/>
    <condition rel="has effective method" subject="%OTHER" object="%M"/>
    <condition rel="has documented order" subject="%OTHER" object="%ORD2"/>
    <condition expression="%ORD2 is less than %ORD"
               alt="Event order {{%ORD2}} precedes order {{%ORD}}"/>
  </relinst>

  <!-- The body system code identifies the METHOD, so it is emitted once per
       method and not once per event. Without the block gate a single method
       used at three sites emitted its body system code three times, which is
       what WE-07 caught. -->
  <relinst type="emits body system code"
           name="RF-7.1 to RF-7.10 emit the mapped body system code [LOCAL-OPCS-MAPPINGS]" cf="100"
           alt="Method {{%M}} performed at a {{%PT}} maps to body system code {{%O}}">
    <condition rel="is therapeutic event" subject="%S" object="true"/>
    <condition rel="has effective method" subject="%S" object="%M"/>
    <condition rel="has procedure type" subject="%S" object="%PT"/>
    <condition rel="mapping for method" subject="%MAP" object="%M"/>
    <condition rel="mapping for procedure type" subject="%MAP" object="%PT"/>
    <condition rel="yields body system code" subject="%MAP" object="%O"/>
    <condition expression="countRelationshipInstances(%S,'method block already opened',*) is equal to 0"
               alt="This event opens the coding block for its method"/>
  </relinst>

  <relinst type="emits qualifier code"
           name="RF-7.1 and RF-7.6 to RF-7.9 emit the Chapter Y method qualifier [LOCAL-OPCS-MAPPINGS]" cf="100"
           alt="Method {{%M}} carries the Chapter Y method qualifier {{%O}}">
    <condition rel="is therapeutic event" subject="%S" object="true"/>
    <condition rel="has effective method" subject="%S" object="%M"/>
    <condition rel="has procedure type" subject="%S" object="%PT"/>
    <condition rel="mapping for method" subject="%MAP" object="%M"/>
    <condition rel="mapping for procedure type" subject="%MAP" object="%PT"/>
    <condition rel="yields qualifier code" subject="%MAP" object="%O"/>
    <condition expression="countRelationshipInstances(%S,'method block already opened',*) is equal to 0"
               alt="This event opens the coding block for its method"/>
  </relinst>

  <relinst type="has tentative code"
           name="RF-7 body system code becomes a case tentative code [LOCAL-OPCS-MAPPINGS]" cf="100"
           alt="The case takes body system code {{%O}}">
    <condition rel="has procedure event" subject="%S" object="%E"/>
    <condition rel="emits body system code" subject="%E" object="%O"/>
  </relinst>

  <relinst type="has tentative code"
           name="RF-7 Chapter Y method qualifier becomes a case tentative code [LOCAL-OPCS-MAPPINGS]" cf="100"
           alt="The case takes Chapter Y method qualifier {{%O}}">
    <condition rel="has procedure event" subject="%S" object="%E"/>
    <condition rel="emits qualifier code" subject="%E" object="%O"/>
  </relinst>

  <!-- Diagnostic procedure codes. The absorbed diagnostic event emits
       nothing, which is how PGCS2 takes effect on the code list. -->
  <relinst type="has tentative code"
           name="RF-5.4 and RF-5.5 emit the diagnostic procedure code [LOCAL-OPCS-MAPPINGS]" cf="100"
           alt="A {{%PT}} with biopsy status {{%BX}} maps to {{%O}}">
    <condition rel="has procedure event" subject="%S" object="%E"/>
    <condition rel="has effective intent" subject="%E" object="DIAGNOSTIC"/>
    <condition rel="has procedure type" subject="%E" object="%PT"/>
    <condition rel="is a biopsy for coding" subject="%E" object="%BX"/>
    <condition rel="diagnostic mapping for procedure type" subject="%MAP" object="%PT"/>
    <condition rel="diagnostic mapping requires biopsy" subject="%MAP" object="%BX"/>
    <condition rel="diagnostic mapping yields code" subject="%MAP" object="%O"/>
    <condition rel="has procedure pattern" subject="%S" object="%PAT"/>
    <condition rel="pattern emits diagnostic procedure code" subject="%PAT" object="true"/>
    <condition expression="countRelationshipInstances(%E,'is absorbed by',*) is equal to 0"
               alt="The diagnostic event was not absorbed by a therapeutic procedure at the same site"/>
  </relinst>

  <!-- R-I-14 NEGATIVE. There is deliberately no first pass mapping for a
       diagnostic colonoscopy without biopsy, because the only place that
       code appears in the source material is the OPCS4Codes field that
       RF-1.6 forbids. The pattern raises a lookup instead.

       The match projection first, because whether a mapping covers an event
       depends on the procedure type AND the biopsy status together, and a count
       cannot traverse two hops. -->
  <relinst type="event has diagnostic mapping"
           name="R-I-14 project the diagnostic mappings that cover this event [LOCAL-OPCS-MAPPINGS]" cf="100">
    <condition rel="has procedure type" subject="%S" object="%PT"/>
    <condition rel="is a biopsy for coding" subject="%S" object="%BX"/>
    <condition rel="diagnostic mapping for procedure type" subject="%O" object="%PT"/>
    <condition rel="diagnostic mapping requires biopsy" subject="%O" object="%BX"/>
  </relinst>

  <relinst type="has ambiguity" object="LOOKUP_REQUIRED"
           name="R-I-14 no local mapping for this diagnostic procedure so the code must be looked up [LOCAL-OPCS-MAPPINGS]" cf="100"
           alt="No approved local mapping covers a {{%PT}} with biopsy status {{%BX}}">
    <condition rel="has procedure event" subject="%S" object="%E"/>
    <condition rel="has effective intent" subject="%E" object="DIAGNOSTIC"/>
    <condition rel="has procedure type" subject="%E" object="%PT"/>
    <condition rel="is a biopsy for coding" subject="%E" object="%BX"/>
    <condition rel="has procedure pattern" subject="%S" object="%PAT"/>
    <condition rel="pattern emits diagnostic procedure code" subject="%PAT" object="true"/>
    <condition expression="countRelationshipInstances(%E,'is absorbed by',*) is equal to 0"
               alt="The diagnostic event was not absorbed by a therapeutic procedure"/>
    <condition expression="countRelationshipInstances(%E,'event has diagnostic mapping',*) is equal to 0"
               alt="No approved local diagnostic mapping covers this procedure and biopsy status"/>
  </relinst>

  <!-- RF-7.11. The method determines the body system code, so an unstated
       method cannot be defaulted. The model asks. Cap 80. -->
  <relinst type="has ambiguity" object="POLYPECTOMY_METHOD_UNSTATED_AMBIGUITY"
           name="RF-7.11 unstated polypectomy method raises an ambiguity [PGCS10]" cf="80"
           alt="A polypectomy was performed but the report does not state the method used">
    <condition rel="has procedure event" subject="%S" object="%E"/>
    <condition rel="has effective method" subject="%E" object="POLYPECTOMY_METHOD_UNSTATED"/>
  </relinst>

  <relinst type="candidate review tier" object="FULL"
           name="RF-7.11 unstated method needs full review [PGCS10]" cf="80"
           alt="The unstated polypectomy method requires coder review">
    <condition rel="has ambiguity" subject="%S" object="POLYPECTOMY_METHOD_UNSTATED_AMBIGUITY"/>
  </relinst>

  <relinst type="certainty cap" object="80"
           name="RF-7.11 cap certainty at 80 [PGCS10]" cf="100"
           alt="An unstated procedure modifier caps certainty at 80">
    <condition rel="has ambiguity" subject="%S" object="POLYPECTOMY_METHOD_UNSTATED_AMBIGUITY"/>
  </relinst>

  <!-- A therapeutic method with no approved local mapping at all. RF-7.11
       covers the named unstated case; this covers every other method the
       source enumerates without giving it a mapping rule.

       Same two hop projection as R-I-14 and for the same reason: a mapping
       covers an event only if it matches the method AND the procedure type, and
       counting the method against the mapping table put the method on the
       subject side when the table holds it as the object, so the count read zero
       for every therapeutic case. -->
  <relinst type="event has therapeutic mapping"
           name="R-I-13 project the therapeutic mappings that cover this event [LOCAL-OPCS-MAPPINGS]" cf="100">
    <condition rel="has effective method" subject="%S" object="%M"/>
    <condition rel="has procedure type" subject="%S" object="%PT"/>
    <condition rel="mapping for method" subject="%O" object="%M"/>
    <condition rel="mapping for procedure type" subject="%O" object="%PT"/>
  </relinst>

  <relinst type="has ambiguity" object="LOOKUP_REQUIRED"
           name="R-I-13 therapeutic method with no local mapping requires a lookup [LOCAL-OPCS-MAPPINGS]" cf="100"
           alt="Method {{%M}} has no approved local mapping for a {{%PT}}">
    <condition rel="has therapeutic event" subject="%S" object="%E"/>
    <condition rel="has effective method" subject="%E" object="%M"/>
    <condition rel="has procedure type" subject="%E" object="%PT"/>
    <condition expression="countRelationshipInstances(%E,'event has therapeutic mapping',*) is equal to 0"
               alt="No approved local mapping covers this method for this procedure type"/>
  </relinst>

  <!-- ============ Biopsy marker codes, RF-8.2 and RF-8.3 ============ -->

  <!-- RF-8.2 NEGATIVE. When an endoscopic excision is performed and a
       biopsy is taken at the same time, the biopsy is only coded if taken
       from a DIFFERENT site. The suppression is excision specific: the
       same site biopsy survives a cauterisation, which is exactly why
       WE-16 keeps its biopsy marker and WE-05 does not. -->
  <relinst type="has event disposition" object="SUPPRESS_BIOPSY_SAME_SITE_AS_EXCISION"
           name="RF-8.2 same site biopsy suppressed when an excision was performed [PGCS10]" cf="100"
           alt="The biopsy was taken from the same site as an excision so it is not separately coded">
    <condition rel="is a biopsy for coding" subject="%S" object="true"/>
    <condition rel="has biopsy site" subject="%S" object="%SITE"/>
    <condition rel="event belongs to case" subject="%S" object="%CASE"/>
    <condition rel="has procedure event" subject="%CASE" object="%T"/>
    <condition rel="is therapeutic event" subject="%T" object="true"/>
    <condition rel="has effective method" subject="%T" object="%M"/>
    <condition rel="method is excisional" subject="%M" object="true"/>
    <condition rel="concerns procedure site" subject="%T" object="%SITE"/>
  </relinst>

  <!-- The boolean mirror of the suppression, so RF-8.3 can test it with an
       unfiltered count. Counting the multi valued disposition list filtered to
       this one literal would not drive its derivation and would silently read
       zero, emitting the very biopsy marker RF-8.2 suppressed. -->
  <relinst type="biopsy suppressed by excision" object="true"
           name="RF-8.2 mirror the same site excision suppression as a flag [PGCS10]" cf="100"
           alt="The biopsy was suppressed because an excision was performed at the same site">
    <condition rel="has event disposition" subject="%S" object="SUPPRESS_BIOPSY_SAME_SITE_AS_EXCISION"/>
  </relinst>

  <!-- RF-8.3. A surviving biopsy emits a Y20 marker after the therapeutic
       block, followed by the site code for the biopsy site. Y20.3 where the
       biopsy concerns a named lesion, Y20.9 otherwise. -->
  <relinst type="emits biopsy marker code" object="OPCS-4:Y20.3"
           name="RF-8.3 biopsy of a lesion emits Y20.3 [LOCAL-OPCS-Y20-3]" cf="100"
           alt="The biopsy concerns a documented lesion">
    <condition rel="is a biopsy for coding" subject="%S" object="true"/>
    <condition rel="biopsy concerns lesion" subject="%S" object="true"/>
    <condition expression="countRelationshipInstances(%S,'biopsy suppressed by excision',*) is equal to 0"
               alt="The biopsy was not suppressed by RF-8.2"/>
  </relinst>

  <relinst type="emits biopsy marker code" object="OPCS-4:Y20.9"
           name="RF-8.3 biopsy not of a named lesion emits Y20.9 [LOCAL-OPCS-Y20-9]" cf="100"
           alt="The biopsy does not concern a specifically documented lesion">
    <condition rel="is a biopsy for coding" subject="%S" object="true"/>
    <condition rel="biopsy concerns lesion" subject="%S" object="false"/>
    <condition expression="countRelationshipInstances(%S,'biopsy suppressed by excision',*) is equal to 0"
               alt="The biopsy was not suppressed by RF-8.2"/>
  </relinst>

  <!-- The biopsy marker only appears where a therapeutic block exists to
       follow. In a purely diagnostic case the procedure code already says a
       biopsy was taken, so no marker is emitted. -->
  <relinst type="has tentative code"
           name="RF-8.3 biopsy marker becomes a case tentative code [PGCS10]" cf="100"
           alt="The case takes biopsy marker {{%O}}">
    <condition rel="has procedure event" subject="%S" object="%E"/>
    <condition rel="emits biopsy marker code" subject="%E" object="%O"/>
    <condition expression="countRelationshipInstances(%S,'has therapeutic event',*) is greater than or equal to 1"
               alt="A therapeutic block exists for the biopsy marker to follow"/>
  </relinst>

  <!-- X-1 the WE-16 same site collapse. Where the surviving biopsy is at
       the same site as the therapeutic procedure, a single trailing site
       code serves both roles, so the biopsy does not emit its own. This is a
       collapse WITHIN one method block; assertion 14 forbids dedup ACROSS
       method blocks and is unaffected. -->
  <relinst type="site code suppressed by collapse" object="true"
           name="X-1 same site biopsy shares the therapeutic site code [PGCS10]" cf="100"
           alt="The biopsy site equals the therapeutic site so one site code serves both">
    <condition rel="emits biopsy marker code" subject="%S" object="%MARK"/>
    <condition rel="has biopsy site" subject="%S" object="%SITE"/>
    <condition rel="event belongs to case" subject="%S" object="%CASE"/>
    <condition rel="therapeutic site used" subject="%CASE" object="%SITE"/>
    <condition expression="countRelationshipInstances(%CASE,'therapeutic method used',*) is equal to 1"
               alt="The case has a single method block so the collapse applies"/>
  </relinst>

  <relinst type="has same site collapse" object="true"
           name="X-1 project the same site collapse onto the case [PGCS10]" cf="100"
           alt="A surviving biopsy shares its site code with the therapeutic block">
    <condition rel="has procedure event" subject="%S" object="%E"/>
    <condition rel="site code suppressed by collapse" subject="%E" object="true"/>
  </relinst>

  <relinst type="emits biopsy site code"
           name="RF-8.3 surviving biopsy at a different site emits its own site code [PGCS10]" cf="100"
           alt="The biopsy site {{%SITE}} takes site code {{%O}}">
    <condition rel="emits biopsy marker code" subject="%S" object="%MARK"/>
    <condition rel="has biopsy site" subject="%S" object="%SITE"/>
    <condition rel="has approved site code" subject="%SITE" object="true"/>
    <condition rel="has approved local site code" subject="%SITE" object="%O"/>
    <condition expression="countRelationshipInstances(%S,'site code suppressed by collapse',*) is equal to 0"
               alt="The biopsy site code was not collapsed into the therapeutic site code"/>
  </relinst>

  <!-- The biopsy site code only reaches the case on the same condition as the
       biopsy MARKER it belongs to: a therapeutic block must exist for the pair
       to follow. In a purely diagnostic case the procedure code already says a
       biopsy was taken, so neither the marker nor its site code is a case code.
       The gate is restated here rather than tested as `has tentative code
       %MARK`, because a `has tentative code` rule that reads `has tentative
       code` on its own subject is self recursive and the engine rejects every
       query that touches the relationship. -->
  <relinst type="has tentative code"
           name="RF-8.3 biopsy site code becomes a case tentative code [PGCS10]" cf="100"
           alt="The case takes biopsy site code {{%O}}">
    <condition rel="has procedure event" subject="%S" object="%E"/>
    <condition rel="emits biopsy site code" subject="%E" object="%O"/>
    <condition rel="emits biopsy marker code" subject="%E" object="%MARK"/>
    <condition expression="countRelationshipInstances(%S,'has therapeutic event',*) is greater than or equal to 1"
               alt="A therapeutic block exists for the biopsy marker and its site code to follow"/>
  </relinst>

  <!-- ============ Code roles ============ -->

  <relinst type="has code role" object="BODY_SYSTEM_METHOD"
           name="RF-8.3 body system code role [PGCS10]" cf="100"
           alt="The code identifies the body system and method">
    <condition rel="emits body system code" subject="%E" object="%S"/>
  </relinst>

  <relinst type="has code role" object="CHAPTER_Y_METHOD_QUALIFIER"
           name="RF-8.3 method qualifier role [PGCS10]" cf="100"
           alt="The code qualifies the method used">
    <condition rel="emits qualifier code" subject="%E" object="%S"/>
  </relinst>

  <relinst type="has code role" object="CHAPTER_Y_BIOPSY"
           name="RF-8.3 biopsy marker role [PGCS10]" cf="100"
           alt="The code marks that a biopsy was taken">
    <condition rel="emits biopsy marker code" subject="%E" object="%S"/>
  </relinst>

  <relinst type="has code role" object="BIOPSY_SITE_CODE"
           name="RF-8.3 biopsy site code role [PGCS10]" cf="100"
           alt="The code identifies the site the biopsy was taken from">
    <condition rel="emits biopsy site code" subject="%E" object="%S"/>
  </relinst>

  <relinst type="has code role" object="SITE_CODE"
           name="RF-6.4 site code role [LOCAL-SITE-TABLE]" cf="100"
           alt="The code identifies the site of the procedure">
    <condition rel="has approved local site code" subject="%SITE" object="%S"/>
    <condition rel="has site code target" subject="%CASE" object="%SITE"/>
  </relinst>

  <relinst type="is tentative in case"
           name="RF-8 record which case a tentative code belongs to" cf="100">
    <condition rel="has tentative code" subject="%O" object="%S"/>
  </relinst>

  <relinst type="requires tabular verification" object="true"
           name="RF-9 every first pass code requires tabular verification [SDD 2.3]" cf="100"
           alt="Every code produced from a local mapping must be verified in the Tabular List">
    <condition rel="is tentative in case" subject="%S" object="%CASE"/>
  </relinst>

  <!-- ================================================================
       L10  RF-8  SEQUENCING
       ================================================================ -->

  <relinst type="has sequence template" object="PROCEDURE_THEN_SITE"
           name="RF-8.6 diagnostic patterns take procedure then site [PGCS10]" cf="100"
           alt="A diagnostic examination is sequenced as procedure code then site code">
    <condition rel="has procedure pattern" subject="%S" object="DIAGNOSTIC_ONLY"/>
  </relinst>

  <relinst type="has sequence template" object="PROCEDURE_THEN_SITE"
           name="RF-8.6 diagnostic with biopsy takes procedure then site [PGCS10]" cf="100"
           alt="A diagnostic examination with biopsy is sequenced as procedure code then site code">
    <condition rel="has procedure pattern" subject="%S" object="DIAGNOSTIC_WITH_BIOPSY"/>
  </relinst>

  <relinst type="has sequence template" object="THERAPEUTIC_BLOCK_THEN_BIOPSY"
           name="RF-8.3 single method therapy takes the therapeutic block template [PGCS10]" cf="100"
           alt="The codes are sequenced as therapeutic block then any surviving biopsy">
    <condition rel="has procedure pattern" subject="%S" object="THERAPEUTIC_SAME_SITE"/>
  </relinst>

  <relinst type="has sequence template" object="THERAPEUTIC_BLOCK_THEN_BIOPSY"
           name="RF-8.3 therapy with a biopsy elsewhere takes the therapeutic block template [PGCS10]" cf="100"
           alt="The codes are sequenced as therapeutic block then the biopsy at its own site">
    <condition rel="has procedure pattern" subject="%S" object="THERAPEUTIC_DIFFERENT_SITE_BIOPSY"/>
  </relinst>

  <relinst type="has sequence template" object="THERAPEUTIC_BLOCK_THEN_BIOPSY"
           name="RF-8.3 multiple excisions take the therapeutic block template [PGCS10]" cf="100"
           alt="One method block carries a site code for each excision site">
    <condition rel="has procedure pattern" subject="%S" object="MULTI_SITE_SINGLE_METHOD"/>
  </relinst>

  <relinst type="has sequence template" object="BODY_SYSTEM_CODE_PER_METHOD_THEN_SITES"
           name="RF-8.4 multi method takes a body system code per method [PGCS10]" cf="100"
           alt="Each therapeutic method takes its own body system code followed by its site codes">
    <condition rel="has procedure pattern" subject="%S" object="MULTI_METHOD"/>
  </relinst>

  <relinst type="has sequence template" object="SEQUENCE_UNRESOLVED"
           name="RF-5.9 unresolved composition leaves sequencing unresolved [PGCS10]" cf="100"
           alt="Sequencing cannot be determined until the composition is clarified">
    <condition rel="has procedure pattern" subject="%S" object="CLARIFICATION_REQUIRED"/>
  </relinst>

  <!-- ============ The four rule sequence ordinal ============
       Block ordinal times 100, plus role position times 10, plus the event
       order within the block. Decomposed into four rules with ONE arithmetic
       operator each: RBLang evaluates strictly left to right with no
       operator precedence even inside brackets, so a single combined
       expression would compute the wrong number silently. -->

  <relinst type="has block ordinal"
           name="RF-8.4 the method block ordinal is the documented order [PGCS10]" cf="100"
           alt="The event is method block {{%O}} in documented order">
    <condition rel="is therapeutic event" subject="%S" object="true"/>
    <condition rel="has documented order" subject="%S" object="%ORD"/>
    <condition expression="%ORD + 0" value="%O" alt="The documented order {{%ORD}} becomes the block ordinal"/>
  </relinst>

  <relinst type="has block ordinal" object="1"
           name="RF-8.6 a diagnostic case is a single block [PGCS10]" cf="100"
           alt="A diagnostic examination forms one coding block">
    <condition rel="has effective intent" subject="%S" object="DIAGNOSTIC"/>
    <condition expression="countRelationshipInstances(%S,'is absorbed by',*) is equal to 0"
               alt="The diagnostic event was not absorbed"/>
  </relinst>

  <relinst type="block ordinal scaled"
           name="RF-8.4 seq-a scale the block ordinal [PGCS10]" cf="100">
    <condition rel="has block ordinal" subject="%S" object="%B"/>
    <condition expression="%B * 100" value="%O" alt="Block {{%B}} scales to {{%O}}"/>
  </relinst>

  <relinst type="case block ordinal"
           name="RF-8.4 collect the block ordinals in the case [PGCS10]" cf="100">
    <condition rel="has procedure event" subject="%S" object="%E"/>
    <condition rel="has block ordinal" subject="%E" object="%O"/>
  </relinst>

  <!-- R-J-5. The Y20 biopsy marker is placed after the LAST method block
       for reproducibility. The source says any block is acceptable, so the
       latitude is recorded as a note and a coder's alternative placement is
       not a discrepancy. -->
  <relinst type="last block ordinal"
           name="RF-8.4 the last method block in the case [PGCS10]" cf="100">
    <condition rel="case block ordinal" subject="%S" object="%ANY" weight="1"/>
    <condition expression="countRelationshipInstances(%S,'case block ordinal',*) is greater than or equal to 1"
               alt="The case has at least one coding block" weight="1"/>
    <condition expression="maxObjects(%S,'case block ordinal',*)" value="%O"
               alt="The last coding block is block {{%O}}"/>
  </relinst>

  <relinst type="has coding note"
           name="R-J-5 record the biopsy placement latitude [PGCS10]" cf="100">
    <condition rel="has procedure pattern" subject="%S" object="MULTI_METHOD"/>
    <condition rel="has biopsy event" subject="%S" object="%E"/>
    <condition expression="'RF-8.4;The biopsy marker may follow any method block; the last block is proposed for reproducibility and an alternative coder placement is not a discrepancy'" value="%O"/>
  </relinst>

  <!-- ================================================================
       L10b. THE ORDERED OPCS SEQUENCE (R-J-3, R-J-4, R-J-5, R-J-6).
       The source's answer key is code for code and POSITION for position,
       so the ordering contract has to be queryable and not merely implied by
       the template name.

       Why a separate string layer rather than the code list: instance object
       facts de-duplicate on (subject, rel, object), so `has tentative code`
       can only ever carry a code ONCE. R-J-6 and structural assertion 14
       require Z28.4 to appear TWICE in WE-09, once per method block. Each
       sequence entry embeds its own position ordinal, so two entries for the
       same code in different blocks are genuinely distinct facts and survive.
       `has tentative code` therefore remains the de-duplicated code SET for
       G6, and this layer is the ordered LIST with per-block repeats.

       Position ordinal = block ordinal * 100 + the role offset, with the role
       offset written as a literal in each rule because each rule already
       knows its own role. One arithmetic operator per expression throughout:
       RBLang has no operator precedence even inside brackets.

       Role offsets follow R-J-3, which is the commonest sequencing error:
       10 body system, 20 Chapter Y METHOD QUALIFIER (before its site code),
       30 site code, 40 Chapter Y BIOPSY marker, 50 biopsy site code.

       INVARIANT: every sequence rule also requires the code to be in the
       case's `has tentative code` set. The sequence layer ORDERS the code set;
       it must never be able to introduce a code the set excludes. Without this
       the marker gating that keeps a purely diagnostic case free of a Y20
       marker held for the code list but leaked into the ordered list. -->

  <!-- R-J-6. Site codes are per method block, not per case. The case level
       site target drives the diagnostic case; a therapeutic block takes the
       site code for its own site so that two blocks at the same site each
       keep their own copy. -->
  <relinst type="emits site code"
           name="R-J-6 a therapeutic block emits the site code for its own site [LOCAL-SITE-TABLE]" cf="100"
           alt="The block at {{%SITE}} takes site code {{%O}}">
    <condition rel="is therapeutic event" subject="%S" object="true"/>
    <condition rel="concerns procedure site" subject="%S" object="%SITE"/>
    <condition rel="has approved site code" subject="%SITE" object="true"/>
    <condition rel="has approved local site code" subject="%SITE" object="%O"/>
  </relinst>

  <relinst type="has opcs sequence entry"
           name="R-J-4 seq the body system code first in its block [PGCS10]" cf="100"
           alt="Position {{%ORD}} of the OPCS sequence is body system code {{%C}}">
    <condition rel="has procedure event" subject="%S" object="%E"/>
    <condition rel="emits body system code" subject="%E" object="%C"/>
    <condition rel="has tentative code" subject="%S" object="%C"/>
    <condition rel="has block ordinal" subject="%E" object="%B"/>
    <condition expression="countRelationshipInstances(%C,'is suppressed in case',*) is equal to 0"
               alt="The code was not suppressed"/>
    <condition expression="%B * 100" value="%BS" alt="Block {{%B}} scales to {{%BS}}"/>
    <condition expression="%BS + 10" value="%ORD" alt="The body system code sits at position {{%ORD}}"/>
    <condition expression="'OPCS;' + %ORD + ';' + %C + ';BODY_SYSTEM_METHOD'" value="%O"
               alt="Sequence entry {{%O}}"/>
  </relinst>

  <!-- R-J-3. The method qualifier sits immediately after its own body system
       code and BEFORE that method's site code, which is why its offset is 20
       and the site code's is 30. -->
  <relinst type="has opcs sequence entry"
           name="R-J-3 seq the Chapter Y method qualifier before its site code [PGCS10]" cf="100"
           alt="Position {{%ORD}} of the OPCS sequence is method qualifier {{%C}}">
    <condition rel="has procedure event" subject="%S" object="%E"/>
    <condition rel="emits qualifier code" subject="%E" object="%C"/>
    <condition rel="has tentative code" subject="%S" object="%C"/>
    <condition rel="has block ordinal" subject="%E" object="%B"/>
    <condition expression="countRelationshipInstances(%C,'is suppressed in case',*) is equal to 0"
               alt="The code was not suppressed"/>
    <condition expression="%B * 100" value="%BS" alt="Block {{%B}} scales to {{%BS}}"/>
    <condition expression="%BS + 20" value="%ORD" alt="The method qualifier sits at position {{%ORD}}"/>
    <condition expression="'OPCS;' + %ORD + ';' + %C + ';CHAPTER_Y_METHOD_QUALIFIER'" value="%O"
               alt="Sequence entry {{%O}}"/>
  </relinst>

  <relinst type="has opcs sequence entry"
           name="R-J-6 seq the site code of each therapeutic block [PGCS10]" cf="100"
           alt="Position {{%ORD}} of the OPCS sequence is site code {{%C}}">
    <condition rel="has procedure event" subject="%S" object="%E"/>
    <condition rel="emits site code" subject="%E" object="%C"/>
    <condition rel="has tentative code" subject="%S" object="%C"/>
    <condition rel="has block ordinal" subject="%E" object="%B"/>
    <condition expression="countRelationshipInstances(%C,'is suppressed in case',*) is equal to 0"
               alt="The site code was not suppressed by RF-8.5"/>
    <condition expression="countRelationshipInstances(%S,'has same site collapse',*) is equal to 0"
               alt="No surviving biopsy shares this site code"/>
    <condition expression="%B * 100" value="%BS" alt="Block {{%B}} scales to {{%BS}}"/>
    <condition expression="%BS + 30" value="%ORD" alt="The site code sits at position {{%ORD}}"/>
    <condition expression="'OPCS;' + %ORD + ';' + %C + ';SITE_CODE'" value="%O"
               alt="Sequence entry {{%O}}"/>
  </relinst>

  <!-- X-1 the collapse sub-template. Where the surviving biopsy is at the same
       site as the therapeutic procedure, ONE site code serves both roles and
       the answer keys for WE-03 and WE-16 place it LAST, after the Y20 marker:
       [body system, (Y qualifier), Y20 biopsy, single site code]. So the site
       code takes the trailing offset 50 instead of the in-block offset 30, and
       its role records that it is doing both jobs. -->
  <relinst type="has opcs sequence entry"
           name="X-1 seq the shared site code last when the biopsy site collapses [PGCS10]" cf="100"
           alt="Position {{%ORD}} of the OPCS sequence is the shared site code {{%C}}">
    <condition rel="has same site collapse" subject="%S" object="true"/>
    <condition rel="has procedure event" subject="%S" object="%E"/>
    <condition rel="emits site code" subject="%E" object="%C"/>
    <condition rel="has tentative code" subject="%S" object="%C"/>
    <condition rel="has block ordinal" subject="%E" object="%B"/>
    <condition expression="countRelationshipInstances(%C,'is suppressed in case',*) is equal to 0"
               alt="The site code was not suppressed by RF-8.5"/>
    <condition expression="%B * 100" value="%BS" alt="Block {{%B}} scales to {{%BS}}"/>
    <condition expression="%BS + 50" value="%ORD" alt="The shared site code sits last at position {{%ORD}}"/>
    <condition expression="'OPCS;' + %ORD + ';' + %C + ';SITE_CODE_AND_BIOPSY_SITE_CODE'" value="%O"
               alt="Sequence entry {{%O}}"/>
  </relinst>

  <!-- R-J-5. The biopsy marker and its site code are placed after the LAST
       method block, which is the reproducible choice the source permits. -->
  <relinst type="has opcs sequence entry"
           name="R-J-5 seq the biopsy marker after the last method block [PGCS10]" cf="100"
           alt="Position {{%ORD}} of the OPCS sequence is biopsy marker {{%C}}">
    <condition rel="has procedure event" subject="%S" object="%E"/>
    <condition rel="emits biopsy marker code" subject="%E" object="%C"/>
    <condition rel="has tentative code" subject="%S" object="%C"/>
    <condition rel="last block ordinal" subject="%S" object="%B"/>
    <condition expression="%B * 100" value="%BS" alt="The last block {{%B}} scales to {{%BS}}"/>
    <condition expression="%BS + 40" value="%ORD" alt="The biopsy marker sits at position {{%ORD}}"/>
    <condition expression="'OPCS;' + %ORD + ';' + %C + ';CHAPTER_Y_BIOPSY'" value="%O"
               alt="Sequence entry {{%O}}"/>
  </relinst>

  <relinst type="has opcs sequence entry"
           name="R-J-5 seq the biopsy site code after the biopsy marker [PGCS10]" cf="100"
           alt="Position {{%ORD}} of the OPCS sequence is biopsy site code {{%C}}">
    <condition rel="has procedure event" subject="%S" object="%E"/>
    <condition rel="emits biopsy site code" subject="%E" object="%C"/>
    <condition rel="has tentative code" subject="%S" object="%C"/>
    <condition rel="emits biopsy marker code" subject="%E" object="%MARK"/>
    <condition rel="has tentative code" subject="%S" object="%MARK"/>
    <condition rel="last block ordinal" subject="%S" object="%B"/>
    <condition expression="%B * 100" value="%BS" alt="The last block {{%B}} scales to {{%BS}}"/>
    <condition expression="%BS + 50" value="%ORD" alt="The biopsy site code sits at position {{%ORD}}"/>
    <condition expression="'OPCS;' + %ORD + ';' + %C + ';BIOPSY_SITE_CODE'" value="%O"
               alt="Sequence entry {{%O}}"/>
  </relinst>

  <!-- R-J-8. A diagnostic case is [procedure code, site code], one block. -->
  <relinst type="has opcs sequence entry"
           name="R-J-8 seq the diagnostic procedure code first [PGCS10]" cf="100"
           alt="Position {{%ORD}} of the OPCS sequence is diagnostic procedure code {{%C}}">
    <condition rel="has procedure event" subject="%S" object="%E"/>
    <condition rel="has effective intent" subject="%E" object="DIAGNOSTIC"/>
    <condition rel="has procedure type" subject="%E" object="%PT"/>
    <condition rel="is a biopsy for coding" subject="%E" object="%BX"/>
    <condition rel="diagnostic mapping for procedure type" subject="%MAP" object="%PT"/>
    <condition rel="diagnostic mapping requires biopsy" subject="%MAP" object="%BX"/>
    <condition rel="diagnostic mapping yields code" subject="%MAP" object="%C"/>
    <condition rel="has tentative code" subject="%S" object="%C"/>
    <condition rel="has procedure pattern" subject="%S" object="%PAT"/>
    <condition rel="pattern emits diagnostic procedure code" subject="%PAT" object="true"/>
    <condition rel="has block ordinal" subject="%E" object="%B"/>
    <condition expression="%B * 100" value="%BS" alt="Block {{%B}} scales to {{%BS}}"/>
    <condition expression="%BS + 10" value="%ORD" alt="The procedure code sits at position {{%ORD}}"/>
    <condition expression="'OPCS;' + %ORD + ';' + %C + ';PRIMARY_PROCEDURE'" value="%O"
               alt="Sequence entry {{%O}}"/>
  </relinst>

  <relinst type="has opcs sequence entry"
           name="R-J-8 seq the site code of a diagnostic case [PGCS10]" cf="100"
           alt="The site code {{%C}} follows the diagnostic procedure code">
    <condition rel="has procedure pattern" subject="%S" object="%PAT"/>
    <condition rel="pattern emits diagnostic procedure code" subject="%PAT" object="true"/>
    <condition rel="has site code target" subject="%S" object="%SITE"/>
    <condition rel="has approved site code" subject="%SITE" object="true"/>
    <condition rel="has approved local site code" subject="%SITE" object="%C"/>
    <condition rel="has tentative code" subject="%S" object="%C"/>
    <condition expression="countRelationshipInstances(%C,'is suppressed in case',*) is equal to 0"
               alt="The site code was not suppressed by RF-8.5"/>
    <condition expression="'OPCS;130;' + %C + ';SITE_CODE'" value="%O"
               alt="Sequence entry {{%O}}"/>
  </relinst>

  <!-- RF-8.1 HARD STOP. A Chapter Y code in the primary position means the
       body system code is MISSING. Encoded as a hard stop rather than a
       reorder, because reordering would hide the real defect. -->
  <relinst type="has hard stop" object="CHAPTER_Y_IN_PRIMARY_POSITION"
           name="RF-8.1 a Chapter Y code in the primary position is a hard stop [PGCS10]" cf="100"
           alt="A Chapter Y code would be sequenced first, which means the body system code is missing">
    <condition rel="has tentative code" subject="%S" object="%C" weight="1"/>
    <condition rel="has code role" subject="%C" object="%ROLE"/>
    <condition rel="role is chapter y" subject="%ROLE" object="true"/>
    <condition expression="countRelationshipInstances(%S,'has body system code',*) is equal to 0"
               alt="The case has no body system code to occupy the primary position"/>
  </relinst>

  <relinst type="has body system code"
           name="RF-8.1 project body system codes onto the case [PGCS10]" cf="100">
    <condition rel="has tentative code" subject="%S" object="%O"/>
    <condition rel="has code role" subject="%O" object="BODY_SYSTEM_METHOD"/>
  </relinst>

  <!-- RF-8.5 NEGATIVE, datasource dependent. Where the Tabular record for
       the body system code names the site in its own title, the separate
       site code is suppressed. Reads the retrieved Tabular title, NOT a
       hardcoded assumption: this is how the flexible oesophagoscopy code
       suppresses the oesophagus site code while the full OGD code does not. -->
  <relinst type="is suppressed in case" object="true"
           name="RF-8.5 site code suppressed when the body system code names the site [PGCS10]" cf="100"
           alt="The Tabular title of the body system code already names {{%SITE}}">
    <condition rel="is tentative in case" subject="%S" object="%CASE"/>
    <condition rel="has code role" subject="%S" object="SITE_CODE"/>
    <condition rel="has approved local site code" subject="%SITE" object="%S"/>
    <condition rel="has body system code" subject="%CASE" object="%BODY"/>
    <condition rel="has tabular record" subject="%BODY" object="%REC"/>
    <condition rel="names site in title" subject="%REC" object="%SITE"/>
    <condition expression="countRelationshipInstances(%CASE,'has site code target',*) is equal to 1"
               alt="No other site in the case needs distinguishing"/>
  </relinst>

  <relinst type="suppression reason"
           name="RF-8.5 reason the site code was suppressed [PGCS10]" cf="100">
    <condition rel="is tentative in case" subject="%S" object="%CASE"/>
    <condition rel="has code role" subject="%S" object="SITE_CODE"/>
    <condition rel="has approved local site code" subject="%SITE" object="%S"/>
    <condition rel="has body system code" subject="%CASE" object="%BODY"/>
    <condition rel="has tabular record" subject="%BODY" object="%REC"/>
    <condition rel="names site in title" subject="%REC" object="%SITE"/>
    <condition expression="countRelationshipInstances(%CASE,'has site code target',*) is equal to 1"
               alt="No other site in the case needs distinguishing"/>
    <condition expression="'RF-8.5;The Tabular List title of the body system code already names the site so a separate site code adds nothing'" value="%O"/>
  </relinst>

  <!-- ================================================================
       L11  RF-9  THE EVIDENCE RELEASE GATE
       Pass two only. Every condition here reads a datasource fact, so on
       pass one nothing is releasable and the 49 cap holds, which is the
       correct posture: no code leaves the model unverified.
       ================================================================ -->

  <relinst type="has alphabetical trail"
           name="RF-9.1 link a code to its alphabetical trail [SDD 2.3]" cf="100">
    <condition rel="supports code" subject="%O" object="%S"/>
    <condition rel="from book" subject="%O" object="Alphabetical"/>
  </relinst>

  <relinst type="has tabular record"
           name="RF-9.1 link a code to its tabular record [SDD 2.3]" cf="100">
    <condition rel="supports code" subject="%O" object="%S"/>
    <condition rel="from book" subject="%O" object="Tabular"/>
  </relinst>

  <!-- R-B-1. Each classification has its own edition, so the expected edition
       is resolved from the code's own classification. Two rules rather than one
       because the two editions are different case level facts. -->
  <relinst type="expected edition for code"
           name="RF-9.1 an OPCS code is verified against the episode OPCS edition [SDD 2.3]" cf="100">
    <condition rel="is tentative in case" subject="%S" object="%CASE"/>
    <condition rel="has classification" subject="%S" object="OPCS-4"/>
    <condition rel="has opcs edition" subject="%CASE" object="%O"/>
  </relinst>

  <relinst type="expected edition for code"
           name="RF-9.1 an ICD code is verified against the episode ICD edition [SDD 2.3]" cf="100">
    <condition rel="is tentative in case" subject="%S" object="%CASE"/>
    <condition rel="has classification" subject="%S" object="ICD-10"/>
    <condition rel="has icd edition" subject="%CASE" object="%O"/>
  </relinst>

  <relinst type="has evidence status" object="REFERENCE_EVIDENCE_COMPLETE"
           name="RF-9.1 complete reference evidence for a code [SDD 2.3]" cf="100"
           alt="The code has an index trail and a tabular record in the correct edition, with notes and timestamps">
    <condition rel="expected edition for code" subject="%S" object="%ED"/>
    <condition rel="has alphabetical trail" subject="%S" object="%A"/>
    <condition rel="has evidence edition" subject="%A" object="%ED"/>
    <condition rel="has retrieval timestamp" subject="%A" object="true"/>
    <condition rel="all fields present" subject="%A" object="true"/>
    <condition rel="has tabular record" subject="%S" object="%T"/>
    <condition rel="has evidence edition" subject="%T" object="%ED"/>
    <condition rel="has retrieval timestamp" subject="%T" object="true"/>
    <condition rel="includes required notes" subject="%T" object="true"/>
    <condition rel="all fields present" subject="%T" object="true"/>
  </relinst>

  <!-- The boolean mirror of the RF-9.1 status. The evidence status list is
       multi valued, and a count filtered to one literal status does not drive
       its derivation, so RF-9.2 counts this single purpose flag instead. -->
  <relinst type="has complete reference evidence" object="true"
           name="RF-9.1 mirror complete reference evidence as a flag [SDD 2.3]" cf="100"
           alt="The code has a complete reference evidence record">
    <condition rel="has evidence status" subject="%S" object="REFERENCE_EVIDENCE_COMPLETE"/>
  </relinst>

  <!-- Structural assertion 3: this is the ONLY rule concluding releasable
       true, and it reads nothing but the RF-9.1 status. -->
  <relinst type="is releasable" object="true"
           name="RF-9.1 a code with complete reference evidence is releasable [SDD 2.3]" cf="100"
           alt="The code has complete reference evidence">
    <condition rel="has evidence status" subject="%S" object="REFERENCE_EVIDENCE_COMPLETE"/>
  </relinst>

  <!-- RF-9.2. The exact mirror of RF-9.1 on the same status, so a code can
       never be both releasable and not. -->
  <relinst type="is releasable" object="false"
           name="RF-9.2 a code without complete reference evidence is not releasable [SDD 2.3]" cf="100"
           alt="The code does not yet have complete reference evidence">
    <condition rel="is tentative in case" subject="%S" object="%CASE"/>
    <condition expression="countRelationshipInstances(%S,'has complete reference evidence',*) is equal to 0"
               alt="The code has no complete reference evidence record"/>
  </relinst>

  <relinst type="has non releasable code"
           name="RF-9.2 project non releasable codes onto the case [SDD 2.3]" cf="100">
    <condition rel="has tentative code" subject="%S" object="%O"/>
    <condition rel="is releasable" subject="%O" object="false"/>
  </relinst>

  <!-- The 49 cap sits below every routing threshold, so an evidence
       incomplete case cannot reach FULL let alone EXPEDITED however strong
       the rest of the reasoning is. -->
  <relinst type="certainty cap" object="49"
           name="RF-9.2 incomplete reference evidence caps certainty at 49 [SDD 2.3]" cf="100"
           alt="{{%N}} codes lack complete reference evidence">
    <condition rel="has non releasable code" subject="%S" object="%ANY" weight="1"/>
    <condition expression="countRelationshipInstances(%S,'has non releasable code',*)" value="%N"
               alt="The case has {{%N}} codes without complete reference evidence"/>
    <condition expression="%N is greater than or equal to 1" alt="At least one code is not releasable"/>
  </relinst>

  <relinst type="has hard stop" object="REFERENCE_EVIDENCE_INCOMPLETE"
           name="RF-9.2 incomplete reference evidence is a hard stop [SDD 2.3]" cf="100"
           alt="At least one code in the case lacks complete reference evidence">
    <condition rel="has non releasable code" subject="%S" object="%C"/>
  </relinst>

  <relinst type="missing evidence note"
           name="RF-9.2 list the missing evidence [SDD 2.3]" cf="100">
    <condition rel="has non releasable code" subject="%S" object="%C"/>
    <condition expression="'RF-9.2;' + %C + ';Requires an Alphabetical Index trail and a Tabular List record in the episode edition with notes and retrieval timestamp'" value="%O"/>
  </relinst>

  <!-- RF-9.3 HARD STOP. An index trail for one code and a tabular record
       for a different code, from the same retrieval. -->
  <relinst type="has hard stop" object="ALPHA_TABULAR_CONFLICT"
           name="RF-9.3 index trail and tabular record disagree [SDD 7.3]" cf="100"
           alt="The index trail led to {{%X}} but the tabular record retrieved was for {{%Y}}">
    <condition rel="has tentative code" subject="%S" object="%X" weight="1"/>
    <condition rel="has alphabetical trail" subject="%X" object="%A"/>
    <condition rel="has conflict flag" subject="%A" object="true"/>
    <condition rel="supports code" subject="%A" object="%Y"/>
    <condition expression="%X is not equal to %Y" alt="The two books point at different codes"/>
  </relinst>

  <relinst type="candidate review tier" object="SENIOR_CLARIFICATION"
           name="RF-9.3 an index and tabular conflict needs senior clarification [SDD 7.3]" cf="100"
           alt="A conflict between the two books must be resolved by a senior coder">
    <condition rel="has hard stop" subject="%S" object="ALPHA_TABULAR_CONFLICT"/>
  </relinst>

  <relinst type="has alpha tabular conflict" object="true"
           name="RF-9.3 mirror the index and tabular conflict as a flag [SDD 7.3]" cf="100"
           alt="The case carries an index and tabular conflict">
    <condition rel="has hard stop" subject="%S" object="ALPHA_TABULAR_CONFLICT"/>
  </relinst>

  <!-- RF-9.4. The model compares but does not resolve. Neither does the
       agent. Only a coder does. -->
  <relinst type="has ambiguity" object="AMBIGUOUS_INDEX_TRAIL"
           name="RF-9.4 more than one plausible index trail and none resolved [SDD 7.3]" cf="100"
           alt="The lookup returned more than one plausible index trail and none is marked resolved">
    <condition rel="has tentative code" subject="%S" object="%C"/>
    <condition rel="has alphabetical trail" subject="%C" object="%A"/>
    <condition rel="is ambiguous trail" subject="%A" object="true"/>
    <condition rel="trail is resolved" subject="%A" object="false"/>
  </relinst>

  <relinst type="candidate review tier" object="SENIOR_CLARIFICATION"
           name="RF-9.4 an ambiguous index trail needs senior clarification [SDD 7.3]" cf="100"
           alt="Choosing between index trails is a senior coder decision">
    <condition rel="has ambiguity" subject="%S" object="AMBIGUOUS_INDEX_TRAIL"/>
  </relinst>

  <relinst type="has ambiguous index trail" object="true"
           name="RF-9.4 mirror the ambiguous index trail as a flag [SDD 7.3]" cf="100"
           alt="The case carries an ambiguous index trail">
    <condition rel="has ambiguity" subject="%S" object="AMBIGUOUS_INDEX_TRAIL"/>
  </relinst>

  <!-- RF-9.5 HARD STOP. Never silently substitute the newest edition: the
       edition is determined by the coded episode date. -->
  <relinst type="has hard stop" object="EDITION_MISMATCH"
           name="RF-9.5 the requested classification edition was unavailable [SDD 7.4]" cf="100"
           alt="The classification edition required for this episode was not available from the datasource">
    <condition rel="edition unavailable" subject="%S" object="true"/>
  </relinst>

  <!-- RF-9.6 HARD STOP, namespace integrity. The same code string in both
       classifications from one evidence record. This is why every Code
       instance key carries its classification prefix. -->
  <relinst type="has hard stop" object="NAMESPACE_COLLISION"
           name="RF-9.6 the same code string in both classifications from one record [SDD 8.2]" cf="100"
           alt="Codes {{%X}} and {{%Y}} share a code string across classifications and derive from the same evidence record">
    <condition rel="has tentative code" subject="%S" object="%X" weight="1"/>
    <condition rel="has classification" subject="%X" object="ICD-10"/>
    <condition rel="has tabular record" subject="%X" object="%REC"/>
    <condition rel="supports code" subject="%REC" object="%Y"/>
    <condition rel="has classification" subject="%Y" object="OPCS-4"/>
    <condition expression="%X is not equal to %Y" alt="The two codes are different instances"/>
  </relinst>

  <!-- RF-9.7 HARD STOP. There is no fallback to remembered knowledge and no
       synthetic technical exception recorded success path. -->
  <relinst type="has hard stop" object="LOOKUP_UNAVAILABLE"
           name="RF-9.7 the datasource was unavailable [SDD 7.3]" cf="100"
           alt="The classification datasource was unavailable, licence gated, or returned an unexpected structure">
    <condition rel="datasource unavailable" subject="%S" object="true"/>
  </relinst>

  <relinst type="permits fallback to remembered knowledge" object="false"
           name="RF-9.7 no fallback to remembered knowledge is permitted [SDD 7.3]" cf="100"
           alt="A failed lookup never licenses coding from remembered knowledge">
    <condition rel="datasource unavailable" subject="%S" object="true"/>
  </relinst>

  <!-- ================================================================
       L12  RF-10  CERTAINTY
       The six SDD components are a separate weighted sum over component
       score facts, NOT Rainbird rule weights. Their weights are a governed
       clinical artefact a coder reviews as a table, so they are computed
       arithmetically and stay visible. R-L-2 forbids conflating the two.
       ================================================================ -->

  <relinst type="well attributed concept"
           name="RF-10 count concepts with a consultant attributed span [SDD 10.1]" cf="100">
    <condition rel="has clinical concept" subject="%S" object="%O"/>
    <condition rel="is attributed to" subject="%O" object="%ATTR"/>
    <condition rel="attribution is consultant level" subject="%ATTR" object="true"/>
    <condition rel="is anchored at" subject="%O" object="%SPAN"/>
  </relinst>

  <!-- Component 1, weight 25: the proportion of concepts carrying a
       consultant attributed span, scaled to a score out of 100. Three
       single operator rules, per the build wide expression rule. -->
  <relinst type="scaled attributed concept count"
           name="RF-10 scale the attributed concept count [SDD 10.1]" cf="100">
    <condition rel="has clinical concept" subject="%S" object="%ANY" weight="1"/>
    <condition expression="countRelationshipInstances(%S,'well attributed concept',*)" value="%W"
               alt="{{%W}} concepts carry a consultant attributed span"/>
    <condition expression="%W * 100" value="%O" alt="The scaled attributed count is {{%O}}"/>
  </relinst>

  <relinst type="evidence attribution score"
           name="RF-10 component one evidence completeness and attribution [SDD 10.1]" cf="100">
    <condition rel="scaled attributed concept count" subject="%S" object="%SCALED"/>
    <condition expression="countRelationshipInstances(%S,'has clinical concept',*)" value="%TOTAL"
               alt="The case has {{%TOTAL}} extracted concepts"/>
    <condition expression="%TOTAL is greater than or equal to 1" alt="The case has at least one concept"/>
    <condition expression="%SCALED / %TOTAL" value="%O"
               alt="The attribution component scores {{%O}} out of 100"/>
  </relinst>

  <!-- A case with no concepts at all scores zero on attribution rather than
       dividing by zero. -->
  <relinst type="evidence attribution score" object="0"
           name="RF-10 component one is zero with no extracted concepts [SDD 10.1]" cf="100"
           alt="No clinical concepts were extracted so there is nothing attributed">
    <condition rel="has report version" subject="%S" object="%V" weight="1"/>
    <condition expression="countRelationshipInstances(%S,'has clinical concept',*) is equal to 0"
               alt="The case has no extracted clinical concepts"/>
  </relinst>

  <!-- Components 2 to 6 are set by the datasource and the orchestrator.
       Absent on pass one, which is correct: certainty is a pass two goal. -->
  <relinst type="index trail score" object="0"
           name="RF-10 component two defaults to zero before retrieval [SDD 10.1]" cf="100"
           alt="No index trail exactness has been reported yet">
    <condition rel="has report version" subject="%S" object="%V" weight="1"/>
    <condition expression="countRelationshipInstances(%S,'has tentative code',*) is equal to 0"
               alt="The case has no tentative codes to have looked up"/>
  </relinst>

  <relinst type="index trail score" object="100"
           name="RF-10 component two index trail exactness [SDD 10.1]" cf="100"
           alt="Every code has an exact index trail with all fields present">
    <condition rel="has tentative code" subject="%S" object="%C" weight="1"/>
    <condition expression="countRelationshipInstances(%S,'has non releasable code',*) is equal to 0"
               alt="No code lacks complete reference evidence"/>
    <condition expression="countRelationshipInstances(%S,'has ambiguous index trail',*) is equal to 0"
               alt="No index trail is ambiguous"/>
  </relinst>

  <relinst type="tabular score" object="100"
           name="RF-10 component three tabular compatibility and notes [SDD 10.1]" cf="100"
           alt="Every tabular record is compatible and all notes are resolved">
    <condition rel="has tentative code" subject="%S" object="%C" weight="1"/>
    <condition expression="countRelationshipInstances(%S,'has non releasable code',*) is equal to 0"
               alt="No code lacks a complete tabular record"/>
    <condition expression="countRelationshipInstances(%S,'has alpha tabular conflict',*) is equal to 0"
               alt="No conflict between the index and the tabular list"/>
  </relinst>

  <relinst type="tabular score" object="0"
           name="RF-10 component three is zero before retrieval [SDD 10.1]" cf="100"
           alt="No tabular records have been retrieved yet">
    <condition rel="has report version" subject="%S" object="%V" weight="1"/>
    <condition expression="countRelationshipInstances(%S,'has tentative code',*) is equal to 0"
               alt="The case has no tentative codes to verify"/>
  </relinst>

  <!-- Component 4, weight 15: the proportion of applicable rule checks that
       passed. A case with no ambiguity and no hard stop passed them all. -->
  <relinst type="rule check score" object="100"
           name="RF-10 component four all applicable rule checks passed [SDD 10.1]" cf="100"
           alt="No rule check raised an ambiguity or a hard stop">
    <condition rel="has report version" subject="%S" object="%V" weight="1"/>
    <condition expression="countRelationshipInstances(%S,'has ambiguity',*) is equal to 0"
               alt="No ambiguity was raised"/>
    <condition expression="countRelationshipInstances(%S,'has hard stop',*) is equal to 0"
               alt="No hard stop was raised"/>
  </relinst>

  <relinst type="rule check score" object="50"
           name="RF-10 component four some rule checks did not pass [SDD 10.1]" cf="100"
           alt="At least one rule check raised an ambiguity or a hard stop">
    <condition rel="has report version" subject="%S" object="%V" weight="1"/>
    <condition expression="countRelationshipInstances(%S,'has ambiguity',*)" value="%A"
               alt="The case raised {{%A}} ambiguities"/>
    <condition expression="countRelationshipInstances(%S,'has hard stop',*)" value="%H"
               alt="The case raised {{%H}} hard stops"/>
    <condition expression="%A + %H" value="%ISSUES" alt="{{%ISSUES}} rule checks did not pass"/>
    <condition expression="%ISSUES is greater than or equal to 1" alt="At least one rule check did not pass"/>
  </relinst>

  <!-- Component 5, weight 10, is set by the orchestrator; component 6,
       weight 5, is the mean injected extraction certainty. Both default
       conservatively when the orchestrator has not supplied them. -->
  <relinst type="agreement score"
           name="RF-10 component five uses the supplied validator score [SDD 10.1]" cf="100">
    <condition rel="has supplied agreement score" subject="%S" object="%O"/>
  </relinst>

  <relinst type="agreement score" object="0"
           name="RF-10 component five defaults to zero without an independent validator [SDD 10.1]" cf="100"
           alt="No independent agreement score has been supplied by the orchestrator">
    <condition rel="has report version" subject="%S" object="%V"/>
    <condition expression="countRelationshipInstances(%S,'has supplied agreement score',*) is equal to 0"
               alt="The orchestrator supplied no independent agreement score"/>
  </relinst>

  <relinst type="data quality score"
           name="RF-10 component six uses the supplied extraction certainty [SDD 10.1]" cf="100">
    <condition rel="has supplied data quality score" subject="%S" object="%O"/>
  </relinst>

  <relinst type="data quality score" object="0"
           name="RF-10 component six defaults to zero without a reported extraction certainty [SDD 10.1]" cf="100"
           alt="No extraction data quality score has been supplied">
    <condition rel="has report version" subject="%S" object="%V" weight="1"/>
    <condition expression="countRelationshipInstances(%S,'has supplied data quality score',*) is equal to 0"
               alt="The orchestrator supplied no extraction data quality score"/>
  </relinst>

  <!-- The weighted sum. Six weight times score products, each a single
       multiplication, then five single additions and one division. All six
       weights live in this ONE rule. An earlier version also carried a
       separate rule asserting only component one times 25 into a
       weighted contribution rel; nothing ever read it, and holding the
       weight 25 in two places invited a future tuner to edit one and not
       the other, so it was removed in the simplification pass. -->
  <relinst type="raw weighted certainty"
           name="RF-10 the weighted certainty before penalties and caps [SDD 10.1]" cf="100">
    <condition rel="evidence attribution score" subject="%S" object="%C1"/>
    <condition rel="index trail score" subject="%S" object="%C2"/>
    <condition rel="tabular score" subject="%S" object="%C3"/>
    <condition rel="rule check score" subject="%S" object="%C4"/>
    <condition rel="agreement score" subject="%S" object="%C5"/>
    <condition rel="data quality score" subject="%S" object="%C6"/>
    <condition expression="%C1 * 25" value="%W1" alt="Report evidence and attribution weighted at 25 gives {{%W1}}"/>
    <condition expression="%C2 * 20" value="%W2" alt="Index trail exactness weighted at 20 gives {{%W2}}"/>
    <condition expression="%C3 * 25" value="%W3" alt="Tabular compatibility weighted at 25 gives {{%W3}}"/>
    <condition expression="%C4 * 15" value="%W4" alt="Rule checks weighted at 15 gives {{%W4}}"/>
    <condition expression="%C5 * 10" value="%W5" alt="Independent agreement weighted at 10 gives {{%W5}}"/>
    <condition expression="%C6 * 5" value="%W6" alt="Data quality weighted at 5 gives {{%W6}}"/>
    <condition expression="%W1 + %W2" value="%T2" alt="Running total {{%T2}}"/>
    <condition expression="%T2 + %W3" value="%T3" alt="Running total {{%T3}}"/>
    <condition expression="%T3 + %W4" value="%T4" alt="Running total {{%T4}}"/>
    <condition expression="%T4 + %W5" value="%T5" alt="Running total {{%T5}}"/>
    <condition expression="%T5 + %W6" value="%T6" alt="Weighted total {{%T6}} out of ten thousand"/>
    <condition expression="%T6 / 100" value="%O" alt="The weighted certainty is {{%O}} out of 100"/>
  </relinst>

  <!-- ============ RF-10 penalties, all eight ============
       R-L-8 states each of the eight penalties applies ONCE per case. Two
       distinct defects in the summation had to be fixed to make that true, and
       both were found live rather than by the linter or the uploader.

       FIRST, a penalty rule that binds a MULTI VALUED relationship derives once
       per matching row. Three of the eight are exposed to that: unresolved
       ambiguity (a case can hold several ambiguities), documented uncertainty in
       the primary diagnosis (several primary candidates), and current versus
       historical ambiguity (several historical concepts). Each is therefore
       gated on a boolean mirror flag whose object is a single Flag instance,
       which DOES dedupe, so many matching rows collapse to one charge.

       SECOND, and this is why the eight penalties are eight SEPARATE
       relationships rather than one plural relationship summed with sumObjects:
       identical subject relationship object triples collapse even when asserted
       by different rules. The unresolved ambiguity penalty and the current
       versus historical ambiguity penalty are both fifteen points, so on a case
       carrying both they were one fact, and the D-12 probe returned a total of
       twenty where the three itemised records plainly showed fifteen, fifteen
       and five. Each penalty now has its own relationship, resolving either to
       its points or to zero, and the total is a chain of plain additions. That
       is the fallback design decision D-12 names for precisely this outcome.

       The itemised `applied penalty record` layer is what exposed both defects,
       which is exactly the independent cross check D-12 asked for, so it stays.
       Every penalty keeps its record rule, driven off the same gate as the
       points, so the two can never drift apart. -->

  <relinst type="carries unresolved ambiguity" object="true"
           name="RF-10 the case carries at least one unresolved ambiguity [SDD 10.1]" cf="100"
           alt="The case carries at least one unresolved ambiguity">
    <condition rel="has ambiguity" subject="%S" object="%A"/>
  </relinst>

  <relinst type="penalty ambiguity" object="15"
           name="RF-10 penalty unresolved ambiguity [SDD 10.1]" cf="100"
           alt="The case carries at least one unresolved ambiguity">
    <condition rel="carries unresolved ambiguity" subject="%S" object="true"/>
  </relinst>

  <relinst type="penalty ambiguity" object="0"
           name="RF-10 no unresolved ambiguity penalty [SDD 10.1]" cf="100"
           alt="The case carries no unresolved ambiguity">
    <condition rel="has report version" subject="%S" object="%V" weight="1"/>
    <condition expression="countRelationshipInstances(%S,'carries unresolved ambiguity',*) is equal to 0"
               alt="The case carries no unresolved ambiguity"/>
  </relinst>

  <relinst type="applied penalty record"
           name="RF-10 record the ambiguity penalty [SDD 10.1]" cf="100">
    <condition rel="carries unresolved ambiguity" subject="%S" object="true"/>
    <condition expression="'15;Unresolved ambiguity'" value="%O"/>
  </relinst>

  <!-- Same one charge per case treatment: the prime bind on the multi valued
       `examined tract` would otherwise charge twenty points once per tract. -->
  <relinst type="carries contradictory site information" object="true"
           name="RF-10 the case records sites in more than one GI tract [SDD 10.1]" cf="100"
           alt="Sites from more than one GI tract are recorded for this case">
    <condition rel="examined tract" subject="%S" object="%ANY" weight="1"/>
    <condition expression="countRelationshipInstances(%S,'examined tract',*) is greater than 1"
               alt="The case records sites in more than one GI tract"/>
  </relinst>

  <relinst type="penalty site conflict" object="20"
           name="RF-10 penalty contradictory site information [SDD 10.1]" cf="100"
           alt="Sites from more than one GI tract are recorded for this case">
    <condition rel="carries contradictory site information" subject="%S" object="true"/>
  </relinst>

  <relinst type="penalty site conflict" object="0"
           name="RF-10 no contradictory site penalty [SDD 10.1]" cf="100"
           alt="All recorded sites lie in a single GI tract">
    <condition rel="has report version" subject="%S" object="%V" weight="1"/>
    <condition expression="countRelationshipInstances(%S,'carries contradictory site information',*) is equal to 0"
               alt="All recorded sites lie in a single GI tract"/>
  </relinst>

  <relinst type="applied penalty record"
           name="RF-10 record the contradictory site penalty [SDD 10.1]" cf="100">
    <condition rel="carries contradictory site information" subject="%S" object="true"/>
    <condition expression="'20;Contradictory site information'" value="%O"/>
  </relinst>

  <relinst type="carries uncertain primary diagnosis" object="true"
           name="RF-10 the primary diagnosis carries a qualified certainty [SDD 10.1]" cf="100"
           alt="The primary diagnosis is documented as {{%CERT}} rather than plainly definitive">
    <condition rel="has primary candidate concept" subject="%S" object="%C"/>
    <condition rel="has documented certainty" subject="%C" object="%CERT"/>
    <condition rel="certainty is treated as definitive" subject="%CERT" object="true"/>
    <condition expression="%CERT is not equal to 'DEFINITIVE'"
               alt="The certainty is a qualified one rather than plainly definitive"/>
  </relinst>

  <relinst type="penalty primary uncertainty" object="10"
           name="RF-10 penalty documented uncertainty in the primary diagnosis [SDD 10.1]" cf="100"
           alt="The primary diagnosis carries a qualified rather than a plainly definitive certainty">
    <condition rel="carries uncertain primary diagnosis" subject="%S" object="true"/>
  </relinst>

  <relinst type="penalty primary uncertainty" object="0"
           name="RF-10 no primary diagnosis uncertainty penalty [SDD 10.1]" cf="100"
           alt="The primary diagnosis is not documented with a qualified certainty">
    <condition rel="has report version" subject="%S" object="%V" weight="1"/>
    <condition expression="countRelationshipInstances(%S,'carries uncertain primary diagnosis',*) is equal to 0"
               alt="The primary diagnosis is not documented with a qualified certainty"/>
  </relinst>

  <relinst type="applied penalty record"
           name="RF-10 record the primary diagnosis uncertainty penalty [SDD 10.1]" cf="100">
    <condition rel="carries uncertain primary diagnosis" subject="%S" object="true"/>
    <condition expression="'10;Documented uncertainty in the primary diagnosis'" value="%O"/>
  </relinst>

  <relinst type="carries historical ambiguity" object="true"
           name="RF-10 the case codes a historical condition as relevant [SDD 10.1]" cf="100"
           alt="A historical condition was coded because it is relevant to managing this episode">
    <condition rel="has clinical concept" subject="%S" object="%C"/>
    <condition rel="has disposition" subject="%C" object="SECONDARY_CANDIDATE_HISTORY"/>
  </relinst>

  <relinst type="penalty historical ambiguity" object="15"
           name="RF-10 penalty current and historical ambiguity [SDD 10.1]" cf="100"
           alt="A historical condition was coded because it is relevant to managing this episode">
    <condition rel="carries historical ambiguity" subject="%S" object="true"/>
  </relinst>

  <relinst type="penalty historical ambiguity" object="0"
           name="RF-10 no current and historical ambiguity penalty [SDD 10.1]" cf="100"
           alt="No historical condition was coded for this episode">
    <condition rel="has report version" subject="%S" object="%V" weight="1"/>
    <condition expression="countRelationshipInstances(%S,'carries historical ambiguity',*) is equal to 0"
               alt="No historical condition was coded for this episode"/>
  </relinst>

  <relinst type="applied penalty record"
           name="RF-10 record the current and historical ambiguity penalty [SDD 10.1]" cf="100">
    <condition rel="carries historical ambiguity" subject="%S" object="true"/>
    <condition expression="'15;Current or historical ambiguity'" value="%O"/>
  </relinst>

  <relinst type="carries missing procedure modifier" object="true"
           name="RF-10 the case is missing a procedure modifier [SDD 10.1]" cf="100"
           alt="The polypectomy method was not stated">
    <condition rel="has ambiguity" subject="%S" object="POLYPECTOMY_METHOD_UNSTATED_AMBIGUITY"/>
  </relinst>

  <relinst type="penalty missing modifier" object="10"
           name="RF-10 penalty missing procedure modifier [SDD 10.1]" cf="100"
           alt="The polypectomy method was not stated">
    <condition rel="carries missing procedure modifier" subject="%S" object="true"/>
  </relinst>

  <relinst type="penalty missing modifier" object="0"
           name="RF-10 no missing procedure modifier penalty [SDD 10.1]" cf="100"
           alt="No procedure modifier is missing from this case">
    <condition rel="has report version" subject="%S" object="%V" weight="1"/>
    <condition expression="countRelationshipInstances(%S,'carries missing procedure modifier',*) is equal to 0"
               alt="No procedure modifier is missing from this case"/>
  </relinst>

  <relinst type="applied penalty record"
           name="RF-10 record the missing modifier penalty [SDD 10.1]" cf="100">
    <condition rel="carries missing procedure modifier" subject="%S" object="true"/>
    <condition expression="'10;Missing procedure modifier'" value="%O"/>
  </relinst>

  <!-- R-L-8 edition drift, corrected. The source phrase is editions differ
       between ICD and OPCS LOOKUPS, meaning a lookup came back in an edition
       other than the one the episode date selected. It does NOT mean the case's
       ICD edition differs from its OPCS edition, which is true of every case
       ever coded because they are two different books: read that way the penalty
       fired on all 25 vectors and silently cost every case thirty points. The
       drift is therefore measured per evidence record against the expected
       edition for the code that record supports.

       This shares the fix with RF-9.1: a mirror flag is needed because a count
       filtered to a bound variable does not drive derivation, and because the
       penalty must apply ONCE however many records drifted. -->
  <relinst type="evidence edition drifted" object="true"
           name="RF-10 an evidence record came back in the wrong edition [SDD 10.1]" cf="100"
           alt="Evidence for {{%CODE}} came back in edition {{%EVED}} rather than {{%ED}}">
    <condition rel="supports code" subject="%S" object="%CODE"/>
    <condition rel="expected edition for code" subject="%CODE" object="%ED"/>
    <condition rel="has evidence edition" subject="%S" object="%EVED"/>
    <condition expression="%EVED is not equal to %ED"
               alt="The evidence edition differs from the edition the episode date selected"/>
  </relinst>

  <relinst type="case evidence edition drifted" object="true"
           name="RF-10 project evidence edition drift onto the case [SDD 10.1]" cf="100"
           alt="At least one lookup for this case returned the wrong edition">
    <condition rel="evidence belongs to case" subject="%E" object="%S"/>
    <condition rel="evidence edition drifted" subject="%E" object="true"/>
  </relinst>

  <relinst type="penalty edition drift" object="30"
           name="RF-10 penalty edition drift within the episode [SDD 10.1]" cf="100"
           alt="A lookup for this episode returned a classification edition other than the approved one">
    <condition rel="case evidence edition drifted" subject="%S" object="true"/>
  </relinst>

  <relinst type="penalty edition drift" object="0"
           name="RF-10 no edition drift penalty [SDD 10.1]" cf="100"
           alt="Every lookup for this episode came back in the approved edition">
    <condition rel="has report version" subject="%S" object="%V" weight="1"/>
    <condition expression="countRelationshipInstances(%S,'case evidence edition drifted',*) is equal to 0"
               alt="Every lookup for this episode came back in the approved edition"/>
  </relinst>

  <relinst type="applied penalty record"
           name="RF-10 record the edition drift penalty [SDD 10.1]" cf="100">
    <condition rel="case evidence edition drifted" subject="%S" object="true"/>
    <condition expression="'30;Edition drift within the episode'" value="%O"/>
  </relinst>

  <!-- R-L-8 disagreement penalty. The trigger is an agreement component below
       fifty, but component five DEFAULTS to zero when no independent validator
       ran, and zero is below fifty, so the raw reading charged every case twenty
       points for a disagreement that never happened. Absence of a validator is
       not disagreement: it is already paid for once, by the zero contributing
       nothing to the weighted score. Charging it again would be double counting.
       So the penalty requires an ACTUAL supplied score, and the injected fact is
       what distinguishes a real low score from the default. -->
  <relinst type="carries validator disagreement" object="true"
           name="RF-10 the independent validator disagreed materially [SDD 10.1]" cf="100"
           alt="The independent agreement score is {{%A}}, below the fifty point threshold">
    <condition rel="has supplied agreement score" subject="%S" object="%A"/>
    <condition expression="%A is less than 50" alt="The independent validator disagreed materially"/>
  </relinst>

  <relinst type="penalty disagreement" object="20"
           name="RF-10 penalty model and agent disagreement [SDD 10.1]" cf="100"
           alt="The independent validator disagreed materially with the model">
    <condition rel="carries validator disagreement" subject="%S" object="true"/>
  </relinst>

  <relinst type="penalty disagreement" object="0"
           name="RF-10 no disagreement penalty [SDD 10.1]" cf="100"
           alt="No independent validator disagreed materially with the model">
    <condition rel="has report version" subject="%S" object="%V" weight="1"/>
    <condition expression="countRelationshipInstances(%S,'carries validator disagreement',*) is equal to 0"
               alt="No independent validator disagreed materially with the model"/>
  </relinst>

  <relinst type="applied penalty record"
           name="RF-10 record the disagreement penalty [SDD 10.1]" cf="100">
    <condition rel="carries validator disagreement" subject="%S" object="true"/>
    <condition expression="'20;Model and agent disagreement'" value="%O"/>
  </relinst>

  <relinst type="carries unlisted anticoagulant" object="true"
           name="RF-10 the case describes an unlisted anticoagulant [SDD 10.1]" cf="100"
           alt="An anticoagulant outside the approved list was described">
    <condition rel="has ambiguity" subject="%S" object="UNLISTED_ANTICOAGULANT"/>
  </relinst>

  <relinst type="penalty unlisted anticoagulant" object="5"
           name="RF-10 penalty unlisted anticoagulant [SDD 10.1]" cf="100"
           alt="An anticoagulant outside the approved list was described">
    <condition rel="carries unlisted anticoagulant" subject="%S" object="true"/>
  </relinst>

  <relinst type="penalty unlisted anticoagulant" object="0"
           name="RF-10 no unlisted anticoagulant penalty [SDD 10.1]" cf="100"
           alt="No anticoagulant outside the approved list was described">
    <condition rel="has report version" subject="%S" object="%V" weight="1"/>
    <condition expression="countRelationshipInstances(%S,'carries unlisted anticoagulant',*) is equal to 0"
               alt="No anticoagulant outside the approved list was described"/>
  </relinst>

  <relinst type="applied penalty record"
           name="RF-10 record the unlisted anticoagulant penalty [SDD 10.1]" cf="100">
    <condition rel="carries unlisted anticoagulant" subject="%S" object="true"/>
    <condition expression="'5;Unlisted anticoagulant'" value="%O"/>
  </relinst>

  <!-- R-L-8 total. Eight separate contributions added in a chain of subtotals,
       one addition per rule because expressions have no operator precedence and
       are evaluated strictly left to right, and because a function call may not
       take an expression as an argument. Every contribution resolves either to
       its points or to zero, so the chain is total and needs no count guard: a
       case with no penalties at all totals zero through the same path as a case
       with all eight. That also removes the separate no penalties apply rule
       that the previous plural design needed. -->
  <relinst type="penalty subtotal one"
           name="RF-10 subtotal ambiguity and site conflict [SDD 10.1]" cf="100">
    <condition rel="penalty ambiguity" subject="%S" object="%A"/>
    <condition rel="penalty site conflict" subject="%S" object="%B"/>
    <condition expression="%A + %B" value="%O" alt="The first two penalties total {{%O}} points"/>
  </relinst>

  <relinst type="penalty subtotal two"
           name="RF-10 subtotal add the primary diagnosis uncertainty [SDD 10.1]" cf="100">
    <condition rel="penalty subtotal one" subject="%S" object="%A"/>
    <condition rel="penalty primary uncertainty" subject="%S" object="%B"/>
    <condition expression="%A + %B" value="%O" alt="The running penalty total is {{%O}} points"/>
  </relinst>

  <relinst type="penalty subtotal three"
           name="RF-10 subtotal add the historical ambiguity [SDD 10.1]" cf="100">
    <condition rel="penalty subtotal two" subject="%S" object="%A"/>
    <condition rel="penalty historical ambiguity" subject="%S" object="%B"/>
    <condition expression="%A + %B" value="%O" alt="The running penalty total is {{%O}} points"/>
  </relinst>

  <relinst type="penalty subtotal four"
           name="RF-10 subtotal add the missing modifier [SDD 10.1]" cf="100">
    <condition rel="penalty subtotal three" subject="%S" object="%A"/>
    <condition rel="penalty missing modifier" subject="%S" object="%B"/>
    <condition expression="%A + %B" value="%O" alt="The running penalty total is {{%O}} points"/>
  </relinst>

  <relinst type="penalty subtotal five"
           name="RF-10 subtotal add the edition drift [SDD 10.1]" cf="100">
    <condition rel="penalty subtotal four" subject="%S" object="%A"/>
    <condition rel="penalty edition drift" subject="%S" object="%B"/>
    <condition expression="%A + %B" value="%O" alt="The running penalty total is {{%O}} points"/>
  </relinst>

  <relinst type="penalty subtotal six"
           name="RF-10 subtotal add the validator disagreement [SDD 10.1]" cf="100">
    <condition rel="penalty subtotal five" subject="%S" object="%A"/>
    <condition rel="penalty disagreement" subject="%S" object="%B"/>
    <condition expression="%A + %B" value="%O" alt="The running penalty total is {{%O}} points"/>
  </relinst>

  <relinst type="total penalty"
           name="RF-10 sum the applied penalties [SDD 10.1]" cf="100">
    <condition rel="penalty subtotal six" subject="%S" object="%A"/>
    <condition rel="penalty unlisted anticoagulant" subject="%S" object="%B"/>
    <condition expression="%A + %B" value="%O" alt="The penalties total {{%O}} points"/>
  </relinst>

  <relinst type="penalised certainty"
           name="RF-10 subtract the penalties from the weighted certainty [SDD 10.1]" cf="100">
    <condition rel="raw weighted certainty" subject="%S" object="%RAW"/>
    <condition rel="total penalty" subject="%S" object="%PEN"/>
    <condition expression="%RAW - %PEN" value="%O" alt="After penalties the certainty is {{%O}}"/>
  </relinst>

  <!-- RF-10.6 and R-L-14. Caps propagate: the case inherits the LOWEST cap
       on its critical path, so a case whose primary diagnosis came through
       RF-2.5 cannot reach EXPEDITED. -->
  <relinst type="certainty cap" object="90"
           name="RF-2.5 a management relevant history caps certainty at 90 [DGCS.3]" cf="100"
           alt="A historical condition coded for management relevance caps certainty at 90">
    <condition rel="has clinical concept" subject="%S" object="%C"/>
    <condition rel="has disposition" subject="%C" object="SECONDARY_CANDIDATE_HISTORY"/>
  </relinst>

  <relinst type="lowest certainty cap"
           name="RF-10.6 the case inherits the lowest cap on its critical path [SDD 2.3]" cf="100">
    <condition rel="certainty cap" subject="%S" object="%ANY" weight="1"/>
    <condition expression="countRelationshipInstances(%S,'certainty cap',*) is greater than or equal to 1"
               alt="At least one certainty cap applies" weight="1"/>
    <condition expression="minObjects(%S,'certainty cap',*)" value="%O"
               alt="The lowest applicable cap is {{%O}}"/>
  </relinst>

  <relinst type="has certainty"
           name="RF-10 the case certainty where no cap applies [SDD 10.1]" cf="100"
           alt="The penalised certainty of {{%O}} stands because no cap applies">
    <condition rel="penalised certainty" subject="%S" object="%O"/>
    <condition expression="countRelationshipInstances(%S,'certainty cap',*) is equal to 0"
               alt="No certainty cap applies to this case"/>
    <condition expression="countRelationshipInstances(%S,'has hard stop',*) is equal to 0"
               alt="The case has no hard stop"/>
  </relinst>

  <relinst type="has certainty"
           name="RF-10.6 the penalised certainty stands when it is below the cap [SDD 2.3]" cf="100"
           alt="The penalised certainty of {{%O}} is at or below the cap of {{%CAP}}">
    <condition rel="penalised certainty" subject="%S" object="%O"/>
    <condition rel="lowest certainty cap" subject="%S" object="%CAP"/>
    <condition expression="%O is less than or equal to %CAP" alt="The certainty does not exceed the cap"/>
    <condition expression="countRelationshipInstances(%S,'has hard stop',*) is equal to 0"
               alt="The case has no hard stop"/>
  </relinst>

  <relinst type="has certainty"
           name="RF-10.6 the cap replaces a higher certainty [SDD 2.3]" cf="100"
           alt="The penalised certainty of {{%RAW}} is reduced to the cap of {{%CAP}}">
    <condition rel="penalised certainty" subject="%S" object="%RAW"/>
    <condition rel="lowest certainty cap" subject="%S" object="%CAP"/>
    <condition expression="%RAW is greater than %CAP" alt="The certainty exceeds the applicable cap"/>
    <condition expression="countRelationshipInstances(%S,'has hard stop',*) is equal to 0"
               alt="The case has no hard stop"/>
    <condition expression="%CAP + 0" value="%O" alt="The capped certainty is {{%O}}"/>
  </relinst>

  <!-- RF-10.1. A hard stop overrides the numeric certainty entirely. -->
  <relinst type="has certainty" object="0"
           name="RF-10.1 a hard stop sets certainty to zero [SDD 10.1]" cf="100"
           alt="The case has a hard stop, which overrides any numeric certainty">
    <condition rel="has hard stop" subject="%S" object="%H"/>
  </relinst>

  <!-- ================================================================
       L13  RF-10.2 to RF-10.5  REVIEW ROUTING
       ================================================================ -->

  <relinst type="candidate review tier" object="SENIOR_CLARIFICATION"
           name="RF-10.1 a hard stop routes to senior clarification [SDD 10.1]" cf="100"
           alt="A hard stop requires senior coder clarification whatever the numbers say">
    <condition rel="has hard stop" subject="%S" object="%H"/>
  </relinst>

  <relinst type="routing reason"
           name="RF-10.1 record that the hard stop overrode the certainty [SDD 10.1]" cf="100">
    <condition rel="has hard stop" subject="%S" object="%H"/>
    <condition expression="'Hard stop overrides numeric certainty'" value="%O"/>
  </relinst>

  <!-- RF-10.2. Structural assertion 4: EXPEDITED requires no hard stop AND
       no ambiguity AND every code releasable, so no path reaches it while
       either holds. -->
  <relinst type="candidate review tier" object="EXPEDITED"
           name="RF-10.2 a clean case at ninety five or above is expedited [SDD 10.2]" cf="100"
           alt="Certainty {{%C}} with no hard stop, no ambiguity and every code releasable">
    <condition rel="has certainty" subject="%S" object="%C"/>
    <condition expression="%C is greater than or equal to 95" alt="Certainty is at or above 95"/>
    <condition expression="countRelationshipInstances(%S,'has hard stop',*) is equal to 0"
               alt="The case has no hard stop"/>
    <condition expression="countRelationshipInstances(%S,'has ambiguity',*) is equal to 0"
               alt="The case has no unresolved ambiguity"/>
    <condition expression="countRelationshipInstances(%S,'has non releasable code',*) is equal to 0"
               alt="Every tentative code is releasable"/>
  </relinst>

  <relinst type="routing reason"
           name="RF-10.2 record the expedited routing reason [SDD 10.2]" cf="100">
    <condition rel="candidate review tier" subject="%S" object="EXPEDITED"/>
    <condition expression="'Certainty at or above 95 with complete evidence and no ambiguity'" value="%O"/>
  </relinst>

  <relinst type="candidate review tier" object="FULL"
           name="RF-10.3 certainty from eighty to under ninety five takes full review [SDD 10.2]" cf="100"
           alt="Certainty {{%C}} falls in the full review band">
    <condition rel="has certainty" subject="%S" object="%C"/>
    <condition expression="%C is greater than or equal to 80" alt="Certainty is at or above 80"/>
    <condition expression="%C is less than 95" alt="Certainty is below 95"/>
    <condition expression="countRelationshipInstances(%S,'has hard stop',*) is equal to 0"
               alt="The case has no hard stop"/>
  </relinst>

  <!-- A case at 95 or above that carries an ambiguity or a non releasable
       code cannot be EXPEDITED, so it must land somewhere: FULL. The two
       disqualifiers are tested directly rather than by asking whether
       EXPEDITED was concluded, because a rule must never count its own
       target relationship. -->
  <relinst type="candidate review tier" object="FULL"
           name="RF-10.3 a high certainty case with an ambiguity still takes full review [SDD 10.2]" cf="100"
           alt="Certainty {{%C}} is high but an unresolved ambiguity prevents expediting">
    <condition rel="has certainty" subject="%S" object="%C"/>
    <condition expression="%C is greater than or equal to 95" alt="Certainty is at or above 95"/>
    <condition expression="countRelationshipInstances(%S,'has hard stop',*) is equal to 0"
               alt="The case has no hard stop"/>
    <condition expression="countRelationshipInstances(%S,'has ambiguity',*) is greater than or equal to 1"
               alt="The case carries at least one unresolved ambiguity"/>
  </relinst>

  <relinst type="candidate review tier" object="FULL"
           name="RF-10.3 a high certainty case with an unreleasable code still takes full review [SDD 10.2]" cf="100"
           alt="Certainty {{%C}} is high but a code without complete evidence prevents expediting">
    <condition rel="has certainty" subject="%S" object="%C"/>
    <condition expression="%C is greater than or equal to 95" alt="Certainty is at or above 95"/>
    <condition expression="countRelationshipInstances(%S,'has hard stop',*) is equal to 0"
               alt="The case has no hard stop"/>
    <condition expression="countRelationshipInstances(%S,'has non releasable code',*) is greater than or equal to 1"
               alt="At least one tentative code is not releasable"/>
  </relinst>

  <relinst type="routing reason"
           name="RF-10.3 record the full review routing reason [SDD 10.2]" cf="100">
    <condition rel="candidate review tier" subject="%S" object="FULL"/>
    <condition expression="'Certainty or an open ambiguity requires full coder review'" value="%O"/>
  </relinst>

  <relinst type="candidate review tier" object="SENIOR_CLARIFICATION"
           name="RF-10.4 certainty below eighty needs senior clarification [SDD 10.2]" cf="100"
           alt="Certainty {{%C}} is below the full review threshold">
    <condition rel="has certainty" subject="%S" object="%C"/>
    <condition expression="%C is less than 80" alt="Certainty is below 80"/>
  </relinst>

  <relinst type="routing reason"
           name="RF-10.4 record the senior clarification routing reason [SDD 10.2]" cf="100">
    <condition rel="candidate review tier" subject="%S" object="SENIOR_CLARIFICATION"/>
    <condition expression="'Certainty below 80 or an unresolvable conflict requires a senior coder'" value="%O"/>
  </relinst>

  <!-- The tier ladder takes the DEEPEST review any rule asked for, so a
       single senior clarification trigger cannot be outvoted. -->
  <relinst type="candidate tier depth"
           name="RF-10 join candidate tier to its review depth [SDD 10.2]" cf="100">
    <condition rel="candidate review tier" subject="%S" object="%T"/>
    <condition rel="tier review depth" subject="%T" object="%O"/>
  </relinst>

  <relinst type="selected tier depth"
           name="RF-10 the case takes the deepest review any rule required [SDD 10.2]" cf="100">
    <condition rel="candidate review tier" subject="%S" object="%ANY" weight="1"/>
    <condition expression="countRelationshipInstances(%S,'candidate tier depth',*) is greater than or equal to 1"
               alt="At least one review tier was proposed" weight="1"/>
    <condition expression="maxObjects(%S,'candidate tier depth',*)" value="%O"
               alt="The deepest review depth required is {{%O}}"/>
  </relinst>

  <relinst type="requires review tier"
           name="RF-10 the case takes exactly one review tier [SDD 10.2]" cf="100"
           alt="The case is routed to {{%O}}">
    <condition rel="selected tier depth" subject="%S" object="%DEPTH"/>
    <condition rel="candidate review tier" subject="%S" object="%O"/>
    <condition rel="tier review depth" subject="%O" object="%DEPTH"/>
  </relinst>

  <!-- RF-10.5 THE UNIVERSAL INVARIANT. Unconditional on anything but the
       case existing. Certainty changes review DEPTH, never review
       EXISTENCE. No rule anywhere in this map concludes attestation false,
       so the fact is reachable for every case and falsifiable by none. -->
  <relinst type="requires human attestation" object="true"
           name="RF-10.5 every case requires human attestation [SDD 10.2]" cf="100"
           alt="Every coded episode requires a human coder to attest the codes before release">
    <condition rel="has report version" subject="%S" object="%V"/>
  </relinst>

  <!-- ================================================================
       L14  RF-10.7  CALIBRATION ONLY, NEVER ROUTING
       The agreement signal is written to a relationship no certainty or
       routing rule reads. This is the build time guard R-L-10 demands, not
       merely a comment: deleting these two rules changes no certainty in
       any vector, which is structural assertion 6.
       ================================================================ -->

  <relinst type="unit agreement signal"
           name="RF-10.7 record whether the unit entered code matches ours [CALIBRATION-1]" cf="100">
    <condition rel="unit entered code" subject="%S" object="%C"/>
    <condition rel="has tentative code" subject="%S" object="%C"/>
    <condition expression="'AGREE;' + %C" value="%O"/>
  </relinst>

  <relinst type="unit agreement signal"
           name="RF-10.7 record a unit entered code we did not derive [CALIBRATION-1]" cf="100">
    <condition rel="unit entered code" subject="%S" object="%C"/>
    <condition expression="countRelationshipInstances(%S,'has tentative code',*) is greater than or equal to 1"
               alt="The case derived at least one code of its own" weight="1"/>
    <condition expression="'NOT_DERIVED_BY_MODEL;' + %C" value="%O"/>
  </relinst>

  <!-- ================================================================
       L15  RF-11  FEEDBACK DISPOSITION
       The mapping table is reference data. This rule family exists so a
       feedback reason can be classified and routed; per M-8 no rule in it
       may alter the map, and every row already carries automatic production
       change allowed false.
       ================================================================ -->

  <!-- M-7. Anything else is unclassified feedback and still needs
       governance review. The test reads a separate listed marker rather than
       counting the rule's own target relationship, which would risk
       self-recursion. -->
  <relinst type="maps to category" object="UNCLASSIFIED_FEEDBACK"
           name="M-7 an unrecognised feedback reason is unclassified [RF-11]" cf="100"
           alt="The feedback reason is not in the local classification table">
    <condition rel="requires governance review" subject="%S" object="%ANY" weight="1"/>
    <condition expression="countRelationshipInstances(%S,'feedback reason is listed',*) is equal to 0"
               alt="The reason is not one of the classified feedback reasons"/>
  </relinst>

</rbl:kb>

